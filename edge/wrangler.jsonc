{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dcasa",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // Fase 1 (opción A, docs/auditoria/DECISION_Y_PLAN.md): Odoo + PostgreSQL en UN
  // contenedor que restaura la base desde R2 al arrancar y archiva el WAL en R2.
  // La imagen se construye desde docker/Dockerfile. Contrato Worker ↔ imagen:
  // edge/CONTRATO_CONTENEDOR.md.
  "containers": [
    {
      "class_name": "OdooContainer",
      "image": "../docker/Dockerfile",
      "image_build_context": "..",
      // Política "default", decidida a propósito (es INMUTABLE: cambiarla después exige
      // otra app y otra clase de Durable Object). "durable_object" (beta) es la única
      // que admite snapshots, pero rechaza instance_type, max_instances y constraints, y
      // no sirve con la clase Container. Ver CONTRATO_CONTENEDOR.md → «Política».
      "scheduling_policy": "default",
      // basic = 1/4 vCPU, 1 GiB, 4 GB de disco. Medido: Odoo + PostgreSQL ≈ 400 MiB de
      // pico (ronda3/odoo-medicion.md). La imagen debe pesar ≤ 4 GB.
      "instance_type": "basic",
      // Singleton: nunca dos PostgreSQL escribiendo al mismo repositorio de R2.
      "max_instances": 1,
      // Este de Norteamérica: lo más cercano a Panamá (y al bucket de R2, que debe crearse
      // con la pista de ubicación ENAM).
      "constraints": { "regions": ["ENAM"] }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ODOO", "class_name": "OdooContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OdooContainer"] }],

  // Caché de páginas: el HTML que dibuja Odoo para anónimos, guardado tal cual (src/tienda/paginas.ts).
  // Sin "id": Wrangler crea el namespace en el primer deploy («automatic provisioning», wrangler
  // ≥ 4.45) y lo deja enlazado; el token de CI necesita permiso «Workers KV Storage: Edit». Uno por
  // entorno. Por qué KV y no Cache API: edge/CONTRATO_CONTENEDOR.md → «Caché de páginas».
  "kv_namespaces": [{ "binding": "TIENDA" }],

  // UTC. "7 * * * *": cada hora, si Odoo está apagado lo despierta (runScheduled), solo
  // en 24/7: con ODOO_DORMIR_TRAS de duración (staging) lo deja dormido.
  // "17 8 * * *": 03:17 en Panamá (UTC-5), respaldo lógico diario dentro del contenedor.
  // Deben coincidir con CRON_HORARIO y CRON_RESPALDO de src/handler.ts (hay test).
  "triggers": { "crons": ["7 * * * *", "17 8 * * *"] },

  // Valores no secretos. Los secretos se cargan con `wrangler secret put` o desde
  // GitHub Actions (ver docs/DESPLIEGUE.md y edge/CONTRATO_CONTENEDOR.md):
  //   obligatorios para arrancar: ADMIN_PASSWORD, R2_ENDPOINT, R2_ACCESS_KEY_ID,
  //     R2_SECRET_ACCESS_KEY, PGBACKREST_CIPHER_PASS (si falta uno, el Worker no
  //     enciende el contenedor y /__edge/health lo dice);
  //   recomendados: DCASA_PIN_PEPPER, ODOO_MASTER_PASSWORD, RESPALDO_TOKEN.
  // No se usa `secrets.required`: el CI despliega antes de cargar secretos y fallaría.
  "vars": {
    "CANONICAL_HOST": "dcasapty.com",
    "DCASA_ENTORNO": "produccion",
    // Existencias de prueba: en producción SIEMPRE 0 (el entrypoint lo fuerza igual).
    "DCASA_STOCK_PRUEBA": "0",
    // Black Weekend (addons/website_dcasa/models/black_weekend.py): en producción solo dentro de la
    // ventana que fijó la dueña (lunes 5 a domingo 11 de octubre de 2026, hora de Panamá,
    // inclusive); pasada la fecha se apaga sola. "1" la mostraría sin mirar fechas.
    "DCASA_BLACK_WEEKEND": "0",
    "DCASA_BLACK_WEEKEND_INICIO": "2026-10-02",
    "DCASA_BLACK_WEEKEND_FIN": "2026-10-11",
    "R2_BUCKET": "dcasa-respaldos",
    // Vacío = 24/7 (el contenedor no se duerme nunca).
    "ODOO_DORMIR_TRAS": "",
    // Caché de páginas: "off" en producción hasta que la dueña la apruebe en staging (todo lo
    // sirve Odoo).
    "TIENDA_ESTATICA": "off",
    // Doble factor obligatorio (addons/dcasa_seguridad): "0" hasta que la dueña enrole su app
    // (docs/SEGURIDAD_ACCESO.md, paso 2). Luego "1" y desplegar.
    "DCASA_2FA_OBLIGATORIO": "0",
    "DCASA_2FA_ALCANCE": "admins"
    // Turnstile: "TURNSTILE_SITE_KEY": "<clave pública del widget>" aquí y TURNSTILE_SECRET como
    // secreto. Sin las dos, Turnstile queda apagado (docs/SEGURIDAD_ACCESO.md → Turnstile).
  },

  // Límite de intentos por IP en los POST sensibles (edge/src/bots.ts). Rate Limiting de Workers:
  // no es un recurso que se cree aparte (namespace_id es un número que elegimos, único en la
  // cuenta) y no tiene costo propio; se activa al desplegar con estas líneas. Mientras sigan
  // comentadas, el Worker usa un contador en memoria (aproximado). period solo admite 10 o 60.
  // "ratelimits": [
  //   { "name": "LIMITE_ACCESO", "namespace_id": "1101", "simple": { "limit": 10, "period": 60 } },
  //   { "name": "LIMITE_FORMULARIOS", "namespace_id": "1102", "simple": { "limit": 10, "period": 60 } },
  //   { "name": "LIMITE_CARRITO", "namespace_id": "1103", "simple": { "limit": 120, "period": 60 } }
  // ],

  // Dominio: se activa cuando el DNS de dcasapty.com esté en Cloudflare.
  // "routes": [
  //   { "pattern": "dcasapty.com", "custom_domain": true },
  //   { "pattern": "www.dcasapty.com", "custom_domain": true }
  // ],

  "env": {
    // Entorno de prueba para los simulacros de caída y restauración (Fase 1, punto 3).
    // `wrangler deploy --env staging`: otro Worker (dcasa-staging), por tanto otro
    // Durable Object, otra app de contenedor y otra instancia; otro bucket de R2 y sus
    // propios secretos (`wrangler secret put … --env staging`). Nunca comparte R2 con
    // producción: dos PostgreSQL en el mismo repositorio = contabilidad corrupta.
    "staging": {
      "name": "dcasa-staging",
      "containers": [
        {
          "class_name": "OdooContainer",
          "image": "../docker/Dockerfile",
          "image_build_context": "..",
          "scheduling_policy": "default",
          "instance_type": "basic",
          "max_instances": 1,
          "constraints": { "regions": ["ENAM"] }
        }
      ],
      "durable_objects": {
        "bindings": [{ "name": "ODOO", "class_name": "OdooContainer" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OdooContainer"] }],
      "kv_namespaces": [{ "binding": "TIENDA" }],
      "triggers": { "crons": ["7 * * * *", "17 8 * * *"] },
      "vars": {
        "CANONICAL_HOST": "staging.dcasapty.com",
        "DCASA_ENTORNO": "staging",
        // 10 unidades a cada producto sin existencias ni movimientos, para probar ventas
        // (addons/dcasa_catalogo: aplicar_stock_prueba; nunca pisa un conteo real).
        "DCASA_STOCK_PRUEBA": "10",
        // Black Weekend visible ya (vista previa para la dueña), sin mirar la ventana.
        "DCASA_BLACK_WEEKEND": "1",
        "DCASA_BLACK_WEEKEND_INICIO": "2026-10-02",
        "DCASA_BLACK_WEEKEND_FIN": "2026-10-11",
        "R2_BUCKET": "dcasa-respaldos-staging",
        // 24/7 como producción (decisión de la dueña, 2026-10-02): dormido, la página cacheada
        // en el borde salía sin estilos (los assets los sirve Odoo) y /socios tardaba ~1 min en
        // despertar y restaurar desde R2. Para abaratar una pausa larga, poner "1h".
        "ODOO_DORMIR_TRAS": "",
        // Caché de páginas encendida: el borde sirve a los anónimos el MISMO HTML que dibuja Odoo
        // (navbar píldora, héroe, footer; probado idéntico byte a byte salvo el token CSRF, que el
        // JS refresca). La plantilla propia de antes (apagada el 2026-10-02) ya no existe.
        // staging.dcasapty.com aún no apunta al Worker: el aviso de invalidación va a workers.dev.
        "TIENDA_AVISO_URL": "https://dcasa-staging.dcasapty.workers.dev/__edge/tienda/regenerar",
        "TIENDA_ESTATICA": "on",
        "DCASA_2FA_OBLIGATORIO": "0",
        "DCASA_2FA_ALCANCE": "admins"
      }
      // "routes": [{ "pattern": "staging.dcasapty.com", "custom_domain": true }]
    }
  }
}
