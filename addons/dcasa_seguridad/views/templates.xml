<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Política para rastreadores de IA al final de /robots.txt (controllers/robots.py). -->
    <template id="robots" inherit_id="website.robots">
        <xpath expr="//t[@t-out='request.website.sudo().robots_txt']" position="after">
<t t-out="dcasa_robots_ia or ''"/>
        </xpath>
    </template>

    <!-- Sin «No volver a preguntar en este dispositivo» para el personal: usa SIEMPRE el código de la app. -->
    <template id="totp_sin_dispositivo_de_confianza" inherit_id="auth_totp.auth_totp_form">
        <xpath expr="//input[@id='switch-remember']/parent::div" position="attributes">
            <attribute name="t-if">not user._is_internal()</attribute>
        </xpath>
    </template>

    <!-- La página de entrada del equipo, /master (controllers/master.py). Correo y clave, o llave de acceso; el código
         de la app se pide después, siempre. Colores de marca: el amarillo solo sobre azul. -->
    <template id="master_login" name="D'CASA: acceso del equipo">
        <t t-call="web.frontend_layout">
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <t t-set="title">Acceso del equipo</t>
            <t t-set="body_classname" t-value="'o_dcasa_master'"/>
            <style>
                body.o_dcasa_master { background: #0b2160; }
                .o_dcasa_master_tarjeta { max-width: 420px; margin: 8vh auto 4vh; background: #1340b1; color: #fff;
                    border-radius: 4px; padding: 2rem 1.75rem; }
                .o_dcasa_master_tarjeta h1 { font-family: Anton, Impact, sans-serif; font-weight: 400;
                    text-transform: uppercase; letter-spacing: .03em; font-size: 2rem; margin: 0 0 .25rem; color: #fff; }
                .o_dcasa_master_tarjeta .o_dcasa_master_sub { font-family: Oswald, sans-serif; margin: 0 0 1.5rem;
                    color: #fff; opacity: .9; }
                .o_dcasa_master_tarjeta label { font-weight: 600; margin-bottom: .25rem; }
                .o_dcasa_master_tarjeta .form-control { background: #fff; color: #0b2160; border: 0; }
                .o_dcasa_master_tarjeta .o_dcasa_master_entrar { background: #fed00f; color: #0b2160; border: 0;
                    font-weight: 700; padding: .65rem 1rem; margin-top: 1.25rem; }
                .o_dcasa_master_tarjeta .passkey_login_link { display: block; text-align: center; color: #fff;
                    border: 2px solid #fff; padding: .6rem 1rem; text-decoration: none; margin-top: 1rem; }
                .o_dcasa_master_tarjeta .alert-danger { background: #fff; color: #8a1c1c; border: 0; margin-top: 1rem; }
                .o_dcasa_master_tarjeta .o_dcasa_master_nota { font-size: .85rem; opacity: .9; margin: 1.25rem 0 0; }
            </style>
            <main class="container px-3">
                <div class="o_dcasa_master_tarjeta">
                    <h1>Acceso del equipo</h1>
                    <p class="o_dcasa_master_sub">Solo personal de D'CASA</p>
                    <form class="oe_login_form" role="form" method="post" action="/master" data-captcha="login">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="mb-3">
                            <label for="login">Correo</label>
                            <input type="text" name="login" id="login" class="form-control" required="required"
                                   t-att-value="login" autocapitalize="off" autocomplete="username webauthn"
                                   placeholder="tucorreo@dcasapty.com"/>
                        </div>
                        <div class="mb-3">
                            <label for="password">Contraseña</label>
                            <input type="password" name="password" id="password" class="form-control"
                                   required="required" autocomplete="current-password" maxlength="4096"/>
                        </div>
                        <p class="alert alert-danger" t-if="error" role="alert" t-out="error"/>
                        <div class="d-grid">
                            <button type="submit" class="btn o_dcasa_master_entrar">Entrar</button>
                            <a href="#" class="passkey_login_link" role="button">
                                <i class="fa fa-qrcode me-2" role="presentation"/>Entrar con llave de acceso
                            </a>
                        </div>
                        <input type="hidden" name="type" value="password"/>
                        <input type="hidden" name="webauthn_response"/>
                        <input type="hidden" name="redirect" t-att-value="redirect"/>
                    </form>
                    <p class="o_dcasa_master_nota">
                        Después te pedimos el código de la app Google Authenticator. Siempre, también con la llave de acceso.
                    </p>
                </div>
            </main>
        </t>
    </template>

    <!-- Enrolar la app de códigos al entrar (controllers/enrolar.py). -->
    <template id="enrolar_2fa" name="D'CASA: activar el doble factor">
        <t t-call="web.login_layout">
            <t t-set="disable_footer">1</t>
            <div class="oe_login_form o_dcasa_enrolar_2fa">
                <h5 class="card-title">Activa tu doble factor</h5>
                <p class="text-muted mb-2">
                    Para entrar al panel de D’CASA necesitas, además de tu clave, un código de 6 números
                    que cambia cada 30 segundos en tu teléfono.
                </p>
                <ol class="ps-3 mb-3">
                    <li>Instala una app de códigos: <strong>Google Authenticator</strong>,
                        <strong>Microsoft Authenticator</strong> o la que ya uses.</li>
                    <li>En la app toca <strong>+</strong> y <strong>escanea este código</strong>:</li>
                </ol>
                <div class="text-center mb-2">
                    <img t-att-src="'data:image/png;base64,%s' % qr" alt="Código QR para tu app de códigos"
                         width="200" height="200"/>
                </div>
                <details class="mb-3">
                    <summary>¿No puedes escanear? Escribe esta clave en la app</summary>
                    <code class="d-block text-center fs-5 mt-2" t-out="secreto"/>
                </details>
                <form method="POST" t-att-action="'/web/login/dcasa-2fa'">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="redirect" t-att-value="redirect"/>
                    <div class="mb-3">
                        <label class="fw-bold" for="codigo">3. Escribe el código que muestra la app</label>
                        <input id="codigo" name="codigo" class="form-control" autocomplete="one-time-code"
                               inputmode="numeric" autofocus="autofocus" required="required"
                               placeholder="123456"/>
                    </div>
                    <p class="alert alert-danger" t-if="error" role="alert" t-out="error"/>
                    <div class="d-grid mb-2">
                        <button type="submit" class="btn btn-primary">Activar y entrar</button>
                    </div>
                </form>
                <p class="small text-muted">
                    Guarda el teléfono con cuidado: si lo pierdes, otro administrador puede quitarte el doble
                    factor desde Ajustes › Usuarios para que lo actives de nuevo.
                </p>
                <form method="POST" action="/web/session/logout">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="w-100 text-center">
                        <button type="submit" class="btn btn-link btn-sm mb-2">Cancelar</button>
                    </div>
                </form>
            </div>
        </t>
    </template>

</odoo>
