<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- La cinta de «Llévame ahí»: pequeña, abajo de la pantalla de destino y fácil de cerrar. Vive en
         main_components: no se mete dentro de ninguna vista de Odoo. -->
    <t t-name="dcasa_guia.Cinta">
        <div t-if="cinta" class="o_dcasa_guia_cinta" role="region" aria-label="Lo que estás haciendo">
            <div class="o_dcasa_guia_cinta_texto">
                <p class="o_dcasa_guia_cinta_haciendo">
                    <span>Estás haciendo:</span>
                    <strong class="o_dcasa_guia_cinta_titulo" t-out="cinta.tarea.titulo"/>
                    <span t-if="actual !== null and pasos.length > 1" class="o_dcasa_guia_cinta_paso">
                        · Paso <t t-out="actual + 1"/> de <t t-out="pasos.length"/>
                    </span>
                </p>
                <p t-if="siguiente" class="o_dcasa_guia_cinta_siguiente">
                    <span>Siguiente:</span> <t t-out="siguiente.texto"/>
                </p>
                <p t-elif="esUltimo" class="o_dcasa_guia_cinta_siguiente">Es el último paso.</p>
            </div>
            <div class="o_dcasa_guia_cinta_botones">
                <t t-if="siguiente">
                    <button t-if="siguiente.destino" type="button" class="btn btn-primary btn-sm o_dcasa_guia_cinta_siguiente_ir"
                            aria-label="Llévame ahí, al paso siguiente" t-on-click="irAlSiguiente">Llévame ahí</button>
                    <button t-else="" type="button" class="btn btn-secondary btn-sm o_dcasa_guia_cinta_avanzar"
                            t-on-click="() => this.ruta.avanzar()">Ya lo hice</button>
                </t>
                <button type="button" class="btn btn-link btn-sm o_dcasa_guia_cinta_volver"
                        t-on-click="() => this.ruta.volverALaGuia(cinta.tarea.id)">Volver a la Guía</button>
                <button type="button" class="o_dcasa_guia_cinta_cerrar" aria-label="Cerrar este recordatorio"
                        t-on-click="() => this.ruta.descartar()">
                    <i class="fa fa-times" aria-hidden="true"/>
                </button>
            </div>
        </div>
    </t>
</templates>
