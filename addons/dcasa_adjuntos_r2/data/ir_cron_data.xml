<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Deja los adjuntos donde dice ir_attachment.location (r2: sube; db con credenciales: trae de vuelta). -->
    <record id="ir_cron_adjuntos_r2_migrar" model="ir.cron">
        <field name="name">Adjuntos en R2: mover según ir_attachment.location</field>
        <field name="model_id" ref="base.model_ir_attachment"/>
        <field name="state">code</field>
        <field name="code">model._dcasa_r2_cron_migrar()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <!-- Borra en R2 lo que nadie referencia desde hace más que la ventana de respaldos. -->
    <record id="ir_cron_adjuntos_r2_gc" model="ir.cron">
        <field name="name">Adjuntos en R2: recolectar objetos sin uso</field>
        <field name="model_id" ref="base.model_ir_attachment"/>
        <field name="state">code</field>
        <field name="code">model._dcasa_r2_gc()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
