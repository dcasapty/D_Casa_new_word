<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="presupuesto_list" model="ir.ui.view">
        <field name="name">dcasa.presupuesto.list</field>
        <field name="model">dcasa.presupuesto</field>
        <field name="arch" type="xml">
            <list string="Presupuestos">
                <field name="name"/>
                <field name="fecha_desde"/>
                <field name="fecha_hasta"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="total_planeado" sum="Planeado"/>
                <field name="total_real" sum="Real"/>
                <field name="state" widget="badge" decoration-info="state == 'borrador'"
                       decoration-success="state == 'aprobado'"/>
            </list>
        </field>
    </record>

    <record id="presupuesto_form" model="ir.ui.view">
        <field name="name">dcasa.presupuesto.form</field>
        <field name="model">dcasa.presupuesto</field>
        <field name="arch" type="xml">
            <form string="Presupuesto">
                <header>
                    <button name="action_aprobar" type="object" string="Aprobar" class="btn-primary"
                            invisible="state != 'borrador'"/>
                    <button name="action_cerrar" type="object" string="Cerrar" invisible="state != 'aprobado'"/>
                    <button name="action_borrador" type="object" string="Volver a borrador"
                            invisible="state == 'borrador'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_ver_apuntes" type="object" class="oe_stat_button" icon="fa-list">
                            <span>Movimientos</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="p. ej. Gastos de operación 2026"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="fecha_desde"/>
                            <field name="fecha_hasta"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="total_planeado"/>
                            <field name="total_real"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Líneas" name="lineas">
                            <field name="line_ids" readonly="state == 'cerrado'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="account_id" options="{'no_create': True}"/>
                                    <field name="analytic_account_id" optional="show" options="{'no_create': True}"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="monto_planeado" sum="Planeado"/>
                                    <field name="monto_real" sum="Real"/>
                                    <field name="diferencia" sum="Diferencia"
                                           decoration-danger="diferencia &lt; 0"/>
                                    <field name="porcentaje" widget="progressbar"/>
                                    <button name="action_ver_apuntes" type="object" icon="fa-search"
                                            title="Ver movimientos"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notas" name="notas">
                            <field name="notas" placeholder="Supuestos, metas o comentarios del presupuesto…"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="presupuesto_search" model="ir.ui.view">
        <field name="name">dcasa.presupuesto.search</field>
        <field name="model">dcasa.presupuesto</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="activos" string="Vigentes" domain="[('state', '!=', 'cerrado')]"/>
            </search>
        </field>
    </record>

    <record id="accion_presupuestos" model="ir.actions.act_window">
        <field name="name">Presupuestos</field>
        <field name="res_model">dcasa.presupuesto</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_activos': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea tu primer presupuesto</p>
            <p>Pon cuánto planeas vender o gastar por cuenta y el sistema te muestra lo real y el % ejecutado.</p>
        </field>
    </record>
</odoo>
