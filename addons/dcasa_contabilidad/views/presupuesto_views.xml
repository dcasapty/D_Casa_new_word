<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="presupuesto_list" model="ir.ui.view">
        <field name="name">dcasa.presupuesto.list</field>
        <field name="model">dcasa.presupuesto</field>
        <field name="arch" type="xml">
            <list string="Presupuestos">
                <field name="name"/>
                <field name="fecha_desde"/>
                <field name="fecha_hasta"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="avance_tiempo" widget="progressbar" optional="show"/>
                <field name="ingresos_planeado" sum="Ingresos planeados" optional="show"/>
                <field name="ingresos_real" sum="Ingresos reales" optional="show"/>
                <field name="gastos_planeado" sum="Gastos planeados" optional="show"/>
                <field name="gastos_real" sum="Gastos reales" optional="show"/>
                <field name="resultado_planeado" optional="hide"/>
                <field name="resultado_real" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'borrador'"
                       decoration-success="state == 'aprobado'"/>
            </list>
        </field>
    </record>

    <record id="presupuesto_form" model="ir.ui.view">
        <field name="name">dcasa.presupuesto.form</field>
        <field name="model">dcasa.presupuesto</field>
        <field name="arch" type="xml">
            <form string="Presupuesto">
                <header>
                    <button name="action_aprobar" type="object" string="Aprobar" class="btn-primary"
                            invisible="state != 'borrador'"/>
                    <button name="action_cerrar" type="object" string="Cerrar" invisible="state != 'aprobado'"/>
                    <button name="action_borrador" type="object" string="Volver a borrador"
                            invisible="state == 'borrador'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_ver_apuntes" type="object" class="oe_stat_button" icon="fa-list">
                            <span>Movimientos</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="p. ej. Gastos de operación 2026"/></h1>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="not aviso">
                        <field name="aviso" readonly="1" nolabel="1"/>
                    </div>
                    <group>
                        <group string="Periodo">
                            <field name="fecha_desde"/>
                            <field name="fecha_hasta"/>
                            <field name="avance_tiempo" widget="progressbar"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Ingresos y gastos (sin contar cuentas de balance)">
                            <field name="currency_id" invisible="1"/>
                            <field name="ingresos_planeado"/>
                            <field name="ingresos_real"/>
                            <field name="gastos_planeado"/>
                            <field name="gastos_real"/>
                            <field name="resultado_planeado"/>
                            <field name="resultado_real"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Líneas" name="lineas">
                            <field name="line_ids" readonly="state == 'cerrado'">
                                <list editable="bottom" decoration-muted="es_detalle">
                                    <field name="sequence" widget="handle"/>
                                    <field name="account_id" options="{'no_create': True}"/>
                                    <field name="analytic_account_id" optional="show" options="{'no_create': True}"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="naturaleza" optional="hide"/>
                                    <field name="monto_planeado"/>
                                    <field name="monto_real"/>
                                    <field name="diferencia" decoration-danger="situacion == 'excedido'"
                                           decoration-success="situacion == 'cumplido'"/>
                                    <field name="porcentaje" widget="progressbar" invisible="monto_planeado == 0"/>
                                    <field name="situacion" widget="badge" decoration-danger="situacion == 'excedido'"
                                           decoration-warning="situacion == 'sin_plan'"
                                           decoration-success="situacion in ('dentro', 'cumplido')"
                                           decoration-info="situacion == 'en_camino'"/>
                                    <field name="es_detalle" optional="hide"/>
                                    <button name="action_ver_apuntes" type="object" icon="fa-search"
                                            title="Ver movimientos"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notas" name="notas">
                            <field name="notas" placeholder="Supuestos, metas o comentarios del presupuesto…"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="presupuesto_search" model="ir.ui.view">
        <field name="name">dcasa.presupuesto.search</field>
        <field name="model">dcasa.presupuesto</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="line_ids" string="Cuenta contable" filter_domain="[('line_ids.account_id', 'ilike', self)]"/>
                <filter name="activos" string="Vigentes" domain="[('state', '!=', 'cerrado')]"/>
                <separator/>
                <filter name="en_borrador" string="Borrador" domain="[('state', '=', 'borrador')]"/>
                <filter name="aprobados" string="Aprobados" domain="[('state', '=', 'aprobado')]"/>
                <filter name="cerrados" string="Cerrados" domain="[('state', '=', 'cerrado')]"/>
                <separator/>
                <filter name="periodo_hoy" string="Periodo: Hoy" domain="[('periodo_atajo', '=', 'hoy')]"
                        help="Presupuestos cuyo periodo toca esos días"/>
                <filter name="periodo_semana" string="Periodo: Esta semana" domain="[('periodo_atajo', '=', 'semana')]"
                        help="Presupuestos cuyo periodo toca esos días"/>
                <filter name="periodo_quincena" string="Periodo: Esta quincena" domain="[('periodo_atajo', '=', 'quincena')]"
                        help="Presupuestos cuyo periodo toca esos días"/>
                <filter name="periodo_mes" string="Periodo: Este mes" domain="[('periodo_atajo', '=', 'mes')]"
                        help="Presupuestos cuyo periodo toca esos días"/>
                <filter name="periodo_mes_pasado" string="Periodo: Mes pasado" domain="[('periodo_atajo', '=', 'mes_pasado')]"
                        help="Presupuestos cuyo periodo toca esos días"/>
                <filter name="periodo_trimestre" string="Periodo: Este trimestre" domain="[('periodo_atajo', '=', 'trimestre')]"
                        help="Presupuestos cuyo periodo toca esos días"/>
                <filter name="periodo_ejercicio" string="Periodo: Este año fiscal" domain="[('periodo_atajo', '=', 'ejercicio')]"
                        help="Presupuestos cuyo periodo toca esos días"/>
                <group>
                    <filter name="por_estado" string="Estado" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="accion_presupuestos" model="ir.actions.act_window">
        <field name="name">Presupuestos</field>
        <field name="res_model">dcasa.presupuesto</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_activos': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea tu primer presupuesto</p>
            <p>Pon cuánto planeas vender o gastar por cuenta y el sistema te muestra lo real y el % ejecutado.</p>
        </field>
    </record>
</odoo>
