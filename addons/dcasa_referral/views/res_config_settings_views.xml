<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_dcasa_referral" model="ir.ui.view">
        <field name="name">res.config.settings.form.dcasa.referral</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pricing_setting_container']" position="after">
                <block title="Programa de referidos" name="dcasa_referral_setting_container">
                    <setting id="dcasa_referral_reward" string="Recompensa por referido"
                             help="Se genera cuando se publica la factura del cliente referido y se gana cuando queda pagada.">
                        <div class="content-group">
                            <div class="row mt-2">
                                <label for="dcasa_referral_reward_type" string="Tipo" class="col-4 o_light_label"/>
                                <field name="dcasa_referral_reward_type" class="col-8"/>
                            </div>
                            <div class="row">
                                <label for="dcasa_referral_reward_value" string="Valor" class="col-4 o_light_label"/>
                                <field name="dcasa_referral_reward_value" class="col-8"/>
                            </div>
                            <div class="row">
                                <label for="dcasa_referral_min_amount" string="Compra mínima" class="col-4 o_light_label"/>
                                <field name="dcasa_referral_min_amount" class="col-8"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="dcasa_referral_first_purchase" help="Cada cliente referido genera recompensa solo en su primera factura.">
                        <field name="dcasa_referral_first_purchase_only"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
