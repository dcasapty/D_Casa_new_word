<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dcasa_referral_reward_list" model="ir.ui.view">
        <field name="name">dcasa.referral.reward.list</field>
        <field name="model">dcasa.referral.reward</field>
        <field name="arch" type="xml">
            <list string="Recompensas de referidos" create="false" decoration-muted="state == 'cancelled'"
                  decoration-success="state == 'earned'" decoration-info="state == 'pending'">
                <field name="name"/>
                <field name="invoice_date"/>
                <field name="referrer_id"/>
                <field name="referred_partner_id"/>
                <field name="move_id"/>
                <field name="base_amount" sum="Total facturado" optional="show"/>
                <field name="amount" sum="Total recompensas"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="payout_date" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'earned'"
                       decoration-info="state == 'pending'" decoration-muted="state in ('cancelled', 'paid')"/>
            </list>
        </field>
    </record>

    <record id="view_dcasa_referral_reward_form" model="ir.ui.view">
        <field name="name">dcasa.referral.reward.form</field>
        <field name="model">dcasa.referral.reward</field>
        <field name="arch" type="xml">
            <form string="Recompensa de referido" create="false">
                <header>
                    <button name="action_mark_paid" type="object" string="Marcar como pagada" class="btn-primary"
                            invisible="state != 'earned'" groups="sales_team.group_sale_manager"/>
                    <button name="action_undo_payout" type="object" string="Deshacer pago"
                            invisible="state != 'paid'" groups="sales_team.group_sale_manager"
                            confirm="¿Seguro? La recompensa vuelve a quedar como ganada y por pagar."/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,earned,paid"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_invoice" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <div class="o_stat_info"><span class="o_stat_text">Factura</span></div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Referido">
                            <field name="referrer_id"/>
                            <field name="referred_partner_id"/>
                            <field name="move_id"/>
                            <field name="invoice_date"/>
                            <field name="sale_order_ids" widget="many2many_tags" invisible="not sale_order_ids"/>
                        </group>
                        <group string="Recompensa">
                            <field name="currency_id" invisible="1"/>
                            <field name="base_amount"/>
                            <field name="amount"/>
                            <field name="payout_date" invisible="not payout_date"/>
                            <field name="payout_note" readonly="state == 'cancelled'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dcasa_referral_reward_search" model="ir.ui.view">
        <field name="name">dcasa.referral.reward.search</field>
        <field name="model">dcasa.referral.reward</field>
        <field name="arch" type="xml">
            <search string="Recompensas de referidos">
                <field name="name"/>
                <field name="referrer_id"/>
                <field name="referred_partner_id"/>
                <field name="move_id"/>
                <filter name="to_pay" string="Por pagar al referidor" domain="[('state', '=', 'earned')]"/>
                <filter name="pending" string="Esperando pago del cliente" domain="[('state', '=', 'pending')]"/>
                <filter name="paid" string="Pagadas" domain="[('state', '=', 'paid')]"/>
                <filter name="cancelled" string="Anuladas" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="invoice_date" string="Fecha de factura" date="invoice_date"/>
                <group>
                    <filter name="group_referrer" string="Referidor" context="{'group_by': 'referrer_id'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_month" string="Mes" context="{'group_by': 'invoice_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dcasa_referral_reward" model="ir.actions.act_window">
        <field name="name">Recompensas de referidos</field>
        <field name="res_model">dcasa.referral.reward</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_pay': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aún no hay recompensas</p>
            <p>
                Se crean solas: cuando se publica la factura de un cliente que llegó referido,
                aparece aquí como pendiente, y pasa a ganada cuando la factura queda pagada.
            </p>
        </field>
    </record>

    <record id="action_dcasa_referrers" model="ir.actions.act_window">
        <field name="name">Referidores</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('dcasa_referral_code', '!=', False)]</field>
        <field name="view_id" ref="view_partner_list_dcasa_referrers"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nadie tiene código de referido todavía</p>
            <p>Abre un cliente y, en la pestaña «Referidos», pulsa «Generar código».</p>
        </field>
    </record>
</odoo>
