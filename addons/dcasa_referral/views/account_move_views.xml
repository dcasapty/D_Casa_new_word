<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_dcasa_referral" model="ir.ui.view">
        <field name="name">account.move.form.dcasa.referral</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="invoice_user_id" position="after">
                <field name="dcasa_referrer_id" invisible="move_type != 'out_invoice'"
                       readonly="state != 'draft'" options="{'no_create': True}"/>
            </field>
        </field>
    </record>
</odoo>
