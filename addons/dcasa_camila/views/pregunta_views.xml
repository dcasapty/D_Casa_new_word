<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Etapa 1b (decisión de la dueña, 2026-11-06): «¿El cliente quiere recibir novedades por correo?» al confirmar una
         venta o registrar un pago DESDE LA PANTALLA. La marca dcasa_camila_preguntar va solo en estos botones: Juan, la
         web, Brian, los crones y un RPC sin ella nunca ven la pregunta. Sale DESPUÉS de confirmar o pagar: nunca traba
         la venta ni el pago (models/pregunta.py). -->
    <record id="sale_order_form_dcasa_camila_pregunta" model="ir.ui.view">
        <field name="name">sale.order.form.dcasa.camila.pregunta</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="(//header/button[@name='action_confirm'])[1]" position="attributes">
                <attribute name="context">{'validate_analytic': True, 'dcasa_camila_preguntar': True}</attribute>
            </xpath>
            <xpath expr="(//header/button[@name='action_confirm'])[2]" position="attributes">
                <attribute name="context">{'validate_analytic': True, 'dcasa_camila_preguntar': True}</attribute>
            </xpath>
        </field>
    </record>

    <record id="payment_register_form_dcasa_camila_pregunta" model="ir.ui.view">
        <field name="name">account.payment.register.form.dcasa.camila.pregunta</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <xpath expr="(//button[@name='action_create_payments'])[1]" position="attributes">
                <attribute name="context">{'dcasa_camila_preguntar': True}</attribute>
            </xpath>
            <xpath expr="(//button[@name='action_create_payments'])[2]" position="attributes">
                <attribute name="context">{'dcasa_camila_preguntar': True}</attribute>
            </xpath>
        </field>
    </record>

    <!-- El cuadro: «Sí» o «No», sin «Cancelar» (la X de arriba no se muestra: camila.scss). Con la regla del scroll. -->
    <record id="dcasa_camila_pregunta_form" model="ir.ui.view">
        <field name="name">dcasa.camila.pregunta.form</field>
        <field name="model">dcasa.camila.pregunta</field>
        <field name="arch" type="xml">
            <form string="Novedades por correo" create="0" delete="0" class="o_dcasa_camila_pregunta">
                <field name="paso" invisible="1"/>
                <div class="o_camila_pregunta_cuerpo">
                    <p class="o_camila_pregunta_titulo">
                        ¿<field name="nombre" readonly="1" class="oe_inline"/> quiere recibir novedades de D'CASA por correo?
                    </p>
                    <p class="o_camila_pregunta_ayuda" invisible="paso != 'pregunta'">
                        Pregúntale: «¿Te avisamos por correo cuando llegue algo nuevo a la tienda?». Toca «Sí» solo si te
                        dice que sí; «No» si no quiere (no se le vuelve a preguntar en un buen tiempo).
                    </p>
                    <p class="o_camila_pregunta_correo_actual text-muted" invisible="paso != 'pregunta' or not correo_actual">
                        Le llegarían a <field name="correo_actual" readonly="1" class="oe_inline"/>.
                    </p>
                    <div class="o_camila_pregunta_paso_correo" invisible="paso != 'correo'">
                        <p>Dijo que sí, pero su ficha no tiene un correo bien escrito. Pídeselo y escríbelo aquí: se
                            guarda en su ficha. Sin correo no se le pueden mandar las novedades.</p>
                        <label for="correo" string="Su correo"/>
                        <field name="correo" placeholder="nombre@gmail.com" class="o_camila_pregunta_correo"
                               widget="email"/>
                    </div>
                    <p class="o_camila_pregunta_referencia text-muted small">
                        <field name="referencia" readonly="1" class="oe_inline"/>
                    </p>
                </div>
                <footer>
                    <button name="action_si" type="object" string="Sí" class="btn-primary o_camila_pregunta_si"
                            invisible="paso != 'pregunta'" data-hotkey="s"/>
                    <button name="action_no" type="object" string="No" class="btn-secondary o_camila_pregunta_no"
                            invisible="paso != 'pregunta'" data-hotkey="n"/>
                    <button name="action_si" type="object" string="Guardar el correo y anotar el sí"
                            class="btn-primary o_camila_pregunta_guardar" invisible="paso != 'correo'"/>
                    <button name="action_sin_correo" type="object" string="No dio su correo"
                            class="btn-secondary o_camila_pregunta_sin_correo" invisible="paso != 'correo'"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
