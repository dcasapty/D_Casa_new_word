<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Yappy no tiene consulta de estado: si el aviso se pierde, nadie lo vuelve a mandar. Cada 10 minutos se buscan los
         cobros mandados hace más de 15 que siguen sin aviso y se le deja un pendiente a Caja (una sola vez por cobro). NO
         paga ni cancela nada por su cuenta. Sin claves cargadas no hace nada ni llama a nadie. -->
    <record id="cron_sin_aviso" model="ir.cron">
        <field name="name">Yappy: pendientes de cobros sin aviso</field>
        <field name="model_id" ref="payment.model_payment_transaction"/>
        <field name="state">code</field>
        <field name="code">model._cron_dcasa_yappy_sin_aviso()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
