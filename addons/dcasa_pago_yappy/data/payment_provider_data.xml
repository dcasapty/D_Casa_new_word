<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- NACE APAGADO y sin publicar. Se ofrece en la tienda solo si Gerencia lo enciende, las claves están en Cloudflare y
         el interruptor coincide con YAPPY_ENTORNO (docs/YAPPY.md). No hay campos de claves: no existe dónde ponerlas. -->
    <record id="payment_provider_yappy" model="payment.provider">
        <field name="name">Yappy directo</field>
        <field name="code">yappy</field>
