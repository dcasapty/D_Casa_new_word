<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Página normal (no ventana emergente): una ventana emergente abierta desde un menú deja su dirección en la barra del
        navegador y reaparece vacía al recargar o al volver atrás, encima de lo que se esté viendo.
    -->
    <record id="view_dcasa_equipo_alta_form" model="ir.ui.view">
        <field name="name">dcasa.equipo.alta.form</field>
        <field name="model">dcasa.equipo.alta</field>
        <field name="arch" type="xml">
            <form string="Alta del equipo">
                <header>
                    <button name="action_leer" type="object" string="Leer lista" class="btn-secondary"
                            invisible="not texto"/>
                    <button name="action_crear" type="object" string="Crear al equipo" class="btn-primary"
                            invisible="not linea_ids"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Pega una persona por línea: <strong>nombre | correo | departamento | cargo | rol</strong>.
                        El rol es Vendedora, Gerencia o Administrador (control total). Pulsa «Leer lista» para
                        revisarla y después «Crear al equipo»: se crea el usuario, la ficha de empleado y el
                        departamento. <strong>No se manda ninguna invitación</strong>: la persona entra cuando le
                        envíes la invitación desde su usuario (Ajustes › Usuarios › Enviar correo de invitación), y
                        para pasar la puerta su correo debe estar en Cloudflare Access (política «Equipo D'CASA»).
                    </div>
                    <group>
                        <field name="texto" widget="text" placeholder="Nombre Apellido | correo@ejemplo.com | Ventas | Cargo | Vendedora"/>
                    </group>
                    <field name="linea_ids" nolabel="1" invisible="not linea_ids">
                        <list editable="bottom" create="0" decoration-danger="estado == 'error'" decoration-success="estado == 'creado'" decoration-muted="estado == 'ya_estaba'">
                            <field name="nombre"/>
                            <field name="correo"/>
                            <field name="departamento"/>
                            <field name="cargo"/>
                            <field name="rol"/>
                            <field name="estado" widget="badge"/>
                            <field name="resultado"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dcasa_equipo_alta" model="ir.actions.act_window">
        <field name="name">Alta del equipo</field>
        <field name="res_model">dcasa.equipo.alta</field>
        <field name="view_mode">form</field>
        <!-- Explícito: al actualizar, Odoo no quita un valor que el XML deje de nombrar, y en las bases donde ya estuvo
             como ventana emergente («new») se quedaría así. -->
        <field name="target">current</field>
    </record>

    <menuitem id="menu_dcasa_equipo_alta" name="Alta del equipo" parent="hr.menu_hr_root" sequence="2"
              action="action_dcasa_equipo_alta" groups="base.group_erp_manager"/>
</odoo>
