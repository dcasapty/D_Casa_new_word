<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- El sitio se edita desde el código (decisión de la dueña, 2026-10-02): Gerencia NO recibe el
         grupo de diseñador del sitio. dcasa_interfaz retira ese grupo a todo usuario al actualizar
         (docs/OPERACION.md → «El sitio se edita por código»). El registro queda para no borrar el
         xml_id ni romper actualizaciones; sin implied_ids de website. -->
    <record id="dcasa_base.group_gerencia" model="res.groups">
        <field name="implied_ids" eval="[(3, ref('website.group_website_designer'))]"/>
    </record>
</odoo>
