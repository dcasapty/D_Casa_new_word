<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Carrusel de la portada (models/portada.py): Sitio web › Carrusel de la portada, para Gerencia y administradores.
         Una sola pantalla con lo que cambia el fondo de la portada: arriba los segundos que dura cada foto y abajo la
         lista de productos, que se ordena arrastrando (el de arriba sale primero). Lista vacía = el hero de siempre.
         Es el formulario de los ajustes del carrusel del sitio actual (``dcasa.portada.ajustes``, uno por sitio): Gerencia
         no escribe nada del sitio mismo (``website``), solo estos ajustes y la lista (models/portada.py). -->
    <record id="view_dcasa_portada_ajustes_form" model="ir.ui.view">
        <field name="name">dcasa.portada.ajustes.form</field>
        <field name="model">dcasa.portada.ajustes</field>
        <field name="arch" type="xml">
            <form string="Carrusel de la portada" create="false" delete="false" duplicate="false">
                <sheet>
                    <div class="oe_title">
                        <h1>Carrusel de la portada</h1>
                    </div>
                    <group name="velocidad" string="Velocidad">
                        <field name="segundos" class="o_dcasa_hero_segundos" widget="float"
                               options="{'step': 0.5}"/>
                        <div colspan="2" class="text-muted o_dcasa_hero_segundos_ayuda">
                            De 2 a 15 segundos; de fábrica 3. El paso de una foto a la otra y el zoom lento se
                            ajustan solos a este tiempo. Quien tiene activado «reducir movimiento» en su aparato ve
                            la primera foto quieta.
                        </div>
                    </group>
                    <group name="productos" string="Productos de la portada">
                        <field name="diapositiva_ids" nolabel="1" colspan="2">
                            <list editable="bottom" decoration-muted="not en_portada">
                                <field name="sequence" widget="handle"/>
                                <field name="imagen" widget="image" options="{'size': [48, 48]}" string=""/>
                                <field name="product_tmpl_id" options="{'no_create': True, 'no_open': True}"/>
                                <field name="default_code" optional="show"/>
                                <field name="en_portada" widget="boolean" readonly="1"/>
                            </list>
                        </field>
                    </group>
                    <div class="alert alert-info mb-0" role="note">
                        <p class="mb-1"><strong>Cómo funciona.</strong> Con «Agregar una línea» eliges un producto
                            publicado; su foto principal sale de fondo en la portada, una tras otra.
                            Arrastra para elegir cuál sale primero; las demás van en orden al azar. La columna «Sale en
                            la portada» dice cuáles se pueden mostrar (publicados, a la venta y con foto).</p>
                        <p class="mb-0">Mientras la lista esté vacía, la portada muestra la foto de siempre. El cambio se
                            ve en la página en unos segundos.</p>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dcasa_portada_carrusel" model="ir.actions.server">
        <field name="name">Carrusel de la portada</field>
        <field name="model_id" ref="model_dcasa_portada_ajustes"/>
        <field name="state">code</field>
        <field name="code">action = model.action_abrir()</field>
        <field name="group_ids" eval="[Command.set([ref('dcasa_base.group_gerencia'), ref('base.group_system')])]"/>
    </record>

    <menuitem id="menu_dcasa_portada_diapositiva" name="Carrusel de la portada" parent="website.menu_website_configuration"
              action="action_dcasa_portada_carrusel" sequence="7" groups="dcasa_base.group_gerencia,base.group_system"/>
</odoo>
