<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="referidos" name="Refiere y gana">
        <t t-call="website.layout">
            <t t-set="additional_title">Refiere y gana</t>
            <div id="wrap" class="oe_structure o_dcasa_referidos">
                <section class="s_text_block o_cc o_cc4 pt80 pb64" data-snippet="s_text_block" data-name="Portada referidos">
                    <div class="container">
                        <p class="o_dcasa_kicker">Programa de referidos</p>
                        <h1 class="o_dcasa_display">Refiere y gana</h1>
                        <p class="lead">Recomienda D'CASA a tu familia y amigos. Cuando paguen su compra, tú ganas.</p>
                    </div>
                </section>
                <div class="o_dcasa_band" aria-hidden="true"/>
                <section class="s_text_block o_cc o_cc1 pt64 pb64" data-snippet="s_text_block" data-name="Cómo funciona">
                    <div class="container">
                        <h2>Así de fácil</h2>
                        <ol class="o_dcasa_steps mt-3">
                            <li><strong>Pide tu código.</strong> Entra a tu cuenta y genera tu código de referido, o pídelo en la tienda.</li>
                            <li><strong>Compártelo.</strong> Envía tu link por WhatsApp. Tu referido también puede dar tu código al comprar en la tienda.</li>
                            <li><strong>Gana.</strong> Cuando tu referido paga su factura, tu recompensa queda lista y te avisamos para cobrarla.</li>
                        </ol>
                        <p class="mt-4">
                            <a href="/my/referidos" class="btn btn-lg btn-primary">Quiero mi código</a>
                            <a t-att-href="website._dcasa_whatsapp_url('Hola D\'CASA, quiero saber del programa de referidos')"
                               class="btn btn-lg btn-link" target="_blank" rel="noopener">Pregúntanos por WhatsApp</a>
                        </p>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <record id="referidos_page" model="website.page">
        <field name="url">/referidos</field>
        <field name="is_published">True</field>
        <field name="view_id" ref="referidos"/>
        <field name="track">True</field>
        <field name="website_meta_description">Recomienda D'CASA Panamá a tu familia y amigos y gana por cada compra que paguen.</field>
    </record>
</odoo>
