<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===================================================================
         Portada D'CASA v2 (ver docs/historico/REDISENO.md).

         Los bloques .oe_structure con id son editables en Sitio web > Editar
         (textos, fotos, botones). Las categorías, los carruseles de productos y
         el bloque de socios son dinámicos: salen del catálogo y de las reglas
         del programa, y se actualizan solos.
         =================================================================== -->

    <!-- Ícono «agregar al carrito» (carrito con un +): quien compra en línea lo reconoce sin la palabra (pedido de la
         dueña, 2026-11-15). Trazo como los íconos de los beneficios; el nombre lo da el aria-label del botón. -->
    <template id="icono_carrito" name="D'CASA: ícono de agregar al carrito">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.9"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M3 4h2.2l2.1 10.1a1.6 1.6 0 0 0 1.6 1.3h8.2a1.6 1.6 0 0 0 1.6-1.2L20.4 8H6.1"/>
            <circle cx="9.6" cy="19.6" r="1.35"/>
            <circle cx="17.2" cy="19.6" r="1.35"/>
            <path d="M13.2 9.6v3.6M11.4 11.4H15"/>
        </svg>
    </template>

    <!-- Tarjeta de producto de los carruseles (v3): foto, nombre, y abajo el precio con el carrito y WhatsApp. -->
    <template id="tarjeta_producto" name="D'CASA: tarjeta de producto">
        <t t-set="producto" t-value="item['producto']"/>
        <article class="o_dcasa_pcard">
            <a t-att-href="producto.website_url" class="o_dcasa_pcard_media" tabindex="-1" aria-hidden="true">
                <picture>
                    <t t-set="dcasa_webp" t-value="website._dcasa_img_srcset(producto, (256, 512))"/>
                    <source t-if="dcasa_webp" type="image/webp" t-att-srcset="dcasa_webp"
                            sizes="(min-width: 992px) 25vw, (min-width: 576px) 42vw, 72vw"/>
                    <img t-att-src="website.image_url(producto, 'image_512')" alt=""
                         t-attf-srcset="#{website.image_url(producto, 'image_256')} 256w, #{website.image_url(producto, 'image_512')} 512w"
                         sizes="(min-width: 992px) 25vw, (min-width: 576px) 42vw, 72vw"
                         width="512" height="512" loading="lazy" decoding="async"/>
                </picture>
                <t t-call="website_dcasa.etiqueta_black_weekend"><t t-set="producto_bw" t-value="producto"/></t>
            </a>
            <div class="o_dcasa_pcard_body">
                <h3 class="o_dcasa_pcard_name"><a t-att-href="producto.website_url" t-out="producto._dcasa_nombre_cliente()"/></h3>
                <div class="o_dcasa_pcard_pie">
                    <p t-if="item['precio'] or not website.prevent_zero_price_sale" class="o_dcasa_pcard_price">
                        <span t-out="item['precio']" t-options="{'widget': 'monetary', 'display_currency': item['moneda']}"/>
                        <t t-call="website_dcasa.mas_itbms"><t t-set="producto_itbms" t-value="producto"/></t>
                    </p>
                    <div class="o_dcasa_pcard_actions">
                        <form t-if="item['directo']" action="/dcasa/carrito/agregar" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="product_template_id" t-att-value="producto.id"/>
                            <button type="submit" class="btn btn-primary o_dcasa_pcard_add" title="Agregar al carrito"
                                    t-attf-aria-label="Agregar {{ producto._dcasa_nombre_cliente() }} al carrito">
                                <t t-call="website_dcasa.icono_carrito"/>
                            </button>
                        </form>
                        <!-- Con medidas o colores para elegir: el mismo carrito lleva a la ficha. -->
                        <a t-else="" t-att-href="producto.website_url" class="btn btn-primary o_dcasa_pcard_add" title="Elegir medida o color"
                           t-attf-aria-label="Elegir medida o color de {{ producto._dcasa_nombre_cliente() }}">
                            <t t-call="website_dcasa.icono_carrito"/>
                        </a>
                        <a t-att-href="website._dcasa_whatsapp_producto(producto)" target="_blank" rel="noopener"
                           class="btn o_dcasa_pcard_wa" title="Preguntar por WhatsApp"
                           t-attf-aria-label="Preguntar por {{ producto._dcasa_nombre_cliente() }} por WhatsApp (se abre en una pestaña nueva)">
                            <i class="fa fa-whatsapp" aria-hidden="true"/>
                        </a>
                    </div>
                </div>
            </div>
        </article>
    </template>

    <!-- Carril (v3): UNA fila que se desliza, en el celular y en la computadora. Las flechas y la línea de avance
         nacen escondidas y las enciende carril.js solo si hay algo que deslizar (sin JavaScript, se desliza igual). -->
    <template id="carrusel_productos" name="D'CASA: carrusel de productos">
        <section t-if="items" class="o_dcasa_section o_dcasa_rail" t-att-aria-label="titulo">
            <div class="o_dcasa_container">
                <div class="o_dcasa_section_head">
                    <div data-anim-cascada="izquierda">
                        <p class="o_dcasa_kicker" t-out="antetitulo"/>
                        <h2 class="o_dcasa_h2" data-titular="" t-out="titulo"/>
                    </div>
                    <div class="o_dcasa_section_extra">
                        <div class="o_dcasa_carril_flechas" hidden="">
                            <button type="button" class="o_dcasa_carril_flecha" data-carril="-1" disabled=""
                                    t-attf-aria-label="Anteriores de {{ titulo }}">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
                                     stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7"/></svg>
                            </button>
                            <button type="button" class="o_dcasa_carril_flecha" data-carril="1"
                                    t-attf-aria-label="Más de {{ titulo }}">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
                                     stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7"/></svg>
                            </button>
                        </div>
                        <a t-att-href="enlace" class="o_dcasa_link">Ver todo<span class="visually-hidden">: <t t-out="titulo"/></span> <span aria-hidden="true">→</span></a>
                    </div>
                </div>
                <div class="o_dcasa_rail_track" role="list" data-anim-cascada="">
                    <div t-foreach="items" t-as="item" class="o_dcasa_rail_item" role="listitem">
                        <t t-call="website_dcasa.tarjeta_producto"/>
                    </div>
                </div>
                <div class="o_dcasa_carril_avance" aria-hidden="true" hidden=""><span/></div>
            </div>
        </section>
    </template>

    <!-- Hero en carrusel (pedido de la dueña, 2026-11-16: «algo dinámico, interactivo, que cambie», con fotos propias).
         Los productos y su orden se eligen en Sitio web › Carrusel de la portada (models/portada.py); sin productos no
         se llama y queda el hero de siempre. Las fotos del catálogo son de estudio (fondo claro): el texto no va encima
         de ellas sino sobre el negro del hero, y la foto va entera, sin velo, en su marco. El titular y los botones no
         cambian; lo que cambia en cada diapositiva es la foto, el nombre del producto y el enlace a su ficha.
         Sin JavaScript se ve la primera diapositiva; static/src/js/portada.js enciende los controles, el avance
         automático (lento, se detiene con el puntero, el foco o el botón de pausa) y el deslizar con el dedo. Con
         movimiento reducido no avanza solo. La primera foto es la imagen LCP: «eager», prioridad alta y precargada
         desde la cabecera (layout_templates.xml, layout_precarga_hero). -->
    <template id="hero_carrusel" name="D'CASA: hero en carrusel">
        <t t-set="dcasa_total" t-value="len(dcasa_vitrina)"/>
        <section class="o_dcasa_hero o_dcasa_hero_vitrina" aria-labelledby="dcasa-hero-titulo">
            <div class="o_dcasa_container o_dcasa_vitrina_grid">
                <div class="o_dcasa_hero_texto" data-anim-entrada="">
                    <p class="o_dcasa_kicker o_dcasa_kicker_light">Mueblería en La Chorrera · Entregas en Panamá Oeste, Panamá y Colón</p>
                    <h1 id="dcasa-hero-titulo" class="o_dcasa_display">Tu casa, bien amueblada.</h1>
                    <p class="o_dcasa_hero_sub">Salas, recámaras, colchones y zapateras con precios claros.
                        Muchos vienen en caja: te los llevas hoy mismo.</p>
                    <div class="o_dcasa_ctas">
                        <a href="/shop" class="btn btn-lg o_dcasa_btn_amarillo">Ver el catálogo</a>
                        <a href="/whatsapp" class="btn btn-lg o_dcasa_btn_linea" target="_blank" rel="noopener nofollow">
                            <i class="fa fa-whatsapp me-2" aria-hidden="true"/>Escríbenos por WhatsApp <span class="visually-hidden">(se abre en una pestaña nueva)</span>
                        </a>
                    </div>
                </div>

                <div class="o_dcasa_vitrina" role="region" aria-roledescription="carrusel"
                     aria-label="Productos de D'CASA" t-att-data-total="dcasa_total">
                    <!-- Las fotos (enlazan a la ficha con el ratón; para el lector de pantalla y el teclado el enlace es
                         «Ver detalles», debajo). -->
                    <div class="o_dcasa_vitrina_fotos">
                        <a t-foreach="dcasa_vitrina" t-as="diapo" t-att-href="diapo['url']" tabindex="-1" aria-hidden="true"
                           t-attf-class="o_dcasa_vitrina_foto {{ 'is-activa' if diapo_first else '' }}">
                            <picture>
                                <source t-if="diapo['srcset']" type="image/webp" t-att-srcset="diapo['srcset']"
                                        t-att-sizes="diapo['sizes']"/>
                                <img t-att-src="diapo['src']" t-att-alt="diapo['nombre']" width="1200" height="1600"
                                     t-att-srcset="diapo['srcset_respaldo']" t-att-sizes="diapo['sizes']"
                                     t-att-loading="'eager' if diapo_first else 'lazy'"
                                     t-att-fetchpriority="'high' if diapo_first else 'low'"
                                     t-att-decoding="None if diapo_first else 'async'"/>
                            </picture>
                        </a>
                    </div>
                    <!-- Controles: nacen escondidos y solo los enciende portada.js si hay más de una diapositiva. Van
                         entre la foto y el nombre, a la derecha: abajo a la derecha flota el chat de la tienda. -->
                    <div t-if="dcasa_total &gt; 1" class="o_dcasa_vitrina_barras" hidden="">
                        <button t-foreach="dcasa_vitrina" t-as="diapo" type="button" class="o_dcasa_vitrina_barra"
                                t-att-data-ir="diapo_index" t-att-aria-current="'true' if diapo_first else None"
                                t-attf-aria-label="Ver {{ diapo_index + 1 }} de {{ dcasa_total }}: {{ diapo['nombre'] }}">
                            <span/>
                        </button>
                    </div>
                    <div t-if="dcasa_total &gt; 1" class="o_dcasa_vitrina_botones" hidden="">
                        <button type="button" class="o_dcasa_vitrina_boton o_dcasa_vitrina_pausa" aria-pressed="false"
                                aria-label="Pausar el carrusel">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="o_dcasa_vitrina_ico_pausa">
                                <path d="M8 5v14M16 5v14"/></svg>
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="o_dcasa_vitrina_ico_seguir">
                                <path d="M8 5l11 7-11 7z"/></svg>
                        </button>
                        <button type="button" class="o_dcasa_vitrina_boton" data-paso="-1" aria-label="Producto anterior">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7"/></svg>
                        </button>
                        <button type="button" class="o_dcasa_vitrina_boton" data-paso="1" aria-label="Producto siguiente">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7"/></svg>
                        </button>
                    </div>
                    <!-- El nombre y el enlace de cada diapositiva. aria-live: «off» mientras avanza solo y «polite» cuando
                         quien visita la cambia (portada.js), como pide el patrón de carrusel de WAI-ARIA. -->
                    <div class="o_dcasa_vitrina_textos" aria-live="off">
                        <div t-foreach="dcasa_vitrina" t-as="diapo" role="group" aria-roledescription="diapositiva"
                             t-attf-aria-label="{{ diapo_index + 1 }} de {{ dcasa_total }}"
                             t-attf-class="o_dcasa_vitrina_texto {{ 'is-activa' if diapo_first else '' }}">
                            <p class="o_dcasa_vitrina_cual">En la foto</p>
                            <p class="o_dcasa_vitrina_nombre" t-out="diapo['nombre']"/>
                            <a t-att-href="diapo['url']" class="o_dcasa_vitrina_ver"><span class="o_dcasa_vitrina_ver_texto">Ver
                                detalles</span><span class="visually-hidden">: <t t-out="diapo['nombre']"/></span>
                                <span aria-hidden="true">→</span></a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Sección «de cine» (pedido de la dueña, 2026-11-16, en el espíritu de panaclaw.com/proyectos): grande, a media
         portada, con dos cintas de fotos del catálogo que corren solas en sentidos contrarios y un botón al catálogo.
         Las fotos salen de lo publicado por categoría (models/portada.py, website._dcasa_cine): nada escrito a mano.
         Solo CSS para el movimiento; portada.js suma el botón de pausa (WCAG 2.2.2) y la pausa al tocar. Se detiene
         con el puntero encima o con el foco; con movimiento reducido no se mueve (una fila que se desliza). -->
    <template id="seccion_cine" name="D'CASA: sección de cine">
        <t t-set="cine" t-value="website._dcasa_cine()"/>
        <section t-if="cine" class="o_dcasa_cine" aria-labelledby="dcasa-cine-titulo">
            <div class="o_dcasa_cine_inner">
                <div class="o_dcasa_cine_texto" data-anim-cascada="izquierda">
                    <p class="o_dcasa_kicker o_dcasa_kicker_light">Catálogo D'CASA</p>
                    <h2 id="dcasa-cine-titulo" class="o_dcasa_h2 o_dcasa_cine_titulo" data-titular="">Date una vuelta por la tienda</h2>
                    <p class="o_dcasa_cine_lead">Camas, colchones, salas, zapateras y más: míralo todo con su precio en el catálogo.</p>
                    <div class="o_dcasa_ctas">
                        <a href="/shop" class="btn btn-lg o_dcasa_btn_amarillo">Ver el catálogo</a>
                    </div>
                    <button type="button" class="o_dcasa_cine_pausa" aria-pressed="false" hidden="">
                        <i class="fa fa-pause" aria-hidden="true"/><span>Pausar las fotos</span>
                    </button>
                </div>
                <div class="o_dcasa_cine_cintas" data-anim="">
                    <div t-foreach="cine['cintas']" t-as="cinta"
                         t-attf-class="o_dcasa_cine_cinta {{ 'is-reversa' if cinta['reversa'] else '' }}"
                         t-attf-style="--vuelta: {{ cinta['duracion'] }}">
                        <ul class="o_dcasa_cine_tren" role="list">
                            <t t-foreach="range(cinta['copias'])" t-as="copia">
                                <li t-foreach="cinta['fotos']" t-as="foto" class="o_dcasa_cine_foto"
                                    t-att-aria-hidden="'true' if copia else None">
                                    <!-- Solo la foto y su categoría, como un fotograma; el nombre lo dicen el lector de
                                         pantalla y el globo del ratón (la cinta se detiene con el puntero encima). -->
                                    <a t-att-href="foto['producto'].website_url" t-att-title="foto['nombre']"
                                       t-att-tabindex="-1 if copia else None">
                                        <span class="o_dcasa_cine_marco">
                                            <picture>
                                                <t t-set="dcasa_webp" t-value="website._dcasa_img_srcset(foto['producto'], (256, 512))"/>
                                                <source t-if="dcasa_webp" type="image/webp" t-att-srcset="dcasa_webp"
                                                        sizes="(min-width: 992px) 13rem, 9.5rem"/>
                                                <img t-att-src="website.image_url(foto['producto'], 'image_512')" alt=""
                                                     width="512" height="683" loading="lazy" decoding="async"
                                                     sizes="(min-width: 992px) 13rem, 9.5rem"/>
                                            </picture>
                                            <span class="o_dcasa_cine_cat" t-out="foto['categoria']"/>
                                        </span>
                                        <span class="visually-hidden">: <t t-out="foto['nombre']"/></span>
                                    </a>
                                </li>
                            </t>
                        </ul>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <!-- Secciones dinámicas de la portada: plantillas propias (t-call) y no en línea, para que
         una actualización del módulo llegue aunque la portada ya se haya editado en el constructor. -->
    <template id="seccion_categorias" name="D'CASA: compra por espacio">
        <!-- Black Weekend va justo antes (y antes de los carruseles). Se llama desde aquí y no
             desde la portada: una portada ya editada en el constructor es una copia que no
             recibiría un t-call nuevo; esta plantilla, sí. Solo sale con la campaña activa. -->
        <t t-call="website_dcasa.seccion_black_weekend"/>
        <section class="o_dcasa_section o_dcasa_categorias" aria-labelledby="dcasa-cat-titulo">
            <div class="o_dcasa_container">
                <div class="o_dcasa_section_head">
                    <div data-anim-cascada="izquierda">
                        <p class="o_dcasa_kicker">Compra por espacio</p>
                        <h2 id="dcasa-cat-titulo" class="o_dcasa_h2" data-titular="">¿Qué le hace falta a tu casa?</h2>
                    </div>
                    <a href="/shop" class="o_dcasa_link">Ver todo el catálogo <span aria-hidden="true">→</span></a>
                </div>
                <div class="o_dcasa_cat_grid" data-anim-cascada="">
                    <!-- Sin nada publicado, la tarjeta abre WhatsApp (website._dcasa_categorias). -->
                    <a t-foreach="website._dcasa_categorias()" t-as="cat" t-att-href="cat['url']" class="o_dcasa_cat"
                       t-att-target="cat['whatsapp'] and '_blank' or None"
                       t-att-rel="cat['whatsapp'] and 'noopener' or None"
                       t-att-aria-label="cat['whatsapp'] and ('%s: pregúntanos por WhatsApp' % cat['nombre']) or None">
                        <span class="o_dcasa_cat_foto">
                            <img t-att-src="cat['imagen']" t-att-alt="cat['alt']" width="800" height="1000"
                                 t-att-srcset="'%s 400w, %s 800w' % (cat['imagen_chica'], cat['imagen'])"
                                 sizes="(min-width: 992px) 15vw, 31vw" loading="lazy" decoding="async"/>
                        </span>
                        <!-- Debajo de la foto: el nombre y cuántos productos hay publicados (dato real del catálogo). -->
                        <span class="o_dcasa_cat_label"><t t-out="cat['nombre']"/> <span aria-hidden="true">→</span>
                            <span t-if="cat['whatsapp']" class="o_dcasa_cat_nota">Pregúntanos por WhatsApp</span>
                            <span t-elif="cat.get('cantidad')" class="o_dcasa_cat_nota"><t t-out="cat['cantidad']"/>
                                <t t-if="cat['cantidad'] == 1">producto</t><t t-else="">productos</t></span></span>
                    </a>
                </div>
            </div>
        </section>
    </template>

    <template id="seccion_socios" name="D'CASA: banda de socios">
        <!-- La sección «de cine» va justo antes, a media portada. Se llama desde aquí y no desde la portada: una portada
             ya editada en el constructor es una copia que no recibiría un t-call nuevo; esta plantilla, sí. -->
        <t t-call="website_dcasa.seccion_cine"/>
        <t t-set="reglas" t-value="website._dcasa_reglas_socios()"/>
        <section class="o_dcasa_socios_band" aria-labelledby="dcasa-socios-titulo">
            <div class="o_dcasa_container o_dcasa_split_grid">
                <div class="o_dcasa_socios_band_text" data-anim-cascada="izquierda">
                    <p class="o_dcasa_kicker o_dcasa_kicker_light">Socios D'CASA</p>
                    <h2 id="dcasa-socios-titulo" class="o_dcasa_h2" data-titular="">Suma puntos y gana invitando</h2>
                    <ul class="o_dcasa_socios_facts" role="list">
                        <t t-set="por_dolar" t-value="reglas['acumulacion'].get('puntosPorDolar')"/>
                        <t t-set="al_padrino" t-value="reglas['referido'].get('puntosAlPadrino')"/>
                        <t t-set="al_ahijado" t-value="reglas['referido'].get('puntosAlAhijado')"/>
                        <li t-if="por_dolar"><strong t-out="por_dolar"/> <t t-if="por_dolar == 1">punto</t><t t-else="">puntos</t> por cada dólar que pagas.</li>
                        <li t-if="al_padrino and al_ahijado"><strong t-out="'{:,}'.format(al_padrino)"/> puntos por cada amigo que
                            invitas y compra; tu amigo gana <strong t-out="'{:,}'.format(al_ahijado)"/>.</li>
                        <li>Cámbialos por descuentos y premios en la tienda.</li>
                    </ul>
                    <div class="o_dcasa_ctas">
                        <a href="/socios" class="btn btn-lg o_dcasa_btn_amarillo">Ver mis puntos</a>
                        <a href="/socios/terminos" class="btn btn-lg o_dcasa_btn_linea">Cómo funciona</a>
                    </div>
                </div>
                <div class="o_dcasa_socios_band_media" data-anim="escala">
                    <img src="/website_dcasa/static/src/img/split-socios.webp" width="800" height="600"
                         loading="lazy" decoding="async" alt="Silla de ratán junto a una ventana con plantas"/>
                </div>
            </div>
        </section>
    </template>

    <!-- Portada: una franja corta que lleva a la página «Visítanos» (el mapa vive allá). Antes, una sección pequeña
         de contacto (pedido de la dueña, 2026-11-15: sin «Escríbenos» en el menú, «un CTA pequeño que invite a
         escribirnos al WhatsApp o al correo»). Va aquí y no en la portada: esta plantilla llega aunque la portada se haya
         editado en el constructor. -->
    <template id="seccion_visitanos" name="D'CASA: visítanos (franja)">
        <t t-set="correo_tienda" t-value="website.company_id.email or 'info@dcasapty.com'"/>
        <section class="o_dcasa_contacto_cta" aria-labelledby="dcasa-contacto-titulo">
            <div class="o_dcasa_container o_dcasa_contacto_cta_inner">
                <div>
                    <h2 id="dcasa-contacto-titulo" class="o_dcasa_contacto_cta_titulo">¿Te quedó alguna duda?</h2>
                    <p class="o_dcasa_contacto_cta_texto">Escríbenos y te ayudamos a escoger.</p>
                </div>
                <div class="o_dcasa_contacto_cta_botones">
                    <a href="/whatsapp" class="btn btn-primary" target="_blank" rel="noopener nofollow">
                        <i class="fa fa-whatsapp me-2" aria-hidden="true"/>Escríbenos por WhatsApp<span class="visually-hidden"> (se abre en una pestaña nueva)</span></a>
