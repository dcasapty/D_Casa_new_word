<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reglas de la comisión del sitio web: una versión por cambio. Guardada, no se edita. -->
    <record id="reglas_list" model="ir.ui.view">
        <field name="name">dcasa.web.reglas.list</field>
        <field name="model">dcasa.web.reglas</field>
        <field name="arch" type="xml">
            <list string="Reglas de la comisión del sitio web" create="0" delete="0"
                  decoration-success="estado == 'vigente'" decoration-muted="estado in ('anterior', 'tapada', 'anulada')">
                <header>
                    <button name="action_nueva_version" type="object" string="Nueva versión" class="btn-primary"
                            display="always"/>
                </header>
                <field name="numero"/>
                <field name="rige_desde"/>
                <field name="porcentaje"/>
                <field name="tarifa_fija"/>
                <field name="tarifa_periodo" optional="hide"/>
                <field name="motivo"/>
                <field name="autor" optional="show"/>
                <field name="estado" widget="badge" decoration-success="estado == 'vigente'"
                       decoration-info="estado == 'programada'" decoration-warning="estado == 'tapada'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="reglas_form" model="ir.ui.view">
        <field name="name">dcasa.web.reglas.form</field>
        <field name="model">dcasa.web.reglas</field>
        <field name="arch" type="xml">
            <form string="Reglas de la comisión del sitio web" delete="0" js_class="dcasa_reglas_form">
                <header>
                    <button name="action_anular" type="object" string="Anular esta versión"
                            invisible="not id or estado not in ('programada', 'tapada')"
                            confirm="Una versión anulada no rige nunca y no se puede deshacer. ¿Anularla?"/>
                    <field name="estado" widget="statusbar" invisible="not id"
                           statusbar_visible="programada,tapada,vigente,anterior"/>
                </header>
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <div class="alert alert-info" role="alert" invisible="id">
                        <strong>Esto es una versión nueva de las reglas.</strong> No se guarda sola: toca «Guardar»
                        cuando esté lista (si sales sin guardar, se descarta). Cuando la guardes ya no se edita: si
                        algo cambia, se guarda otra versión. Rige desde la fecha que pongas y <strong>solo hacia
                        adelante</strong>: lo que ya se anotó no se recalcula. Desde el día de la primera versión, una
                        venta del sitio deja de contar para las vendedoras.
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="not id or estado in ('programada', 'tapada')">
                        Esta versión ya está guardada y no se edita. Para cambiar algo, usa «Nueva versión».
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not id or estado != 'programada'">
                        Esta versión todavía no rige. Si se puso mal (por ejemplo, con el año equivocado), escribe el
                        motivo y anúlala: no se borra, pero deja de contar y se puede guardar una nueva.
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="not id or estado != 'tapada'">
                        <field name="aviso_tapada" readonly="1" nolabel="1"/>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not aviso_tapa">
                        <field name="aviso_tapa" readonly="1" nolabel="1"/>
                    </div>
                    <field name="tapada_por_id" invisible="1"/>
                    <field name="tapa_a_ids" invisible="1"/>
                    <group string="Cuánto y desde cuándo">
                        <field name="numero" invisible="not id"/>
                        <field name="rige_desde" readonly="id"/>
                        <field name="porcentaje" readonly="id"/>
                        <field name="tarifa_fija" readonly="id"/>
                        <field name="tarifa_periodo" readonly="id"/>
                        <field name="tope_ajuste" readonly="id"/>
                        <field name="motivo" readonly="id"/>
                        <field name="autor" invisible="not id"/>
                        <field name="motivo_anulacion"
                               invisible="not id or estado not in ('programada', 'tapada', 'anulada')"
                               readonly="estado == 'anulada'"/>
                    </group>
                    <group string="¿Sobre qué se calcula el porcentaje?">
                        <field name="base_itbms" readonly="id"/>
                        <field name="base_envio" readonly="id"/>
                        <field name="base_descuentos" readonly="id"/>
                        <field name="base_devoluciones" readonly="id"/>
                        <field name="base_pasarela" readonly="id"/>
                    </group>
                    <group string="Cómo se ve con tus interruptores">
                        <field name="ejemplo_html" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Quiénes reciben (empleados de Nómina) · lo que le toca a cada quien suma 100 %">
                        <field name="reparto_ids" nolabel="1" colspan="2" readonly="id">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="empleado_id" options="{'no_create': True}"/>
                                <field name="porcentaje" sum="Total"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="accion_reglas" model="ir.actions.act_window">
        <field name="name">Reglas de la comisión</field>
        <field name="res_model">dcasa.web.reglas</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Todavía no hay reglas de la comisión del sitio web.</p>
            <p>Mientras no haya una versión, el sistema solo mide las ventas por internet y no calcula ninguna comisión.
               Toca «Nueva versión» para escribir el porcentaje, la tarifa fija y quiénes reciben.</p>
        </field>
    </record>

    <record id="accion_reglas_nueva" model="ir.actions.act_window">
        <field name="name">Nueva versión de las reglas</field>
        <field name="res_model">dcasa.web.reglas</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="reglas_form"/>
        <field name="target">current</field>
    </record>

    <!-- Quiénes reciben: la lista de la versión que rige hoy, con lo que se le debe a cada quien -->
    <record id="reparto_list" model="ir.ui.view">
        <field name="name">dcasa.web.reparto.list</field>
        <field name="model">dcasa.web.reparto</field>
        <field name="arch" type="xml">
            <list string="Quiénes reciben" create="0" delete="0" edit="0">
                <header>
                    <button name="action_cambiar_quienes_reciben" type="object" string="Cambiar quiénes reciben"
                            class="btn-primary" display="always"/>
                </header>
                <field name="empleado_id"/>
                <field name="porcentaje" sum="Total"/>
                <field name="por_pagar_comision" string="Debe (ventas)" sum="Debe"/>
                <field name="por_pagar_tarifa" string="Debe (tarifa)" sum="Debe"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="accion_reparto" model="ir.actions.act_window">
        <field name="name">Quiénes reciben</field>
        <field name="res_model">dcasa.web.reparto</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Todavía no hay nadie en la lista.</p>
            <p>La lista sale de la versión de las reglas que rige hoy. Se eligen entre los empleados de Nómina.</p>
        </field>
    </record>

    <record id="accion_quienes_reciben" model="ir.actions.server">
        <field name="name">Quiénes reciben</field>
        <field name="model_id" ref="model_dcasa_web_reparto"/>
        <field name="state">code</field>
        <field name="code">action = model._accion_quienes_reciben()</field>
        <field name="group_ids" eval="[(4, ref('dcasa_nomina.group_nomina'))]"/>
    </record>
</odoo>
