<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="carga_form" model="ir.ui.view">
        <field name="name">dcasa.migracion.carga.form</field>
        <field name="model">dcasa.migracion.carga</field>
        <field name="arch" type="xml">
            <form string="Cargar datos del sistema anterior" create="0" delete="0">
                <div class="alert alert-warning" role="alert">
                    <b>Se hace una sola vez, el día del corte.</b>
                    Sube los archivos que dejó la receta de migración, pulsa <b>Revisar</b> (no cambia nada y te muestra
                    qué pasaría) y, si todo se ve bien, pulsa <b>Cargar</b>. Volver a cargar el mismo archivo no repite
                    nada. Las existencias se reemplazan por las del archivo: carga el inventario antes de empezar a
                    vender. Es mejor hacerlo por pasadas: primero clientes y proveedores, después productos con sus
                    existencias, luego los precios de proveedor y al final las ventas y compras pendientes.
                </div>
                <group string="Clientes y proveedores">
                    <field name="archivo_clientes" filename="nombre_clientes" widget="binary" string="clientes.csv"/>
                    <field name="nombre_clientes" invisible="1"/>
                    <field name="archivo_proveedores" filename="nombre_proveedores" widget="binary"
                           string="proveedores.csv"/>
                    <field name="nombre_proveedores" invisible="1"/>
                </group>
                <group string="Productos y existencias">
                    <field name="archivo_productos" filename="nombre_productos" widget="binary" string="productos.csv"/>
                    <field name="nombre_productos" invisible="1"/>
                    <field name="archivo_inventario" filename="nombre_inventario" widget="binary"
                           string="inventario.csv"/>
                    <field name="nombre_inventario" invisible="1"/>
                    <field name="actualizar_precios"/>
                </group>
                <group string="Precios de proveedor (después de cargar proveedores y productos)">
                    <field name="archivo_precios" filename="nombre_precios" widget="binary"
                           string="precios_proveedor.csv"/>
                    <field name="nombre_precios" invisible="1"/>
                </group>
                <group string="Ventas y compras pendientes (después de cargar contactos y productos)">
                    <field name="archivo_ventas" filename="nombre_ventas" widget="binary"
                           string="ventas_pendientes.csv"/>
                    <field name="nombre_ventas" invisible="1"/>
                    <field name="archivo_ventas_lineas" filename="nombre_ventas_lineas" widget="binary"
                           string="ventas_pendientes_lineas.csv"/>
                    <field name="nombre_ventas_lineas" invisible="1"/>
                    <field name="archivo_compras" filename="nombre_compras" widget="binary"
                           string="compras_pendientes.csv"/>
                    <field name="nombre_compras" invisible="1"/>
                    <field name="archivo_compras_lineas" filename="nombre_compras_lineas" widget="binary"
                           string="compras_pendientes_lineas.csv"/>
                    <field name="nombre_compras_lineas" invisible="1"/>
                </group>
                <field name="huella_revisada" invisible="1"/>
                <field name="informe" invisible="not informe" nolabel="1"/>
                <footer>
                    <button name="action_revisar" type="object" string="Revisar (no cambia nada)" class="btn-primary"
                            data-hotkey="q"/>
                    <button name="action_cargar" type="object" string="Cargar" class="btn-secondary"
                            invisible="not huella_revisada" confirm="¿Cargar de verdad? Esto cambia los datos de este sistema."
                            data-hotkey="w"/>
                    <button string="Cerrar" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="accion_carga" model="ir.actions.act_window">
        <field name="name">Cargar datos del sistema anterior</field>
        <field name="res_model">dcasa.migracion.carga</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_carga" name="Cargar datos del sistema anterior" parent="base.menu_administration"
              action="accion_carga" sequence="95" groups="base.group_system"/>
</odoo>
