<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- La calculadora (OWL: static/src/js/calculadora.js), para todo el equipo. -->
    <record id="accion_calculadora" model="ir.actions.client">
        <field name="name">Calculadora de envíos</field>
        <field name="tag">dcasa_envios.calculadora</field>
        <field name="path">envios</field>
    </record>

    <!-- El menú «Envíos» ya existe (dcasa_contabilidad) con un «En desarrollo»: lo apagamos y ponemos lo de verdad.
         Al desinstalar este módulo, el uninstall_hook lo vuelve a encender. -->
    <record id="dcasa_contabilidad.menu_envios_en_desarrollo" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <menuitem id="menu_envios_calculadora" name="Calculadora" parent="dcasa_contabilidad.menu_envios_root"
              action="accion_calculadora" sequence="1" groups="base.group_user"/>
    <menuitem id="menu_envios_lugares" name="Lugares" parent="dcasa_contabilidad.menu_envios_root"
              action="accion_lugares" sequence="2" groups="base.group_user"/>
    <menuitem id="menu_envios_tarifa" name="Tarifa" parent="dcasa_contabilidad.menu_envios_root"
              action="accion_tarifa" sequence="3" groups="dcasa_base.group_gerencia,base.group_system"/>
</odoo>
