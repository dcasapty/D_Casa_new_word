<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- «Stock y precios»: ver y ordenar los productos por stock, precio y categoría para elegir qué empujar en una
         campaña (models/producto_stock.py). Solo lectura. -->

    <record id="view_dcasa_producto_stock_list" model="ir.ui.view">
        <field name="name">dcasa.producto.stock.list</field>
        <field name="model">dcasa.producto.stock</field>
        <field name="arch" type="xml">
            <list string="Stock y precios" create="0" edit="0" delete="0" export_xlsx="1"
                  decoration-danger="estado_stock == 'agotado'" decoration-warning="estado_stock == 'pocas'"
                  decoration-muted="estado_stock == 'sin_control'">
                <field name="image_128" widget="image" options="{'size': [40, 40]}" string="Foto"/>
                <field name="product_id"/>
                <field name="default_code" optional="show"/>
                <field name="categ_id" optional="show"/>
                <field name="categoria_web_id" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="precio" widget="monetary"/>
                <field name="stock" sum="Total"/>
                <field name="reservado" optional="hide" sum="Total"/>
                <field name="disponible" optional="show" sum="Total"/>
                <field name="estado_stock" widget="badge"
                       decoration-danger="estado_stock == 'agotado'" decoration-warning="estado_stock == 'pocas'"
                       decoration-success="estado_stock == 'disponible'"/>
                <field name="vendidas_30d" optional="show"/>
                <field name="valor_a_precio" widget="monetary" optional="hide" sum="Total"/>
                <field name="publicado" optional="show"/>
                <field name="en_black_weekend" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_dcasa_producto_stock_kanban" model="ir.ui.view">
        <field name="name">dcasa.producto.stock.kanban</field>
        <field name="model">dcasa.producto.stock</field>
        <field name="arch" type="xml">
            <kanban create="0" edit="0" delete="0" default_order="categ_id, product_id">
                <field name="product_tmpl_id"/>
                <field name="currency_id"/>
                <field name="stock"/>
                <field name="estado_stock"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex gap-3">
                            <div class="flex-shrink-0">
                                <img t-att-src="'/web/image/product.template/' + record.product_tmpl_id.raw_value + '/image_128'"
                                     alt="" class="rounded" width="72" height="72" style="object-fit: cover;"/>
                            </div>
                            <div class="flex-grow-1 overflow-hidden">
                                <field name="product_id" class="fw-bold d-block text-truncate"/>
                                <div class="text-muted small"><field name="default_code"/> · <field name="categ_id"/></div>
                                <div class="mt-1">
                                    <field name="precio" widget="monetary"/>
                                    <span class="text-muted">+ ITBMS</span>
                                </div>
                                <div class="mt-1 d-flex gap-2 align-items-center">
                                    <field name="estado_stock" widget="badge"
                                           decoration-danger="estado_stock == 'agotado'"
                                           decoration-warning="estado_stock == 'pocas'"
                                           decoration-success="estado_stock == 'disponible'"/>
                                    <span t-if="record.estado_stock.raw_value !== 'sin_control'" class="small">
                                        <t t-out="record.stock.value"/> en existencia
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_dcasa_producto_stock_pivot" model="ir.ui.view">
        <field name="name">dcasa.producto.stock.pivot</field>
        <field name="model">dcasa.producto.stock</field>
        <field name="arch" type="xml">
            <pivot string="Stock por categoría">
                <field name="categ_id" type="row"/>
                <field name="estado_stock" type="col"/>
                <field name="stock" type="measure"/>
                <field name="valor_a_precio" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_dcasa_producto_stock_graph" model="ir.ui.view">
        <field name="name">dcasa.producto.stock.graph</field>
        <field name="model">dcasa.producto.stock</field>
        <field name="arch" type="xml">
            <graph string="Stock por categoría" type="bar" stacked="0" order="DESC">
                <field name="categ_id"/>
                <field name="stock" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_dcasa_producto_stock_search" model="ir.ui.view">
        <field name="name">dcasa.producto.stock.search</field>
        <field name="model">dcasa.producto.stock</field>
        <field name="arch" type="xml">
            <search string="Stock y precios">
                <field name="product_id" string="Nombre o código"
                       filter_domain="['|', ('product_id', 'ilike', self), ('default_code', 'ilike', self)]"/>
                <field name="categ_id"/>
                <field name="public_categ_ids" string="Categoría de la tienda"/>
                <separator/>
                <filter string="Agotados" name="agotado" domain="[('estado_stock', '=', 'agotado')]"/>
                <filter string="Pocas unidades" name="pocas" domain="[('estado_stock', '=', 'pocas')]"/>
                <filter string="Disponibles" name="disponible" domain="[('estado_stock', '=', 'disponible')]"/>
                <filter string="Con stock" name="con_stock" domain="[('disponible', '&gt;', 0)]"/>
                <separator/>
                <filter string="Hasta $100" name="precio_1" domain="[('precio', '&lt;=', 100)]"/>
                <filter string="$100 a $300" name="precio_2" domain="[('precio', '&gt;', 100), ('precio', '&lt;=', 300)]"/>
                <filter string="$300 a $600" name="precio_3" domain="[('precio', '&gt;', 300), ('precio', '&lt;=', 600)]"/>
                <filter string="Más de $600" name="precio_4" domain="[('precio', '&gt;', 600)]"/>
                <separator/>
                <filter string="En la tienda en línea" name="publicado" domain="[('publicado', '=', True)]"/>
                <filter string="Sin publicar" name="sin_publicar" domain="[('publicado', '=', False)]"/>
                <filter string="Black Weekend" name="black_weekend" domain="[('en_black_weekend', '=', True)]"/>
                <separator/>
                <filter string="Se vendió en 30 días" name="vendido" domain="[('vendidas_30d', '&gt;', 0)]"/>
                <filter string="Con stock y sin ventas en 30 días" name="dormido"
                        domain="[('disponible', '&gt;', 0), ('vendidas_30d', '=', 0)]"/>
                <group>
                    <filter string="Categoría" name="por_categoria" context="{'group_by': 'categ_id'}"/>
                    <filter string="Categoría de la tienda" name="por_categoria_web"
                            context="{'group_by': 'categoria_web_id'}"/>
                    <filter string="Ficha (todas sus medidas)" name="por_ficha" context="{'group_by': 'product_tmpl_id'}"/>
                    <filter string="Estado del stock" name="por_estado" context="{'group_by': 'estado_stock'}"/>
                    <filter string="En la tienda en línea" name="por_publicado" context="{'group_by': 'publicado'}"/>
                </group>
                <!-- Las categorías a la izquierda, con cuántos productos tiene cada una. -->
                <searchpanel>
                    <field name="categ_id" string="Categoría" icon="fa-folder" hierarchize="1" enable_counters="1"
                           expand="1"/>
                    <field name="categoria_web_id" string="En la tienda" icon="fa-shopping-bag" hierarchize="1"
                           enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_dcasa_producto_stock" model="ir.actions.act_window">
        <field name="name">Stock y precios</field>
        <field name="res_model">dcasa.producto.stock</field>
        <field name="path">stock-y-precios</field>
        <field name="view_mode">list,kanban,pivot,graph</field>
        <field name="search_view_id" ref="view_dcasa_producto_stock_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Todavía no hay productos</p>
            <p>Aquí se ve el stock y el precio de cada producto para decidir qué empujar en una campaña.</p>
        </field>
    </record>

    <!-- Favoritos compartidos: el orden que se usa según la campaña (con un clic en «Favoritos»). «Menor stock»
         deja fuera lo agotado y lo que no controla inventario: eso no se puede empujar en una campaña. -->
    <record id="filtro_stock_mayor" model="ir.filters">
        <field name="name">Mayor stock primero</field>
        <field name="model_id">dcasa.producto.stock</field>
        <field name="action_id" ref="action_dcasa_producto_stock"/>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="sort">["stock desc"]</field>
    </record>
    <record id="filtro_stock_menor" model="ir.filters">
        <field name="name">Menor stock primero</field>
        <field name="model_id">dcasa.producto.stock</field>
        <field name="action_id" ref="action_dcasa_producto_stock"/>
        <field name="domain">[('disponible', '&gt;', 0)]</field>
        <field name="context">{}</field>
        <field name="sort">["stock asc"]</field>
    </record>
    <record id="filtro_precio_mayor" model="ir.filters">
        <field name="name">Mayor precio primero</field>
        <field name="model_id">dcasa.producto.stock</field>
        <field name="action_id" ref="action_dcasa_producto_stock"/>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="sort">["precio desc"]</field>
    </record>
    <record id="filtro_precio_menor" model="ir.filters">
        <field name="name">Menor precio primero</field>
        <field name="model_id">dcasa.producto.stock</field>
        <field name="action_id" ref="action_dcasa_producto_stock"/>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="sort">["precio asc"]</field>
    </record>

    <menuitem id="menu_dcasa_stock_y_precios" name="Stock y precios" parent="sale.sale_menu_root" sequence="2"
              action="action_dcasa_producto_stock" groups="sales_team.group_sale_salesman"/>
    <menuitem id="menu_dcasa_stock_y_precios_inventario" name="Stock y precios (campañas)"
              parent="stock.menu_warehouse_report" sequence="5" action="action_dcasa_producto_stock"
              groups="stock.group_stock_user"/>
</odoo>
