<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Copiar con un toque (pedido de la dueña, 2026-10-22; dcasa_base/static/src/js/copiar.js): el nombre del
         producto, su referencia, su código de barras y su código público, en la ficha y en las listas. En las listas,
         widget="char": la celda se ve igual, pero la pinta el componente del campo, que es el que lleva el ícono. -->
    <record id="product_template_form_copiar" model="ir.ui.view">
        <field name="name">product.template.form.dcasa.copiar</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]//field[@name='name']" position="attributes">
                <attribute name="class" add="o_dcasa_copiar" separator=" "/>
            </xpath>
        </field>
    </record>

    <record id="product_template_only_form_copiar" model="ir.ui.view">
        <field name="name">product.template.only.form.dcasa.copiar</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <field name="default_code" position="attributes">
                <attribute name="class" add="o_dcasa_copiar" separator=" "/>
            </field>
            <field name="barcode" position="attributes">
                <attribute name="class" add="o_dcasa_copiar" separator=" "/>
            </field>
        </field>
    </record>

    <record id="product_product_form_copiar" model="ir.ui.view">
        <field name="name">product.product.form.dcasa.copiar</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]//field[@name='name']" position="attributes">
                <attribute name="class" add="o_dcasa_copiar" separator=" "/>
            </xpath>
            <field name="default_code" position="attributes">
                <attribute name="class" add="o_dcasa_copiar" separator=" "/>
            </field>
            <field name="barcode" position="attributes">
                <attribute name="class" add="o_dcasa_copiar" separator=" "/>
            </field>
        </field>
    </record>

    <record id="product_template_list_copiar" model="ir.ui.view">
        <field name="name">product.template.list.dcasa.copiar</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute name="class" add="o_dcasa_copiar" separator=" "/>
                <attribute name="widget">char</attribute>
            </field>
            <field name="default_code" position="attributes">
                <attribute name="class" add="o_dcasa_copiar" separator=" "/>
                <attribute name="widget">char</attribute>
            </field>
            <field name="barcode" position="attributes">
                <attribute name="class" add="o_dcasa_copiar" separator=" "/>
                <attribute name="widget">char</attribute>
            </field>
        </field>
    </record>

    <record id="product_product_list_copiar" model="ir.ui.view">
        <field name="name">product.product.list.dcasa.copiar</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute name="class" add="o_dcasa_copiar" separator=" "/>
                <attribute name="widget">char</attribute>
            </field>
            <field name="default_code" position="attributes">
                <attribute name="class" add="o_dcasa_copiar" separator=" "/>
                <attribute name="widget">char</attribute>
            </field>
            <field name="barcode" position="attributes">
                <attribute name="class" add="o_dcasa_copiar" separator=" "/>
                <attribute name="widget">char</attribute>
            </field>
        </field>
    </record>
</odoo>
