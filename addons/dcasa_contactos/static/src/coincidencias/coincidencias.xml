<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dcasa_contactos.Coincidencias">
        <div t-if="lista.length" class="alert mb-0 o_dcasa_coincidencias"
             t-att-class="hayFuertes ? 'alert-warning' : 'alert-info'" role="alert">
            <div class="fw-bold mb-1">
                <i class="fa fa-users me-2" aria-hidden="true"/>
                <t t-if="hayFuertes">Ya existe esta persona: usa su ficha en vez de crear otra.</t>
                <t t-else="">¿Es alguna de estas personas? Si es, usa su ficha en vez de crear otra.</t>
            </div>
            <div class="o_dcasa_coincidencias_lista">
                <div t-foreach="lista" t-as="c" t-key="c.id" class="o_dcasa_coincidencia">
                    <div class="o_dcasa_coincidencia_datos">
                        <div>
                            <span class="fw-bold" t-esc="c.nombre"/>
                            <span t-if="c.archivada" class="badge text-bg-secondary ms-1">archivada</span>
                        </div>
                        <div class="small">
                            <t t-foreach="c.datos" t-as="d" t-key="d_index">
                                <span class="me-3 o_dcasa_dato"><t t-esc="d[0]"/>: <span class="fw-semibold" t-esc="d[1]"/></span>
                            </t>
                        </div>
                        <div class="small text-muted">
                            Coincide <t t-esc="c.por.join(' y ')"/><t t-if="c.origen">. <t t-esc="c.origen"/></t>.
                        </div>
                    </div>
                    <button type="button" class="btn btn-primary btn-sm o_dcasa_es_esta_persona" t-on-click="() => this.usar(c)">
                        Es esta persona
                    </button>
                </div>
            </div>
        </div>
    </t>
</templates>
