<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="duplicado_list" model="ir.ui.view">
        <field name="name">dcasa.contacto.duplicado.list</field>
        <field name="model">dcasa.contacto.duplicado</field>
        <field name="arch" type="xml">
            <list string="Posibles duplicados" create="0" delete="0" edit="0">
                <field name="tipo"/>
                <field name="valor"/>
                <field name="cantidad"/>
                <field name="nombres"/>
                <button name="action_ver" type="object" string="Ver las fichas" icon="fa-eye"/>
                <button name="action_fusionar" type="object" string="Fusionar" icon="fa-compress"/>
            </list>
        </field>
    </record>

    <record id="duplicado_search" model="ir.ui.view">
        <field name="name">dcasa.contacto.duplicado.search</field>
        <field name="model">dcasa.contacto.duplicado</field>
        <field name="arch" type="xml">
            <search>
                <field name="valor"/>
                <field name="nombres"/>
                <filter name="celular" string="Celular" domain="[('tipo', '=', 'celular')]"/>
                <filter name="correo" string="Correo" domain="[('tipo', '=', 'correo')]"/>
                <filter name="ruc" string="RUC o cédula" domain="[('tipo', '=', 'ruc')]"/>
            </search>
        </field>
    </record>

    <record id="accion_duplicados" model="ir.actions.act_window">
        <field name="name">Posibles duplicados</field>
        <field name="res_model">dcasa.contacto.duplicado</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay fichas repetidas</p>
            <p>Cada celular, correo o RUC/cédula tiene una sola ficha.</p>
        </field>
    </record>

    <menuitem id="menu_duplicados" name="Posibles duplicados" parent="dcasa_socios.menu_dcasa_config"
              action="accion_duplicados" sequence="30" groups="sales_team.group_sale_manager"/>

    <!-- Celular y correo obligatorios (2026-10-16): los clientes viejos a los que les falta alguno, para completarlos
         antes de su próxima venta (sin ellos no se confirma ni le llega su factura). -->
    <record id="accion_clientes_sin_contacto" model="ir.actions.act_window">
        <field name="name">Clientes sin correo o sin celular</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('customer_rank', '>', 0), ('parent_id', '=', False), '|', '&amp;', ('email', '=', False), ('dcasa_sin_correo', '=', False), ('phone', '=', False)]</field>
        <field name="context">{'res_partner_search_mode': 'customer'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Todos los clientes tienen celular y correo</p>
            <p>Sin ellos no se puede confirmar una venta ni le llega su factura al cliente.</p>
        </field>
    </record>

    <menuitem id="menu_clientes_sin_contacto" name="Clientes sin correo o sin celular"
              parent="dcasa_socios.menu_dcasa_config" action="accion_clientes_sin_contacto" sequence="31"
              groups="sales_team.group_sale_manager"/>
</odoo>
