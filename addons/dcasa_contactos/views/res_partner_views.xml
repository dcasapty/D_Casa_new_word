<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Celular y correo bien escritos y obligatorios (pedido de la dueña, 2026-10-16).
         «Cliente no tiene correo electrónico» (2026-10-17): la marca cualquiera del equipo, justo debajo del correo, y
         solo se ve mientras el correo está vacío (si se escribe un correo, se desmarca sola).
         Obligatorios solo al CREAR una persona como cliente: una ficha vieja se sigue editando y guardando (la nube)
         aunque le falte algo; la venta y la factura lo piden después. -->
    <record id="view_partner_form_contacto_obligatorio" model="ir.ui.view">
        <field name="name">res.partner.form.dcasa.contacto.obligatorio</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0 o_dcasa_falta_contacto" role="alert"
                     invisible="not id or parent_id or customer_rank &lt;= 0 or (phone and (email or dcasa_sin_correo))">
                    <i class="fa fa-address-card-o me-2" aria-hidden="true"/>
                    Falta <span invisible="phone">el celular</span><span invisible="phone or email or dcasa_sin_correo"> y </span><span invisible="email or dcasa_sin_correo">el correo</span>:
                    sin eso no se puede confirmar una venta ni le llega su factura.
                </div>
            </xpath>
            <xpath expr="//div[hasclass('mb8')]//field[@name='email']" position="attributes">
                <attribute name="required">user_ids or (not id and not parent_id and not is_company and context.get('res_partner_search_mode') == 'customer' and not dcasa_sin_correo)</attribute>
                <attribute name="placeholder">Correo, p. ej. nombre@gmail.com</attribute>
            </xpath>
            <xpath expr="//div[hasclass('mb8')]//field[@name='email']/.." position="after">
                <div class="d-flex align-items-baseline w-md-50 o_dcasa_sin_correo"
                     invisible="parent_id or (email and not dcasa_sin_correo) or context.get('res_partner_search_mode') == 'supplier'">
                    <field name="dcasa_sin_correo" nolabel="1" class="w-auto me-2"/>
                    <label for="dcasa_sin_correo" class="fw-normal"/>
                </div>
            </xpath>
            <xpath expr="//div[hasclass('mb8')]//field[@name='phone']" position="attributes">
                <attribute name="required">not id and not parent_id and not is_company and context.get('res_partner_search_mode') == 'customer'</attribute>
                <attribute name="placeholder">Celular, p. ej. 6123-4567 (de otro país, con +)</attribute>
            </xpath>
        </field>
    </record>
</odoo>
