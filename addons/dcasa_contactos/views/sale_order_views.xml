<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Celular y correo obligatorios (pedido de la dueña, 2026-10-16): el aviso amarillo adelanta lo que la venta pide
         para confirmarse; la cotización se sigue guardando (la nube) aunque falte algo. Sin «Crear» rápido en el
         cliente: una ficha nueva se crea con «Crear y editar», donde se escriben su celular y su correo.
         «Cliente no tiene correo electrónico» (2026-10-17): junto al cliente, solo mientras no tiene un correo que
         sirva; se guarda en su ficha al guardar la cotización. -->
    <record id="sale_order_form_falta_contacto" model="ir.ui.view">
        <field name="name">sale.order.form.dcasa.falta.contacto</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0 o_dcasa_falta_contacto" role="alert"
                     invisible="not dcasa_falta_contacto or state not in ('draft', 'sent')">
                    <i class="fa fa-address-card-o me-2" aria-hidden="true"/>
                    Al cliente le falta <field name="dcasa_falta_contacto" readonly="1" class="fw-bold"/> (o está mal
                    escrito): escríbelo aquí abajo, en sus datos, antes de confirmar. Ahí le llegan su factura y cómo
                    ver sus puntos.
                    <span invisible="dcasa_cliente_tiene_correo">Si de verdad no tiene correo, marca «Cliente no tiene
                    correo electrónico» aquí abajo.</span>
                </div>
            </xpath>
            <xpath expr="//group[@name='partner_details']/field[@name='partner_id']" position="attributes">
                <attribute name="options">{'no_quick_create': True}</attribute>
            </xpath>
            <xpath expr="//group[@name='partner_details']/field[@name='partner_id']" position="after">
                <field name="dcasa_cliente_tiene_correo" invisible="1"/>
                <!-- Los datos del cliente, corregibles aquí mismo (2026-11-04): al guardar, lo que cambió se guarda en su
                     ficha. No los de alguien del equipo; la cédula de un contacto de una empresa solo se ve. -->
                <field name="dcasa_cliente_corregible" invisible="1"/>
                <field name="dcasa_cliente_es_contacto" invisible="1"/>
                <div colspan="2" class="text-muted small o_dcasa_datos_cliente_nota" invisible="not partner_id">
                    Sus datos: si algo está mal, corrígelo aquí y se guarda en su ficha.
                </div>
                <field name="dcasa_cliente_nombre" class="o_dcasa_dato_cliente" string="Nombre" invisible="not partner_id"
                       required="partner_id and dcasa_cliente_corregible"
                       readonly="state == 'cancel' or not dcasa_cliente_corregible" placeholder="Nombre y apellido"/>
                <field name="dcasa_cliente_celular" class="o_dcasa_dato_cliente" string="Celular" widget="phone"
                       invisible="not partner_id" readonly="state == 'cancel' or not dcasa_cliente_corregible"
                       placeholder="Celular, p. ej. 6123-4567 (de otro país, con +)"/>
                <field name="dcasa_cliente_fijo" class="o_dcasa_dato_cliente" string="Teléfono fijo" widget="phone"
                       options="{'enable_sms': false}" invisible="not partner_id"
                       readonly="state == 'cancel' or not dcasa_cliente_corregible"
                       placeholder="Teléfono fijo, p. ej. 234-5678 (si tiene)"/>
                <field name="dcasa_cliente_correo" class="o_dcasa_dato_cliente" string="Correo" widget="email"
                       invisible="not partner_id" readonly="state == 'cancel' or not dcasa_cliente_corregible"
                       placeholder="Correo, p. ej. nombre@gmail.com"/>
                <field name="dcasa_cliente_sin_correo"
                       invisible="not partner_id or (dcasa_cliente_tiene_correo and not dcasa_cliente_sin_correo)"
                       readonly="state not in ('draft', 'sent')"/>
                <field name="dcasa_cliente_cedula" class="o_dcasa_dato_cliente" string="Cédula o RUC" invisible="not partner_id"
                       readonly="state == 'cancel' or not dcasa_cliente_corregible or dcasa_cliente_es_contacto"
                       placeholder="Cédula o RUC, p. ej. 8-123-456"/>
            </xpath>
        </field>
    </record>
</odoo>
