<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tilopay da una dirección distinta para cada pago: el formulario solo manda al cliente allá. Los parámetros de la
         dirección van aparte (un formulario GET los borraría de la propia dirección). -->
    <template id="redirect_form">
        <form t-att-action="api_url" method="get">
            <t t-foreach="url_params" t-as="param">
                <input type="hidden" t-att-name="param" t-att-value="url_params[param]"/>
            </t>
        </form>
    </template>

</odoo>
