<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tilopay da una dirección distinta para cada pago: el formulario solo manda al cliente allá. Los parámetros de la
         dirección van aparte (un formulario GET los borraría de la propia dirección). -->
    <template id="redirect_form">
        <form t-att-action="api_url" method="get">
            <t t-foreach="url_params" t-as="param">
                <input type="hidden" t-att-name="param" t-att-value="url_params[param]"/>
            </t>
        </form>
    </template>


    <!-- Bajo el botón de pagar, con Tilopay elegido: lo que pasa con los datos de la tarjeta. Es una línea fija (siempre
         en la página, en la tienda y en la ventana del portal); los estilos la muestran solo cuando la opción elegida
         es la de Tilopay (static/src/scss/tilopay.scss). -->
    <template id="submit_button_nota" inherit_id="payment.submit_button" name="D'CASA Tilopay: línea de seguridad bajo el botón">
        <xpath expr="//button[@name='o_payment_submit_button']" position="after">
            <p class="o_dcasa_pago_nota" data-dcasa-proveedor="tilopay"><i class="fa fa-lock" aria-hidden="true"/>Pagas en la página segura de Tilopay; D'CASA nunca ve los datos de tu tarjeta.</p>
        </xpath>
    </template>

</odoo>
