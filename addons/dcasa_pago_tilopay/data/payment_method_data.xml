<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Una sola opción en la tienda: la API de Tilopay no deja elegir el método, lo escoge el cliente en la página de
         Tilopay entre los que la cuenta tenga activos. Nace inactivo: se activa solo cuando Gerencia enciende Tilopay. -->
    <record id="payment_method_tilopay" model="payment.method">
        <field name="name">Tarjeta, Yappy y más (Tilopay)</field>
        <field name="code">tilopay</field>
        <field name="sequence">1</field>
        <field name="active" eval="False"/>
        <field name="image" type="base64" file="payment/static/img/card.png"/>
        <field name="support_tokenization" eval="False"/>
        <field name="support_express_checkout" eval="False"/>
        <field name="support_manual_capture">none</field>
        <field name="support_refund">none</field>
        <field name="supported_currency_ids" eval="[Command.set([ref('base.USD')])]"/>
    </record>

</odoo>
