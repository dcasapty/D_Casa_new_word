<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- «Movimiento» (pedido de la dueña, 2026-11-22): lo que más y lo que menos se mueve, comparando dos periodos, para
         decidir qué anunciar. Pantalla propia (static/src/js/movimiento.js). La acción de cliente no lleva grupos: los
         ponen los menús y el servidor los exige en cada llamada (models/movimiento.py). El menú de Inventario es de
         Gerencia y administradores; el rol Marketing llega desde la pantalla Marketing (sin dinero). -->
    <record id="accion_movimiento" model="ir.actions.client">
        <field name="name">Movimiento</field>
        <field name="tag">dcasa_movimiento</field>
    </record>

    <menuitem id="menu_dcasa_movimiento" name="Movimiento" parent="stock.menu_stock_root"
              action="accion_movimiento" sequence="9"
              groups="sales_team.group_sale_manager,base.group_system"/>
</odoo>
