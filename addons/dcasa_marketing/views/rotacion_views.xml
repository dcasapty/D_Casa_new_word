<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- «Rotación» (pedido de Gerencia, 2026-11-22): qué productos no se mueven, cuánto capital hay parado y qué
         conviene hacer, por días sin vender. Pantalla propia (static/src/js/rotacion.js). La acción de cliente no lleva
         grupos: los ponen los menús y el servidor los exige en cada llamada (models/rotacion.py). El menú de Inventario
         es de Gerencia y administradores; el rol Marketing llega desde la pantalla Marketing (sin dinero). -->
    <record id="accion_rotacion" model="ir.actions.client">
        <field name="name">Rotación</field>
        <field name="tag">dcasa_rotacion</field>
    </record>

    <menuitem id="menu_dcasa_rotacion" name="Rotación" parent="stock.menu_stock_root"
              action="accion_rotacion" sequence="8"
              groups="sales_team.group_sale_manager,base.group_system"/>
</odoo>
