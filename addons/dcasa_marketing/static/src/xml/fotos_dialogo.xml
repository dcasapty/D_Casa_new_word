<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="dcasa_marketing.Fotos">
        <Dialog size="'fs'" header="false" footer="false" withBodyPadding="false" title="titulo"
                contentClass="'o_dcasa_fotos'" bodyClass="'o_dcasa_fotos_cuerpo'">
            <div class="o_dcasa_fotos_raiz" t-att-class="{ o_dcasa_fotos_soltando: state.soltando }"
                 t-on-dragover="alArrastrarEncima" t-on-dragleave="alSalirArrastre" t-on-drop="alSoltarArchivos">

                <!-- Cabecera: el producto, «Ver» / «Todas» y cerrar -->
                <header class="o_dcasa_fotos_cabeza">
                    <div class="o_dcasa_fotos_titulo">
                        <h2 t-esc="titulo"/>
                        <p>
                            <span t-if="state.datos.producto.codigo" t-esc="state.datos.producto.codigo"/>
                            <span t-if="fotos.length"> · <t t-esc="fotos.length"/> <t t-esc="fotos.length === 1 ? 'foto' : 'fotos'"/></span>
                            <span t-if="!state.cargando and !puedeEditar" class="o_dcasa_fotos_solo_ver"> · Solo puedes verlas</span>
                        </p>
                    </div>
                    <div class="o_dcasa_fotos_modos" role="group" aria-label="Cómo ver las fotos">
                        <button type="button" class="o_dcasa_fotos_modo" t-att-aria-pressed="state.modo !== 'galeria' ? 'true' : 'false'"
                                t-att-disabled="!fotos.length" t-on-click="() => this.ver(state.indice)">
                            <i class="fa fa-picture-o" aria-hidden="true"/> Ver
                        </button>
                        <button type="button" class="o_dcasa_fotos_modo" t-att-aria-pressed="state.modo === 'galeria' ? 'true' : 'false'"
                                t-on-click="verTodas">
                            <i class="fa fa-th-large" aria-hidden="true"/> Todas
                        </button>
                    </div>
                    <button type="button" class="o_dcasa_fotos_cerrar" aria-label="Cerrar" title="Cerrar"
                            t-on-click="() => this.props.close()">
                        <i class="fa fa-times" aria-hidden="true"/><span>Cerrar</span>
                    </button>
                </header>

                <p t-if="state.mensaje" role="status" aria-live="polite"
                   t-attf-class="o_dcasa_fotos_mensaje o_dcasa_fotos_mensaje_{{ state.mensaje.tipo }}" t-esc="state.mensaje.texto"/>
                <p t-if="state.subiendo" class="o_dcasa_fotos_mensaje o_dcasa_fotos_mensaje_ok" role="status" aria-live="polite">
                    <i class="fa fa-circle-o-notch fa-spin" aria-hidden="true"/>
                    Subiendo <t t-esc="state.subiendo.hechas + 1 > state.subiendo.total ? state.subiendo.total : state.subiendo.hechas + 1"/>
                    de <t t-esc="state.subiendo.total"/>…
                </p>

                <div t-if="state.cargando" class="o_dcasa_fotos_cargando">
                    <i class="fa fa-circle-o-notch fa-spin" aria-hidden="true"/> Cargando las fotos…
                </div>

                <!-- VER: la foto grande -->
                <t t-elif="state.modo === 'visor' and foto">
                    <div class="o_dcasa_fotos_visor">
                        <div class="o_dcasa_fotos_escenario" t-ref="escenario"
                             t-on-pointerdown="alBajarPuntero" t-on-pointermove="alMoverPuntero"
                             t-on-pointerup="alSubirPuntero" t-on-pointercancel="alSubirPuntero"
                             t-on-wheel="alRueda" t-on-dblclick="alternarZoom">
                            <img class="o_dcasa_fotos_grande" t-att-src="foto.grande" t-att-style="estiloImagen"
                                 t-att-alt="'Foto ' + (state.indice + 1) + ' de ' + titulo" draggable="false"/>
                            <span t-if="foto.principal" class="o_dcasa_fotos_insignia">Principal</span>
                            <button t-if="fotos.length > 1" type="button" class="o_dcasa_fotos_flecha o_dcasa_fotos_flecha_izq"
                                    aria-label="Foto anterior" t-on-click.stop="anterior" t-on-pointerdown.stop="">
                                <i class="fa fa-chevron-left" aria-hidden="true"/>
                            </button>
                            <button t-if="fotos.length > 1" type="button" class="o_dcasa_fotos_flecha o_dcasa_fotos_flecha_der"
                                    aria-label="Foto siguiente" t-on-click.stop="siguiente" t-on-pointerdown.stop="">
                                <i class="fa fa-chevron-right" aria-hidden="true"/>
                            </button>
                            <div class="o_dcasa_fotos_zoom" t-on-pointerdown.stop="">
                                <button type="button" aria-label="Alejar" title="Alejar" t-on-click.stop="alejar"
                                        t-att-disabled="state.zoom.escala &lt;= 1">
                                    <i class="fa fa-search-minus" aria-hidden="true"/>
                                </button>
                                <span class="o_dcasa_fotos_contador"><t t-esc="state.indice + 1"/> de <t t-esc="fotos.length"/></span>
                                <button type="button" aria-label="Acercar" title="Acercar" t-on-click.stop="acercar"
                                        t-att-disabled="state.zoom.escala >= 5">
                                    <i class="fa fa-search-plus" aria-hidden="true"/>
                                </button>
                            </div>
                        </div>

                        <ol t-if="fotos.length > 1" class="o_dcasa_fotos_tira" aria-label="Todas las fotos">
                            <li t-foreach="fotos" t-as="f" t-key="f.clave">
                                <button type="button" class="o_dcasa_fotos_mini" t-att-aria-current="f_index === state.indice ? 'true' : 'false'"
                                        t-att-aria-label="'Ver la foto ' + (f_index + 1)" t-on-click="() => this.irA(f_index)">
                                    <img t-att-src="f.miniatura" alt="" loading="lazy"/>
                                </button>
                            </li>
                        </ol>

                        <div class="o_dcasa_fotos_acciones" t-att-class="{ o_dcasa_fotos_acciones_solo_ver: !puedeEditar }">
                            <t t-if="puedeEditar">
                                <button type="button" class="o_dcasa_fotos_accion" t-att-disabled="state.ocupado" t-on-click="() => this.elegirReemplazo(false)">
                                    <i class="fa fa-exchange" aria-hidden="true"/><span>Reemplazar</span>
                                </button>
                                <button t-if="esCelular" type="button" class="o_dcasa_fotos_accion" t-att-disabled="state.ocupado" t-on-click="() => this.elegirReemplazo(true)">
                                    <i class="fa fa-camera" aria-hidden="true"/><span>Tomar otra</span>
                                </button>
                                <button type="button" class="o_dcasa_fotos_accion" t-att-disabled="state.ocupado" t-on-click="recortar">
                                    <i class="fa fa-crop" aria-hidden="true"/><span>Recortar</span>
                                </button>
                                <button type="button" class="o_dcasa_fotos_accion" t-att-disabled="state.ocupado" t-on-click="girar">
                                    <i class="fa fa-repeat" aria-hidden="true"/><span>Girar</span>
                                </button>
                                <button type="button" class="o_dcasa_fotos_accion" t-att-disabled="state.ocupado or foto.principal" t-on-click="() => this.hacerPrincipal()">
                                    <i class="fa fa-star" aria-hidden="true"/><span t-esc="foto.principal ? 'Es la principal' : 'Hacer principal'"/>
                                </button>
                                <button type="button" class="o_dcasa_fotos_accion o_dcasa_fotos_accion_quitar" t-att-disabled="state.ocupado" t-on-click="() => this.quitar()">
                                    <i class="fa fa-trash-o" aria-hidden="true"/><span>Quitar</span>
                                </button>
                            </t>
                            <a class="o_dcasa_fotos_accion" t-att-href="foto.descarga" t-att-download="foto.nombre_archivo">
                                <i class="fa fa-download" aria-hidden="true"/><span>Descargar</span>
                            </a>
                        </div>
                    </div>
                </t>

                <!-- RECORTAR -->
                <t t-elif="state.modo === 'recorte' and foto">
                    <div class="o_dcasa_fotos_recorte">
                        <p class="o_dcasa_fotos_ayuda">Mueve y agranda el cuadro hasta dejar solo lo que quieres. Arrastra la foto para moverla.</p>
                        <div class="o_dcasa_fotos_proporciones" role="group" aria-label="Forma del recorte">
                            <button t-foreach="proporciones" t-as="p" t-key="p.clave" type="button" class="o_dcasa_fotos_chip"
                                    t-att-aria-pressed="state.proporcion === p.clave ? 'true' : 'false'"
                                    t-on-click="() => this.ponerProporcion(p.clave)" t-esc="p.nombre"/>
                        </div>
                        <div class="o_dcasa_fotos_lienzo">
                            <img t-ref="imagenRecorte" t-att-src="foto.grande" alt="Foto para recortar"/>
                        </div>
                        <div class="o_dcasa_fotos_acciones o_dcasa_fotos_acciones_recorte">
                            <button type="button" class="o_dcasa_fotos_accion" t-att-disabled="state.ocupado" t-on-click="cancelarRecorte">
                                <i class="fa fa-times" aria-hidden="true"/><span>Cancelar</span>
                            </button>
                            <button type="button" class="o_dcasa_fotos_accion o_dcasa_fotos_accion_principal" t-att-disabled="state.ocupado" t-on-click="guardarRecorte">
                                <i class="fa fa-check" aria-hidden="true"/><span>Guardar recorte</span>
                            </button>
                        </div>
                    </div>
                </t>

                <!-- TODAS: la galería -->
                <t t-else="">
                    <div class="o_dcasa_fotos_galeria">
                        <div t-if="puedeEditar" class="o_dcasa_fotos_subir">
                            <i class="fa fa-cloud-upload" aria-hidden="true"/>
                            <p class="o_dcasa_fotos_subir_texto">
                                <strong>Sube varias fotos a la vez.</strong>
                                <span t-if="!esCelular"> Arrástralas aquí o elígelas.</span>
                                <span> La primera es la principal: ordénalas arrastrando<t t-if="esCelular"> (deja el dedo un momento sobre la foto)</t> o con las flechas.</span>
                            </p>
                            <div class="o_dcasa_fotos_subir_botones">
                                <button type="button" class="o_dcasa_fotos_accion o_dcasa_fotos_accion_principal" t-att-disabled="state.ocupado"
                                        t-on-click="() => this.elegirArchivos(false)">
                                    <i class="fa fa-plus" aria-hidden="true"/><span>Elegir fotos</span>
                                </button>
                                <button t-if="esCelular" type="button" class="o_dcasa_fotos_accion" t-att-disabled="state.ocupado"
                                        t-on-click="() => this.elegirArchivos(true)">
                                    <i class="fa fa-camera" aria-hidden="true"/><span>Tomar foto</span>
                                </button>
                            </div>
                        </div>
                        <p t-if="!fotos.length and !state.cargando" class="o_dcasa_fotos_vacio">
                            Este producto todavía no tiene fotos.
                        </p>
                        <ol class="o_dcasa_fotos_cuadricula" t-ref="cuadricula" aria-label="Fotos del producto en orden">
                            <li t-foreach="fotos" t-as="f" t-key="f.clave" class="o_dcasa_fotos_tarjeta" t-att-data-clave="f.clave">
                                <!-- No es un <button>: desde aquí se arrastra para ordenar (los botones no arrastran). -->
                                <div class="o_dcasa_fotos_tarjeta_foto" role="button" tabindex="0"
                                     t-att-aria-label="'Ver la foto ' + (f_index + 1) + ' en grande'"
                                     t-on-click="() => this.ver(f_index)" t-on-keydown="(ev) => this.alTeclearTarjeta(ev, f_index)">
                                    <img t-att-src="f.mediana" alt="" loading="lazy" draggable="false"/>
                                </div>
                                <span class="o_dcasa_fotos_numero" t-esc="f_index + 1"/>
                                <span t-if="f.principal" class="o_dcasa_fotos_insignia">Principal</span>
                                <div t-if="puedeEditar" class="o_dcasa_fotos_tarjeta_botones">
                                    <button type="button" t-att-disabled="state.ocupado or f_index === 0" aria-label="Mover antes" title="Mover antes"
                                            t-on-click="() => this.mover(f, -1)"><i class="fa fa-arrow-left" aria-hidden="true"/></button>
                                    <button type="button" t-att-disabled="state.ocupado or f.principal" title="Hacer principal"
                                            t-att-aria-label="f.principal ? 'Es la principal' : 'Hacer principal'"
                                            t-on-click="() => this.hacerPrincipal(f)"><i class="fa fa-star" aria-hidden="true"/></button>
                                    <button type="button" t-att-disabled="state.ocupado" aria-label="Quitar" title="Quitar"
                                            t-on-click="() => this.quitar(f)"><i class="fa fa-trash-o" aria-hidden="true"/></button>
                                    <button type="button" t-att-disabled="state.ocupado or f_index === fotos.length - 1" aria-label="Mover después" title="Mover después"
                                            t-on-click="() => this.mover(f, 1)"><i class="fa fa-arrow-right" aria-hidden="true"/></button>
                                </div>
                            </li>
                        </ol>
                    </div>
                </t>

                <!-- Entradas de archivo (escondidas): varias para subir; una para reemplazar; con cámara en el celular -->
                <input t-ref="archivos" type="file" accept="image/*" multiple="multiple" class="d-none"
                       t-on-change="alElegirArchivos" aria-hidden="true" tabindex="-1"/>
                <input t-ref="camara" type="file" accept="image/*" capture="environment" class="d-none"
                       t-on-change="alElegirArchivos" aria-hidden="true" tabindex="-1"/>
                <input t-ref="reemplazo" type="file" accept="image/*" class="d-none"
                       t-on-change="alElegirReemplazo" aria-hidden="true" tabindex="-1"/>
                <input t-ref="reemplazoCamara" type="file" accept="image/*" capture="environment" class="d-none"
                       t-on-change="alElegirReemplazo" aria-hidden="true" tabindex="-1"/>
            </div>
        </Dialog>
    </t>

</templates>
