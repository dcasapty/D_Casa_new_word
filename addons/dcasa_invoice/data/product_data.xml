<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Flete / envío: la línea que la factura imprime en su propio bloque (ver models/lineas.py).
             Sin precio ni descripción de venta: el flete se cotiza en cada venta (la vendedora lo
             escribe en la línea) y las condiciones de entrega las redacta la dueña en la empresa.
             El impuesto es el que Odoo pone por defecto a cualquier producto nuevo; la contadora
             decide si el transporte lleva ITBMS. La tienda web usa su propio producto «Entrega»
             (DCASA-ENTREGA), que este módulo también reconoce como flete. -->
        <record id="categ_flete" model="product.category">
            <field name="name">Flete y envío</field>
        </record>
        <record id="product_flete" model="product.product">
            <field name="name">Flete / envío a domicilio</field>
            <field name="default_code">DCASA-FLETE</field>
            <field name="type">service</field>
            <field name="categ_id" ref="categ_flete"/>
            <field name="invoice_policy">order</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="list_price">0</field>
        </record>
    </data>
</odoo>
