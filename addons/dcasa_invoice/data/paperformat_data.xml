<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hoja carta (la de Panamá), con sitio arriba para la placa y la banda y abajo para
         el pie de dos líneas. La empresa principal lo adopta en el post_init. -->
    <record id="paperformat_dcasa_carta" model="report.paperformat">
        <field name="name">D'CASA Carta</field>
        <field name="default" eval="False"/>
        <field name="format">Letter</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">38</field>
        <field name="margin_bottom">24</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">32</field>
        <field name="dpi">90</field>
    </record>
</odoo>
