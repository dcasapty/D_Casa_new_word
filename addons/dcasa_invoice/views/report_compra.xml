<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pedido de compra: lleva SIEMPRE su QR de uso interno (lo pidió la dueña; es el único documento sin
         interruptor porque no toca la factura). Va al final, a la derecha; nada de lo demás se mueve. -->
    <template id="report_purchaseorder_document_dcasa" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <t t-call="dcasa_invoice.dcasa_qr_documento"><t t-set="registro" t-value="o"/></t>
        </xpath>
    </template>
</odoo>
