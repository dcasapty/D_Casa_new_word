<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- «Imprimir documentos»: un botón discreto en la factura y en el pedido (y en sus listas, para varias a la
         vez) que abre un cuadro pequeño. Es una facilidad extra: los botones y informes de siempre no se tocan. -->

    <record id="dcasa_impresion_paquete_form" model="ir.ui.view">
        <field name="name">dcasa.impresion.paquete.form</field>
        <field name="model">dcasa.impresion.paquete</field>
        <field name="arch" type="xml">
            <form string="Imprimir documentos" create="0" delete="0" class="o_dcasa_paquete">
                <field name="move_ids" invisible="1"/>
                <field name="pago_ids" invisible="1"/>
                <field name="tras_pago" invisible="1"/>
                <field name="excede" invisible="1"/>
                <field name="omitidas" invisible="1"/>
                <div class="alert alert-success" role="status" invisible="not tras_pago">
                    <strong>Pago completo.</strong> Si quieres, imprime o descarga los documentos ahora; si no, ciérralo.
                </div>
                <p class="fw-bold mb-1"><field name="resumen" nolabel="1"/></p>
                <p class="text-muted mb-2">
                    Se junta en un solo PDF lo que dejes marcado, por cada factura y en este orden.
                    «Imprimir todo» abre el cuadro de impresión sin guardar ningún archivo.
                </p>
                <group>
                    <field name="incluir_cliente"/>
                    <field name="incluir_copia"/>
                    <field name="incluir_entrega"/>
                </group>
                <div class="text-muted small mb-2"><field name="entregas_texto" nolabel="1"/></div>
                <div class="alert alert-warning" role="alert" invisible="not aviso"><field name="aviso" nolabel="1"/></div>
                <footer>
                    <button name="action_imprimir" type="object" string="Imprimir todo" class="btn-primary"
                            invisible="excede" data-hotkey="p"/>
                    <button name="action_descargar" type="object" string="Descargar todo" invisible="excede"
                            data-hotkey="d"/>
                    <button string="Cancelar" special="cancel" invisible="tras_pago" data-hotkey="x"/>
                    <button name="action_cerrar" type="object" string="Cerrar" invisible="not tras_pago"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Factura de cliente publicada -->
    <record id="view_move_form_dcasa_paquete" model="ir.ui.view">
        <field name="name">account.move.form.dcasa.paquete</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="(//header/button[@name='action_print_pdf'])[2]" position="after">
                <button name="action_dcasa_imprimir_documentos" type="object" string="Imprimir documentos"
                        groups="account.group_account_invoice,account.group_account_readonly"
                        invisible="state != 'posted' or move_type != 'out_invoice'"
                        help="Junta en un solo PDF la factura del cliente, la copia de la empresa y la nota de entrega."/>
            </xpath>
        </field>
    </record>

    <!-- Lista de facturas de clientes: selecciona varias y «Imprimir paquete» -->
    <record id="view_out_invoice_tree_dcasa_paquete" model="ir.ui.view">
        <field name="name">account.out.invoice.list.dcasa.paquete</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_force_register_payment']" position="after">
                <button name="action_dcasa_imprimir_documentos" type="object" string="Imprimir paquete"
                        groups="account.group_account_invoice,account.group_account_readonly"/>
            </xpath>
        </field>
    </record>

    <!-- Pedido con factura publicada -->
    <record id="view_order_form_dcasa_paquete" model="ir.ui.view">
        <field name="name">sale.order.form.dcasa.paquete</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <field name="dcasa_tiene_factura_publicada" invisible="1"/>
                <button name="action_dcasa_imprimir_documentos" type="object" string="Imprimir documentos"
                        groups="account.group_account_invoice,account.group_account_readonly"
                        invisible="not dcasa_tiene_factura_publicada"
                        help="Junta en un solo PDF la factura del cliente, la copia de la empresa y la nota de entrega."/>
            </xpath>
        </field>
    </record>

    <!-- Lista de pedidos: selecciona varios y «Imprimir paquete» (los que no tienen factura publicada se dejan fuera) -->
    <record id="view_order_tree_dcasa_paquete" model="ir.ui.view">
        <field name="name">sale.order.list.dcasa.paquete</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_dcasa_imprimir_documentos" type="object" string="Imprimir paquete"
                        groups="account.group_account_invoice,account.group_account_readonly"/>
            </xpath>
        </field>
    </record>
</odoo>
