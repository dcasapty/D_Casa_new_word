<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Ajustes › «Meta (Facebook e Instagram)» (solo administradores). Todo apagado y vacío de fábrica; las
         compuertas al encender están en models/res_config_settings.py. El token NUNCA se escribe aquí: vive solo en
         el servidor (secreto META_CAPI_TOKEN) y aquí solo se ve si está «cargado» o «falta».

         Va en su propia sección y no dentro de «Sitio web»: esa sección de Ajustes es del grupo «Editor y
         diseñador», que en D'CASA nadie tiene (docs/OPERACION.md, «El sitio se edita por código»). -->
    <record id="res_config_settings_view_form_dcasa_meta" model="ir.ui.view">
        <field name="name">res.config.settings.form.dcasa.meta</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Meta (Facebook e Instagram)" string="Meta (Facebook e Instagram)"
                     name="dcasa_meta_eventos" groups="base.group_system">
                    <block title="Meta: píxel y ventas" name="dcasa_meta_settings">
                        <setting id="dcasa_meta_estado" string="Estado"
                                 help="Nada sale hacia Meta sin el interruptor encendido, la sección de Meta en la política de privacidad, el token (para las ventas) y el consentimiento de la persona. Paso a paso en docs/META_EVENTOS.md.">
                            <div class="text-muted"><field name="dcasa_meta_estado" readonly="1" class="w-100"/></div>
                            <div class="mt8">
                                <i class="fa fa-key me-1" aria-hidden="true"/><field name="dcasa_meta_token_estado" readonly="1" class="w-auto"/>
                            </div>
                            <field name="dcasa_meta_token_rechazado" invisible="1"/>
                            <div class="mt8 alert alert-warning mb-0" role="alert" invisible="not dcasa_meta_token_rechazado">
                                <i class="fa fa-exclamation-triangle me-1" aria-hidden="true"/>
                                El token de Meta no funciona: Meta lo rechazó. Lo pendiente espera. Genera uno nuevo en Meta
                                y guárdalo en GitHub como META_CAPI_TOKEN (nunca aquí ni por el chat).
                            </div>
                        </setting>
                        <setting id="dcasa_meta_pixel" string="ID del píxel"
                                 help="El número del píxel (conjunto de datos) que muestra Meta › Administrador de eventos. Solo números; no es secreto.">
                            <field name="dcasa_meta_pixel_id" placeholder="Solo números, p. ej. 123456789012345"/>
                        </setting>
                        <setting id="dcasa_meta_pixel_activo"
                                 help="Mide visitas, productos vistos y carrito, solo de quien acepta las cookies (enciende también el aviso de cookies). El personal con sesión no se mide.">
                            <field name="dcasa_meta_pixel_activo"/>
                        </setting>
                        <setting id="dcasa_meta_capi_web"
                                 help="Cuando un pedido de la tienda en línea queda pagado (no al hacer el pedido), se reporta a Meta, solo con el consentimiento de la persona. Pide además el token.">
                            <field name="dcasa_meta_capi_web"/>
                        </setting>
                        <setting id="dcasa_meta_capi_tienda"
                                 help="Cuando una factura de la tienda queda pagada, se reporta a Meta solo si el cliente aceptó (la casilla de su ficha). Pide además el token.">
                            <field name="dcasa_meta_capi_tienda"/>
                        </setting>
                        <setting id="dcasa_meta_prueba" string="Probar con Meta"
                                 help="Copia el código de Meta › Administrador de eventos › Probar eventos. El botón manda un solo evento de prueba, sin datos de ninguna persona, y te dice si Meta lo recibió.">
                            <div class="content-group">
                                <div class="row">
                                    <label for="dcasa_meta_test_event_code" class="col-lg-4 o_light_label"/>
                                    <field name="dcasa_meta_test_event_code" placeholder="TEST12345"/>
                                </div>
                                <div class="row">
                                    <label for="dcasa_meta_graph_version" class="col-lg-4 o_light_label"/>
                                    <field name="dcasa_meta_graph_version" placeholder="v26.0"/>
                                </div>
                            </div>
                            <div class="mt8">
                                <button name="action_dcasa_meta_enviar_prueba" type="object" string="Enviar evento de prueba"
                                        class="btn-secondary" icon="fa-paper-plane-o"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_dcasa_meta_ajustes" model="ir.actions.act_window">
        <field name="name">Meta: píxel y ventas</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'dcasa_meta_eventos', 'bin_size': False}</field>
    </record>

    <!-- Sitio web › Configuración (Odoo la deja solo a los administradores) › Meta: píxel y ventas. -->
    <menuitem id="menu_dcasa_meta_ajustes" name="Meta: píxel y ventas" parent="website.menu_website_global_configuration"
              action="action_dcasa_meta_ajustes" sequence="60" groups="base.group_system"/>
</odoo>
