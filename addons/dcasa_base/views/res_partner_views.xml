<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_dcasa" model="ir.ui.view">
        <field name="name">res.partner.form.dcasa</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="vat" position="attributes">
                <attribute name="placeholder">p. ej. 8-123-4567 (cédula) o 1234567-1-123456 (empresa)</attribute>
                <attribute name="class" add="o_dcasa_copiar" separator=" "/>
            </field>
            <field name="vat" position="after">
                <field name="l10n_pa_dv" placeholder="p. ej. 7" readonly="parent_id"/>
            </field>
            <!-- Copiar con un toque (static/src/js/copiar.js, 2026-10-22): nombre, correo, celular, RUC y referencia. -->
            <xpath expr="(//h1//field[@name='name'])[1]" position="attributes">
                <attribute name="class" add="o_dcasa_copiar" separator=" "/>
            </xpath>
            <xpath expr="(//h1//field[@name='name'])[2]" position="attributes">
                <attribute name="class" add="o_dcasa_copiar" separator=" "/>
            </xpath>
            <xpath expr="//div[hasclass('mb8')]//field[@name='email']" position="attributes">
                <attribute name="class" add="o_dcasa_copiar" separator=" "/>
            </xpath>
            <xpath expr="//div[hasclass('mb8')]//field[@name='phone']" position="attributes">
                <attribute name="class" add="o_dcasa_copiar" separator=" "/>
            </xpath>
            <field name="ref" position="attributes">
                <attribute name="class" add="o_dcasa_copiar" separator=" "/>
            </field>
        </field>
    </record>

    <!-- Lista de contactos: copiar el nombre, el correo, el celular y el RUC sin abrir la ficha. Con widget="char" la
         celda se ve igual, pero la pinta el componente del campo, que es el que lleva el ícono (sin widget, la lista
         escribe el texto directo). -->
    <record id="view_partner_list_copiar" model="ir.ui.view">
        <field name="name">res.partner.list.dcasa.copiar</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <field name="display_name" position="attributes">
                <attribute name="class" add="o_dcasa_copiar" separator=" "/>
                <attribute name="widget">char</attribute>
            </field>
            <field name="vat" position="attributes">
                <attribute name="class" add="o_dcasa_copiar" separator=" "/>
                <attribute name="widget">char</attribute>
            </field>
            <field name="email" position="attributes">
                <attribute name="class" add="o_dcasa_copiar" separator=" "/>
                <attribute name="widget">char</attribute>
            </field>
            <field name="phone" position="attributes">
                <attribute name="class" add="o_dcasa_copiar" separator=" "/>
                <attribute name="widget">char</attribute>
            </field>
        </field>
    </record>

    <record id="view_company_form_dcasa" model="ir.ui.view">
        <field name="name">res.company.form.dcasa</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <field name="vat" position="after">
                <field name="l10n_pa_dv"/>
            </field>
        </field>
    </record>
</odoo>
