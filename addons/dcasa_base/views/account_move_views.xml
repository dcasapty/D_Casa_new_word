<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_dcasa_historica" model="ir.ui.view">
        <field name="name">account.move.form.dcasa.historica</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <field name="dcasa_historica" invisible="1"/>
                <div class="alert alert-info" role="alert" invisible="not dcasa_historica">
                    <b>Cargada del sistema anterior.</b> Es historia: no se manda a la DGI ni da puntos de Socios.
                </div>
            </xpath>
        </field>
    </record>

    <!-- El cobro solo en Caja (decisión de la gerencia A5, 2026-10-17; models/cobros.py): a quien no cobra (la
         Vendedora) «Pagar» no le sale y la factura dice dónde se cobra; el servidor se lo niega por cualquier camino.
         «Pagar» en una nota de crédito es devolverle dinero al cliente: solo Gerencia. «Restablecer a borrador» y
         «Nota de crédito» siguen a la vista: si quien los pulsa no es Gerencia, el servidor contesta con un mensaje
         claro de a quién pedírselo. -->
    <record id="view_move_form_dcasa_cobro_en_caja" model="ir.ui.view">
        <field name="name">account.move.form.dcasa.cobro.en.caja</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <field name="dcasa_puede_cobrar" invisible="1"/>
                <field name="dcasa_es_gerencia" invisible="1"/>
                <div class="alert alert-info o_dcasa_cobro_en_caja" role="status"
                     invisible="dcasa_puede_cobrar or state != 'posted' or move_type not in ('out_invoice', 'out_receipt') or payment_state not in ('not_paid', 'partial')">
                    <i class="fa fa-money me-1" aria-hidden="true"/>
                    El cobro de esta factura lo registra <b>Caja</b>: llévala a Caja (o pídeselo a Gerencia).
                </div>
            </xpath>
            <xpath expr="//button[@id='account_invoice_payment_btn']" position="attributes">
                <attribute name="invisible" add="(move_type in ('out_invoice', 'out_receipt') and not dcasa_puede_cobrar) or (move_type == 'out_refund' and not dcasa_es_gerencia)" separator=" or "/>
            </xpath>
            <xpath expr="//button[@id='account_invoice_payment_secondary_btn']" position="attributes">
                <attribute name="invisible" add="(move_type in ('out_invoice', 'out_receipt') and not dcasa_puede_cobrar) or (move_type == 'out_refund' and not dcasa_es_gerencia)" separator=" or "/>
            </xpath>
        </field>
    </record>

    <record id="view_invoice_tree_dcasa_cobro_en_caja" model="ir.ui.view">
        <field name="name">account.invoice.list.dcasa.cobro.en.caja</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_force_register_payment']" position="attributes">
                <attribute name="groups">dcasa_base.group_caja,account.group_account_user,account.group_account_manager,base.group_system</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_account_invoice_filter_dcasa_historica" model="ir.ui.view">
        <field name="name">account.invoice.select.dcasa.historica</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <filter name="draft" position="after">
                <filter name="dcasa_historica" string="Cargadas del sistema anterior" domain="[('dcasa_historica', '=', True)]"/>
            </filter>
        </field>
    </record>

    <!-- Ventas › Para facturar › Facturas: la misma lista de Facturación › Clientes › Facturas (con las cargadas del
         sistema anterior, que no vienen de un pedido y por eso no aparecen en Pedidos). -->
    <menuitem id="menu_dcasa_ventas_facturas" name="Facturas" parent="sale.menu_sale_invoicing"
              action="account.action_move_out_invoice_type" sequence="5" groups="account.group_account_invoice"/>
</odoo>
