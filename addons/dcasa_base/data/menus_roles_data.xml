<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Qué menús del CRM ve cada rol. La vendedora trabaja su flujo, sus actividades y sus cotizaciones; los
        reportes de embudo y pronóstico y los equipos de venta son de Gerencia (Gerencia incluye sale_manager).
        Los menús son de crm: aquí solo se les pone el grupo, no se crean ni se mueven.
    -->
    <record id="crm.crm_menu_report" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('sales_team.group_sale_manager')])]"/>
    </record>
    <record id="crm.crm_activity_report_menu" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('sales_team.group_sale_manager')])]"/>
    </record>
    <record id="crm.crm_opportunity_report_menu" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('sales_team.group_sale_manager')])]"/>
    </record>
    <record id="crm.crm_opportunity_report_menu_lead" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('sales_team.group_sale_manager')])]"/>
    </record>
    <record id="crm.crm_menu_forecast" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('sales_team.group_sale_manager')])]"/>
    </record>
    <record id="crm.sales_team_menu_team_pipeline" model="ir.ui.menu">
        <field name="group_ids" eval="[Command.set([ref('sales_team.group_sale_manager')])]"/>
    </record>
</odoo>
