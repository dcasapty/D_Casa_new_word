<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Grupo propio del usuario técnico «juan» (el asistente de clientes). NO implica ningún otro grupo:
        sin él no se ve ninguna herramienta de Juan y, con él, solo se ven las herramientas de Juan (las de
        uso interno de Brian piden el grupo de usuario interno, que «juan» no tiene).
        No lleva permisos sobre ningún modelo: las herramientas leen y escriben acotado, con sudo() y filtros.
    -->
    <record id="group_juan" model="res.groups">
        <field name="name">Juan (asistente de clientes)</field>
        <field name="comment">Usuario técnico del asistente que atiende a los clientes. Solo ve las herramientas de Juan. Sin permisos internos.</field>
    </record>
</odoo>
