<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dcasa_juan_ajustes_form" model="ir.ui.view">
        <field name="name">dcasa.juan.ajustes.form</field>
        <field name="model">dcasa.juan.ajustes</field>
        <field name="arch" type="xml">
            <form string="Ajustes de Juan" create="false" delete="false">
                <header>
                    <button name="action_probar_conexion" type="object" string="Probar conexión"
                            class="btn-secondary" groups="sales_team.group_sale_manager"/>
                    <field name="es_entorno_de_prueba" invisible="1"/>
                    <button name="action_cargar_ejemplos" type="object" string="Cargar conversaciones de ejemplo"
                            class="btn-secondary" groups="sales_team.group_sale_manager"
                            invisible="not es_entorno_de_prueba"
                            help="Solo en el entorno de prueba: crea 4 conversaciones ficticias para ver cómo se ve la pantalla."/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Ajustes de Juan</h1>
                        <p class="text-muted">El asistente que atiende a los clientes por WhatsApp y redes. Aquí decides
                            cómo se presenta, cuándo contesta y cuánto insiste.</p>
                    </div>
                    <group>
                        <group string="Cómo se presenta">
                            <field name="nombre_publico"/>
                            <field name="bot_activo_global"/>
                            <field name="cotizacion_automatica"/>
                        </group>
                        <group string="Dónde contesta">
                            <field name="canal_whatsapp_qr"/>
                            <field name="canal_whatsapp_cloud"/>
                            <field name="canal_telegram"/>
                            <field name="canal_messenger"/>
                            <field name="canal_instagram"/>
                        </group>
                    </group>
                    <group>
                        <group string="Horario laboral (hora de Panamá)">
                            <label for="horario_inicio" string="De"/>
                            <div class="o_row">
                                <field name="horario_inicio" widget="float_time" class="oe_inline"/>
                                <span>a</span>
                                <field name="horario_fin" widget="float_time" class="oe_inline"/>
                            </div>
                            <field name="dia_lunes"/>
                            <field name="dia_martes"/>
                            <field name="dia_miercoles"/>
                            <field name="dia_jueves"/>
                            <field name="dia_viernes"/>
                            <field name="dia_sabado"/>
                            <field name="dia_domingo"/>
                        </group>
                        <group string="Seguimiento a quien no volvió a escribir">
                            <field name="seguimiento_primero_horas"/>
                            <field name="seguimiento_segundo_dias"/>
                            <field name="seguimiento_maximo"/>
                            <field name="seguimiento_solo_horario_laboral"/>
                            <div class="text-muted" colspan="2">
                                Solo se le hace seguimiento a quien mostró intención de compra (hay una oportunidad
                                viva en el CRM) y nunca compró. No se le hace a quien ya es cliente (alguna factura
                                pagada), a quien la dejó como perdida ni a quien pidió que no lo contacten.
                            </div>
                        </group>
                    </group>
                    <group>
                        <group string="CRM que se ajusta solo">
                            <field name="crm_automatico"/>
                            <field name="crm_dias_para_perdida" invisible="not crm_automatico"/>
                            <div class="text-muted" colspan="2">
                                Pasan solas a «Propuesta» (cotización enviada) y a «Ganada» (factura pagada), reciben
                                su temperatura y se archivan sin respuesta. Solo se mueven hacia adelante y, si una
                                persona toca la etapa o la temperatura, esa oportunidad queda en sus manos.
                            </div>
                        </group>
                    </group>
                    <group>
                        <group string="Inteligencia artificial">
                            <field name="proveedor_ia"/>
                            <field name="proveedor_respaldo_ia"/>
                            <field name="modelo_rapido"/>
                            <field name="modelo_inteligente"/>
                            <field name="presupuesto_ia_mensual_usd"/>
                            <field name="aviso_contributor" invisible="1"/>
                            <div class="alert alert-warning" role="alert" colspan="2" invisible="not aviso_contributor">
                                Elegiste un modelo «contributor»: entrena con las conversaciones de tus clientes.
                                La política de privacidad del sitio tiene que decirlo.
                            </div>
                            <div class="text-muted" colspan="2">
                                Los modelos con «contributor» en el nombre entrenan con las conversaciones de tus
                                clientes; si los eliges, la política de privacidad del sitio debe decirlo. Las claves de
                                acceso a la IA no se guardan en Odoo: viven solo en el Worker de Juan.
                            </div>
                        </group>
                        <group string="Cuando una vendedora toma la conversación">
                            <field name="pausa_por_defecto_minutos"/>
                            <field name="responsable_id" options="{'no_create': True}"/>
                            <field name="reparto_modo"/>
                            <field name="resumen_ia_activo"/>
                            <field name="busqueda_semantica"/>
                            <field name="usuarios_aviso_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="avisar_comprobantes"/>
                            <field name="avisar_archivos"/>
                            <field name="aviso_espera_minutos"/>
                            <field name="aviso_espera_solo_horario" invisible="aviso_espera_minutos == 0"/>
                        </group>
                    </group>
                    <group string="Precios de la IA (dólares por millón de tokens)">
                        <group string="Modelo rápido">
                            <field name="precio_rapido_entrada_usd_mtok"/>
                            <field name="precio_rapido_salida_usd_mtok"/>
                            <field name="precio_rapido_cache_usd_mtok"/>
                        </group>
                        <group string="Modelo inteligente">
                            <field name="precio_inteligente_entrada_usd_mtok"/>
                            <field name="precio_inteligente_salida_usd_mtok"/>
                            <field name="precio_inteligente_cache_usd_mtok"/>
                        </group>
                        <div class="text-muted" colspan="2">
                            Déjalos en 0 si no sabes el precio: sin precio verificado el Worker no calcula el gasto en
                            dólares. No pongas cifras de memoria.
                        </div>
                    </group>
                    <group string="Privacidad de los clientes">
                        <field name="guardar_foto_perfil"/>
                        <div class="text-muted" colspan="2">
                            La foto de perfil es un dato personal. Se guarda reducida, solo en la conversación, nunca llega a
                            la IA y se borra con ella. La política de privacidad del sitio debe mencionarla.
                        </div>
                    </group>
                    <group string="Textos">
                        <field name="mensaje_bienvenida" placeholder="Lo primero que dice el asistente"/>
                        <field name="texto_privacidad_corto"/>
                        <field name="palabras_prohibidas" placeholder="Una palabra por línea"/>
                        <field name="lecciones_aprendidas"
                               placeholder="Una por línea. Ejemplo: cuando pregunten por la garantía, di que una vendedora se la confirma."/>
                    </group>
                    <group string="Conexión con el Worker de Juan">
                        <field name="juan_url" placeholder="https://juan.…"/>
                        <field name="token_odoo_configurado" readonly="1"/>
                        <field name="token_worker_configurado" readonly="1"/>
                        <div class="text-muted" colspan="2">
                            Los dos tokens (JUAN_ODOO_TOKEN y JUAN_WORKER_TOKEN) se cargan como secretos del
                            servidor, nunca aquí. Cada uno debe tener 32 caracteres o más.
                        </div>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_dcasa_juan_ajustes" model="ir.actions.server">
        <field name="name">Ajustes de Juan</field>
        <field name="model_id" ref="model_dcasa_juan_ajustes"/>
        <field name="state">code</field>
        <field name="code">action = model.action_abrir()</field>
    </record>
</odoo>
