<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===================== Lista ===================== -->
    <record id="view_dcasa_conversacion_list" model="ir.ui.view">
        <field name="name">dcasa.conversacion.list</field>
        <field name="model">dcasa.conversacion</field>
        <field name="arch" type="xml">
            <list string="Conversaciones" create="false" default_order="ultima_actividad desc"
                  decoration-bf="estado == 'humano' and ultimo_mensaje_autor == 'cliente'"
                  decoration-muted="estado == 'cerrada'">
                <field name="partner_id"/>
                <field name="canal"/>
                <field name="estado" widget="badge" decoration-info="estado == 'bot'"
                       decoration-primary="estado == 'humano'" decoration-muted="estado == 'cerrada'"/>
                <field name="ultimo_mensaje_texto"/>
                <field name="ultima_actividad" widget="datetime"/>
                <field name="asignada_a" widget="many2one_avatar_user" optional="show"/>
                <field name="etiqueta_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="show"/>
                <field name="seguimiento_proximo" optional="hide"/>
                <field name="por_enviar_count" string="Por enviar" optional="show"/>
                <field name="ultimo_mensaje_autor" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ===================== Kanban (la bandeja) ===================== -->
    <record id="view_dcasa_conversacion_kanban" model="ir.ui.view">
        <field name="name">dcasa.conversacion.kanban</field>
        <field name="model">dcasa.conversacion</field>
        <field name="arch" type="xml">
            <kanban default_group_by="estado" create="false" quick_create="false" records_draggable="false"
                    group_create="false" class="o_dcasa_bandeja_kanban">
                <field name="partner_id"/>
                <field name="canal"/>
                <field name="estado"/>
                <field name="ultimo_mensaje_texto"/>
                <field name="ultimo_mensaje_autor"/>
                <field name="ultima_actividad"/>
                <field name="asignada_a"/>
                <field name="etiqueta_ids"/>
                <field name="por_enviar_count"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-start">
                            <field name="partner_id" class="fw-bold fs-5 text-truncate"/>
                            <field name="canal" widget="badge"/>
                        </div>
                        <div class="text-muted text-truncate" t-if="record.ultimo_mensaje_texto.raw_value">
                            <field name="ultimo_mensaje_texto"/>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <field name="ultima_actividad" widget="datetime" class="text-muted small"/>
                            <field name="asignada_a" widget="many2one_avatar_user" invisible="not asignada_a"/>
                        </div>
                        <div class="mt-1">
                            <field name="etiqueta_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </div>
                        <div class="mt-1" t-if="record.por_enviar_count.raw_value &gt; 0">
                            <span class="badge text-bg-warning">Mensajes por enviar</span>
                        </div>
                        <div class="mt-1" t-if="record.estado.raw_value == 'humano' and record.ultimo_mensaje_autor.raw_value == 'cliente'">
                            <span class="badge text-bg-primary">Espera tu respuesta</span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ===================== Formulario: la conversación como chat ===================== -->
    <record id="view_dcasa_conversacion_form" model="ir.ui.view">
        <field name="name">dcasa.conversacion.form</field>
        <field name="model">dcasa.conversacion</field>
        <field name="arch" type="xml">
            <form string="Conversación" create="false">
                <header>
                    <button name="action_atender" type="object" string="Atender" class="btn-primary"
                            invisible="estado == 'humano' and not bot_atiende"/>
                    <button name="action_devolver_al_bot" type="object" string="Devolver al asistente"
                            class="btn-secondary" invisible="estado != 'humano' or bot_atiende"
                            confirm="El asistente vuelve a contestar a esta persona. ¿Seguir?"/>
                    <button name="action_crear_oportunidad" type="object" string="Crear oportunidad"
                            class="btn-secondary" invisible="oportunidad_id"/>
                    <button name="action_reintentar_envios" type="object" string="Reintentar envíos"
                            class="btn-secondary" invisible="por_enviar_count == 0"/>
                    <button name="action_cerrar" type="object" string="Cerrar" class="btn-secondary"
                            invisible="estado == 'cerrada'"/>
                    <field name="estado" widget="statusbar"/>
                </header>
                <sheet>
                    <field name="bot_atiende" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_ver_oportunidad" type="object" class="oe_stat_button" icon="fa-star"
                                invisible="not oportunidad_id">
                            <div class="o_stat_info"><span class="o_stat_text">Oportunidad</span></div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="celular"/>
                            <field name="canal"/>
                            <field name="id_externo" groups="base.group_no_one"/>
                        </group>
                        <group>
                            <field name="asignada_a" options="{'no_create': True}"/>
                            <field name="etiqueta_ids" widget="many2many_tags"
                                   options="{'color_field': 'color', 'no_create': True}"/>
                            <field name="pausada_hasta" invisible="estado != 'humano'"/>
                            <field name="ultima_actividad"/>
                            <field name="oportunidad_id" invisible="not oportunidad_id"/>
                        </group>
                    </group>
                    <div class="alert alert-secondary" role="alert" invisible="not nota_para_el_bot">
                        <strong>Nota para el asistente:</strong> <field name="nota_para_el_bot" class="d-inline"/>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="estado != 'humano'">
                        El asistente está en silencio con esta persona. Escribe abajo para contestarle; cada mensaje tuyo
                        renueva la pausa. Cuando termines, pulsa «Devolver al asistente».
                    </div>
                    <field name="chat_html" nolabel="1" readonly="1" class="o_dcasa_chat_campo"/>
                    <group string="Tu respuesta">
                        <field name="borrador" nolabel="1" colspan="2" placeholder="Escribe tu respuesta y pulsa «Enviar»…"/>
                        <field name="borrador_adjunto_ids" widget="many2many_binary" string="Adjuntar" colspan="2"/>
                    </group>
                    <div>
                        <button name="action_enviar" type="object" string="Enviar" class="btn-primary"/>
                    </div>
                    <notebook>
                        <page string="Seguimiento" name="seguimiento">
                            <group>
                                <group>
                                    <field name="seguimientos_enviados"/>
                                    <field name="ultimo_seguimiento_en"/>
                                    <field name="seguimiento_proximo"/>
                                </group>
                                <group>
                                    <field name="seguimiento_pedido_en"/>
                                    <field name="seguimiento_numero_pedido"/>
                                    <field name="por_enviar_count" string="Mensajes por enviar"/>
                                    <field name="mensajes_count"/>
                                </group>
                            </group>
                        </page>
                        <page string="Mensajes" name="mensajes">
                            <field name="mensaje_ids" readonly="1">
                                <list>
                                    <field name="ts"/>
                                    <field name="autor"/>
                                    <field name="texto"/>
                                    <field name="estado_envio" widget="badge"
                                           decoration-warning="estado_envio == 'por_enviar'"
                                           decoration-danger="estado_envio == 'fallido'"/>
                                    <field name="id_mensaje" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ===================== Búsqueda ===================== -->
    <record id="view_dcasa_conversacion_search" model="ir.ui.view">
        <field name="name">dcasa.conversacion.search</field>
        <field name="model">dcasa.conversacion</field>
        <field name="arch" type="xml">
            <search string="Conversaciones">
                <field name="partner_id"/>
                <field name="name"/>
                <field name="id_externo"/>
                <field name="ultimo_mensaje_texto"/>
                <field name="etiqueta_ids"/>
                <filter name="abiertas" string="Abiertas" domain="[('estado', '!=', 'cerrada')]"/>
                <filter name="esperan" string="Esperan tu respuesta"
                        domain="[('estado', '=', 'humano'), ('ultimo_mensaje_autor', '=', 'cliente')]"/>
                <filter name="con_humano" string="Con una vendedora" domain="[('estado', '=', 'humano')]"/>
                <filter name="con_bot" string="Con el asistente" domain="[('estado', '=', 'bot')]"/>
                <filter name="mis_conversaciones" string="Mías" domain="[('asignada_a', '=', uid)]"/>
                <separator/>
                <filter name="por_enviar" string="Con mensajes por enviar"
                        domain="[('mensaje_ids.estado_envio', 'in', ['por_enviar', 'fallido'])]"/>
                <filter name="con_seguimiento" string="Con seguimiento programado"
                        domain="[('seguimiento_proximo', '!=', False)]"/>
                <filter name="con_oportunidad" string="Con oportunidad" domain="[('oportunidad_id', '!=', False)]"/>
                <separator/>
                <filter name="actividad" string="Última actividad" date="ultima_actividad"/>
                <group>
                    <filter name="g_estado" string="Quién la atiende" context="{'group_by': 'estado'}"/>
                    <filter name="g_canal" string="Canal" context="{'group_by': 'canal'}"/>
                    <filter name="g_asignada" string="Vendedora" context="{'group_by': 'asignada_a'}"/>
                    <filter name="g_etiqueta" string="Etiqueta" context="{'group_by': 'etiqueta_ids'}"/>
                    <filter name="g_dia" string="Día" context="{'group_by': 'ultima_actividad:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dcasa_conversaciones" model="ir.actions.act_window">
        <field name="name">Conversaciones</field>
        <field name="res_model">dcasa.conversacion</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_abiertas': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aquí aparecen las conversaciones con tus clientes</p>
            <p>Cuando alguien escriba por WhatsApp o redes, el asistente contesta y la conversación queda aquí.
                Si una persona necesita a una vendedora, pulsa «Atender» y el asistente se queda en silencio.</p>
        </field>
    </record>
</odoo>
