<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_seguimientos" model="ir.cron">
        <field name="name">Juan: pedir los seguimientos que tocan</field>
        <field name="model_id" ref="model_dcasa_conversacion"/>
        <field name="state">code</field>
        <field name="code">model._cron_seguimientos()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_mantenimiento" model="ir.cron">
        <field name="name">Juan: reintentar envíos, avisos y pausas vencidas</field>
        <field name="model_id" ref="model_dcasa_conversacion"/>
        <field name="state">code</field>
        <field name="code">model._cron_mantenimiento()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <!-- Las cotizaciones del chatbot y de la web que nadie confirmó se cancelan solas (Ajustes de Juan, 3 días). -->
    <record id="ir_cron_cotizaciones_vencidas" model="ir.cron">
        <field name="name">Juan: cancelar las cotizaciones del chatbot y de la web que vencieron</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_dcasa_cancelar_vencidas()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
