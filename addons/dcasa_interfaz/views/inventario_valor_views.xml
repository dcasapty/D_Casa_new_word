<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- «Valor del inventario» (pedido de la dueña, 2026-11-02): la mercancía de hoy al costo y a precio de venta sin
         ITBMS. Pantalla propia (static/src/js/valor_inventario.js). La acción de cliente no lleva grupos: los ponen los
         menús y el servidor los exige en cada llamada (models/inventario_valor.py). Solo Gerencia y administradores. -->
    <record id="accion_valor_inventario" model="ir.actions.client">
        <field name="name">Valor del inventario</field>
        <field name="tag">dcasa_valor_inventario</field>
    </record>

    <menuitem id="menu_dcasa_valor_inventario" name="Valor del inventario" parent="stock.menu_stock_root"
              action="accion_valor_inventario" sequence="7"
              groups="sales_team.group_sale_manager,base.group_system"/>
    <menuitem id="menu_estadisticas_valor_inventario" name="Valor del inventario" parent="menu_estadisticas"
              action="accion_valor_inventario" sequence="2"/>
</odoo>
