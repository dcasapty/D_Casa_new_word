<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Aviso de pedido repetido (capturas de la dueña, 2026-10-16): antes de confirmar, si el mismo cliente ya tiene
         otro pedido del mismo día por el mismo total. No bloquea: puede ser una compra de verdad igual. -->
    <record id="sale_order_form_repetido" model="ir.ui.view">
        <field name="name">sale.order.form.dcasa.repetido</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0 o_dcasa_pedido_repetido" role="alert"
                     invisible="not dcasa_posible_repetido or state not in ('draft', 'sent')">
                    <i class="fa fa-clone me-2" aria-hidden="true"/>
                    Parece repetido: este cliente ya tiene el pedido <field name="dcasa_posible_repetido" readonly="1"
                    class="fw-bold"/> del mismo día por el mismo total. Si es la misma venta, no confirmes este:
                    cancélalo.
                </div>
                <div class="alert alert-warning mb-0 o_dcasa_pedido_repetido" role="alert"
                     invisible="not dcasa_posible_repetido or state != 'sale'">
                    <i class="fa fa-clone me-2" aria-hidden="true"/>
                    Parece repetido: este cliente también tiene el pedido <field name="dcasa_posible_repetido"
                    readonly="1" class="fw-bold"/> del mismo día por el mismo total. Si es la misma venta, cancela el
                    que sobra (el que no se facturó ni se cobró).
                </div>
            </xpath>
        </field>
    </record>
</odoo>
