<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dcasa_interfaz.Inicio">
        <div class="o_action o_dcasa_inicio">
            <t t-set="d" t-value="state.datos"/>
            <h2 class="visually-hidden">Resumen del día</h2>

            <!-- Saludo -->
            <header class="o_dcasa_inicio_hero">
                <div class="o_dcasa_inicio_hero_texto">
                    <div class="o_dcasa_inicio_fecha" t-out="d.fecha"/>
                    <h1>Hola, <t t-out="d.saludo"/></h1>
                    <p t-if="d.alcance === 'propio'">Así va tu día.</p>
                    <p t-else="">Así va el día en D'CASA.</p>
                </div>
                <!-- Solo los accesos que quien mira puede usar (permisos de obtener_datos). -->
                <div class="o_dcasa_inicio_accesos">
                    <button t-if="d.guia" class="btn btn-outline-primary o_dcasa_inicio_guia" t-on-click="abrirGuia">
                        <i class="fa fa-compass me-2"/>¿Qué necesito hacer?
                    </button>
                    <!-- Todos los botones del encabezado son azules (pedido del jefe, 2026-10-16). Quien vende cotiza:
                         «Nueva cotización» es el botón principal de todos (la vendedora arma el borrador y la factura se
                         hace en caja, desde esa cotización). la «Nueva factura» suelta y la vista previa del celular se retiraron:
                         una factura directa no tiene pedido ni nota de entrega, y la vista del celular sigue en el menú
                         Sitio web. Cobros y la tienda son de quien controla (d.permisos.completo). -->
                    <button t-if="d.permisos.cotizar" class="btn btn-primary o_dcasa_nueva_cotizacion"
                            t-on-click="() => this.nuevo('sale.order')">
                        <i class="fa fa-plus me-2"/>Nueva cotización
                    </button>
                    <button t-if="d.permisos.crear_cliente" class="btn btn-primary o_dcasa_nuevo_cliente"
                            t-on-click="() => this.nuevo('res.partner', {res_partner_search_mode: 'customer', default_customer_rank: 1})">
                        <i class="fa fa-user-plus me-2"/>Nuevo cliente
                    </button>
                    <button t-if="d.permisos.cobrar" class="btn btn-primary o_dcasa_registrar_cobro"
                            t-on-click="() => this.nuevo('account.payment', {default_payment_type: 'inbound', default_partner_type: 'customer'})">
                        <i class="fa fa-money me-2"/>Registrar cobro
                    </button>
                    <button t-if="d.permisos.completo" class="btn btn-primary o_dcasa_ver_tienda" t-on-click="verTienda"
                            title="Ver la tienda" aria-label="Ver la tienda">
                        <i class="fa fa-external-link"/>
                    </button>
                </div>
            </header>

            <div class="o_dcasa_inicio_cuerpo">
                <!-- Accesos directos: lo que más se abre, a un clic (sin buscar en el menú de la izquierda). -->
                <section t-if="d.atajos.length" class="o_dcasa_atajos" aria-label="Accesos directos">
                    <button t-foreach="d.atajos" t-as="a" t-key="a.clave" type="button"
                            t-attf-class="o_dcasa_atajo o_dcasa_atajo_{{a.clave}}" t-on-click="() => this.abrirAtajo(a)">
                        <span class="o_dcasa_atajo_icono"><i t-attf-class="fa {{a.icono}}"/></span>
                        <span class="o_dcasa_atajo_texto">
                            <strong t-out="a.titulo"/>
                            <span t-out="a.detalle"/>
                        </span>
                        <span t-if="a.cuenta" class="o_dcasa_atajo_cuenta" t-out="a.cuenta"/>
                    </button>
                </section>

                <!-- Tu meta del mes (bono por meta de ventas, solo quien está en el departamento de Ventas). Decisión de
                     la dueña (2026-10-16): la vendedora ve SOLO cuánto lleva en porcentaje, la barra y unas palabras de
                     ánimo. Ni la meta en dinero, ni el porcentaje del bono, ni lo cobrado, ni lo que falta: el servidor
                     tampoco los manda. -->
                <section t-if="d.meta" class="o_dcasa_meta" aria-label="Tu meta del mes">
                    <div class="o_dcasa_meta_cabeza">
                        <h2><i class="fa fa-bullseye" aria-hidden="true"/>Tu meta de <t t-out="d.meta.mes"/></h2>
                    </div>
                    <!-- La barra se llena hasta el 100 %; el número puede pasar del 100 %. -->
                    <div class="o_dcasa_meta_progreso">
                        <div class="o_dcasa_meta_porcentaje">
                            <strong t-out="d.meta.avance_real + ' %'"/>
                            <span>de tu meta</span>
                        </div>
                        <div class="o_dcasa_meta_barra" role="progressbar" aria-valuemin="0" aria-valuemax="100"
                             t-att-aria-valuenow="d.meta.avance"
                             t-att-aria-label="'Llevas el ' + d.meta.avance_real + ' % de tu meta'">
                            <span t-attf-style="width: {{ d.meta.avance }}%"/>
                        </div>
                    </div>
                    <!-- Las palabras de ánimo y, al lado, «Ver mis ventas»: las ventas que suman a su porcentaje
                         (pedido de la dueña, 2026-10-16). -->
                    <div class="o_dcasa_meta_pie">
                        <p t-if="d.meta.animo" class="o_dcasa_meta_animo" t-out="d.meta.animo"/>
                        <button t-if="d.meta.ventas" type="button" class="btn btn-primary o_dcasa_meta_ventas"
                                t-on-click="() => this.abrirLista(d.meta.ventas.accion)">
                            <i class="fa fa-list-ul me-2" aria-hidden="true"/>Ver mis ventas
                        </button>
                    </div>
                </section>

                <!-- Cotizaciones abiertas y entregas pendientes, lado a lado y justo debajo de los accesos azules: lo
                     que más se usa para cerrar en caja (pedido de la dueña, 2026-10-16). Cabecera azul con el número
                     en amarillo: el amarillo solo toca el azul. -->
                <div t-if="d.permisos.completo and (d.cotizaciones or d.entregas)" class="o_dcasa_listas">
                    <section t-if="d.cotizaciones" class="o_dcasa_panel o_dcasa_lista o_dcasa_lista_cotizaciones">
                        <div class="o_dcasa_lista_cabeza">
                            <h2><i class="fa fa-file-text-o" aria-hidden="true"/>Cotizaciones abiertas</h2>
                            <button type="button" class="o_dcasa_lista_cuenta o_dcasa_cifra_cotizaciones"
                                    t-on-click="() => this.abrirLista(d.cotizaciones.accion)">
                                <span class="o_dcasa_lista_numero" t-out="d.cotizaciones.cantidad"/>
                                <span><t t-out="dinero(d.cotizaciones.sin_itbms)"/> sin ITBMS</span>
                            </button>
                        </div>
                        <ul t-if="d.cotizaciones.filas.length" class="list-unstyled mb-0">
                            <li t-foreach="d.cotizaciones.filas" t-as="fila" t-key="fila.id">
                                <button type="button" class="o_dcasa_lista_fila"
                                        t-on-click="() => this.abrirRegistro('sale.order', fila.id)">
                                    <span class="o_dcasa_lista_texto">
                                        <strong t-out="fila.cliente or fila.nombre"/>
                                        <small><t t-out="fila.nombre"/><t t-if="fila.vendedora"> · <t t-out="fila.vendedora"/></t></small>
                                    </span>
                                    <span class="o_dcasa_lista_dato">
                                        <strong t-out="dinero(fila.total)"/> <small>con ITBMS</small>
                                        <small t-out="espera(fila.dias)"/>
                                    </span>
                                </button>
                            </li>
                        </ul>
                        <p t-else="" class="o_dcasa_vacio">No hay cotizaciones abiertas.</p>
                        <p t-if="d.cotizaciones.cantidad > d.cotizaciones.filas.length" class="o_dcasa_lista_pie">
                            Las más antiguas primero. <button type="button" class="btn btn-link p-0"
                                t-on-click="() => this.abrirLista(d.cotizaciones.accion)">Ver las <t t-out="d.cotizaciones.cantidad"/></button>
                        </p>
                    </section>
                    <section t-if="d.entregas" class="o_dcasa_panel o_dcasa_lista o_dcasa_lista_entregas">
                        <div class="o_dcasa_lista_cabeza">
                            <h2><i class="fa fa-truck" aria-hidden="true"/>Entregas pendientes</h2>
                            <button type="button" class="o_dcasa_lista_cuenta o_dcasa_cifra_entregas"
                                    t-on-click="() => this.abrirLista(d.entregas.accion)">
                                <span class="o_dcasa_lista_numero" t-out="d.entregas.cantidad"/>
                                <span>por despachar o retirar</span>
                            </button>
                        </div>
                        <ul t-if="d.entregas.filas.length" class="list-unstyled mb-0">
                            <li t-foreach="d.entregas.filas" t-as="fila" t-key="fila.id">
                                <button type="button" class="o_dcasa_lista_fila"
                                        t-on-click="() => this.abrirRegistro('stock.picking', fila.id)">
                                    <span class="o_dcasa_lista_texto">
                                        <strong t-out="fila.cliente or fila.nombre"/>
                                        <small><t t-out="fila.nombre"/><t t-if="fila.origen"> · <t t-out="fila.origen"/></t></small>
                                    </span>
                                    <span class="o_dcasa_lista_dato">
                                        <strong t-out="fila.listo ? 'Lista' : 'Falta mercancía'"/>
                                        <small t-out="espera(fila.dias)"/>
                                    </span>
                                </button>
                            </li>
                        </ul>
                        <p t-else="" class="o_dcasa_vacio">No hay entregas pendientes.</p>
                        <p t-if="d.entregas.cantidad > d.entregas.filas.length" class="o_dcasa_lista_pie">
                            Las más antiguas primero. <button type="button" class="btn btn-link p-0"
                                t-on-click="() => this.abrirLista(d.entregas.accion)">Ver las <t t-out="d.entregas.cantidad"/></button>
                        </p>
                    </section>
                </div>

                <!-- Atención: lo que conviene mirar hoy (productos por agotarse, sin costo cargado…). -->
                <section t-if="d.atencion.length" class="o_dcasa_atencion" aria-label="Atención">
                    <button t-foreach="d.atencion" t-as="aviso" t-key="aviso.clave" type="button"
                            t-attf-class="o_dcasa_aviso o_dcasa_aviso_{{aviso.clave}}"
                            t-on-click="() => this.abrirLista(aviso.accion)">
                        <i t-attf-class="fa {{aviso.icono}}" aria-hidden="true"/>
                        <span t-out="aviso.texto"/>
                    </button>
                </section>

                <!-- Ventas por periodo: Hoy · Esta semana · Este mes · un rango. Las cifras de ventas van SIN ITBMS (el
                     ITBMS es de la DGI); el ITBMS y el total van al lado. La ganancia solo la ve Gerencia. -->
                <section t-if="d.ventas and d.permisos.completo" class="o_dcasa_ventas" aria-label="Ventas">
                    <!-- Qué facturas contar (decisión del jefe, 2026-10-17: el Inicio cuenta las facturas, como
                         Contabilidad): «Facturado» (todas, por su fecha), «Con abonos» (con al menos un abono, por su valor
                         total) o «Completadas» (pagadas al 100 %, el día del último pago). Abre en la que diga el servidor
                         (d.base). Cambia las tarjetas, Comparar, la gráfica de la semana y lo más vendido. Al lado, la
                         vendedora (solo Gerencia). -->
                    <div t-if="d.bases and d.bases.length" class="o_dcasa_base_ventas">
                        <div class="o_dcasa_base_fila">
                            <div class="o_dcasa_interruptor" role="radiogroup" aria-label="Qué facturas contar">
                                <button t-foreach="d.bases" t-as="b" t-key="b.clave" type="button" role="radio"
                                        t-attf-class="o_dcasa_interruptor_opcion o_dcasa_base_{{b.clave}}"
                                        t-att-class="{'o_activo': state.base === b.clave}"
                                        t-att-aria-checked="state.base === b.clave ? 'true' : 'false'"
                                        t-on-click="() => this.cambiarBase(b.clave)" t-out="b.nombre"/>
                            </div>
                            <label t-if="d.comparar" class="o_dcasa_vendedora">
                                <span class="visually-hidden">Vendedora</span>
                                <select class="form-select o_dcasa_vendedora_select" t-on-change="cambiarVendedor">
                                    <option value="" t-att-selected="state.vendedor === ''">Todo el equipo</option>
                                    <option t-foreach="d.comparar.vendedoras" t-as="v" t-key="v.id" t-att-value="v.id"
                                            t-att-selected="vendedorElegido(v)" t-out="v.nombre"/>
                                </select>
                            </label>
                        </div>
                        <p class="o_dcasa_base_detalle" t-out="detalleBase"/>
                    </div>
                    <div class="o_dcasa_ventas_cabeza">
                        <!-- El ⓘ: en qué se aparta de Contabilidad (solo si se aparta: en «Facturado» es lo mismo). -->
                        <h2 class="o_dcasa_con_ayuda">Ventas
                            <button t-if="d.ventas.cuadre" type="button"
                                    class="o_dcasa_ayuda_boton o_dcasa_ayuda_boton_ventas"
                                    aria-label="Por qué no es igual a Contabilidad" aria-controls="o_dcasa_ayuda_ventas"
                                    t-att-aria-expanded="state.ayuda === 'ventas' ? 'true' : 'false'"
                                    t-on-click="() => this.alternarAyuda('ventas')"
                                    t-on-keydown="(ev) => this.teclaEnAyuda(ev, 'ventas')">
                                <i class="fa fa-info-circle" aria-hidden="true"/>
                            </button>
                        </h2>
                        <div class="o_dcasa_periodos" role="tablist" aria-label="Periodo de las ventas">
                            <button t-foreach="periodos" t-as="per" t-key="per.clave" type="button" role="tab"
                                    t-attf-class="o_dcasa_periodo o_dcasa_periodo_{{per.clave}}"
                                    t-att-class="{'o_activo': state.periodo === per.clave}"
                                    t-att-aria-selected="state.periodo === per.clave ? 'true' : 'false'"
                                    t-on-click="() => this.cambiarPeriodo(per.clave)" t-out="per.nombre"/>
                        </div>
                    </div>
                    <div t-if="state.ayuda === 'ventas' and d.ventas.cuadre" id="o_dcasa_ayuda_ventas"
                         class="o_dcasa_ayuda_texto o_dcasa_ayuda_texto_ventas" role="note" tabindex="-1"
                         t-on-keydown="(ev) => this.teclaEnAyuda(ev, 'ventas')">
                        <p>Contabilidad dice <strong t-out="dinero(d.ventas.cuadre.contables)"/> sin ITBMS para estas
                            fechas: <strong t-out="dinero(Math.abs(d.ventas.cuadre.diferencia))"/>
                            <t t-out="d.ventas.cuadre.diferencia > 0 ? ' más' : ' menos'"/> que aquí.</p>
                        <p t-if="d.ventas.base === 'con_abonos'">Aquí se cuentan las facturas con al menos un abono; allá,
                            todas las facturas por su fecha.</p>
                        <p t-elif="d.ventas.base === 'completadas'">Aquí se cuentan las facturas pagadas al 100 %, el día
                            del último pago; allá, todas las facturas por su fecha.</p>
                        <p t-else="">Algo que no es una factura de cliente tocó los ingresos de esas fechas (por ejemplo, un
                            asiento a mano).</p>
                        <button t-if="d.ventas.cuadre.cuantas" type="button" class="btn btn-link p-0 o_dcasa_ayuda_ver"
                                t-on-click="() => this.abrirLista(d.ventas.cuadre.accion)">
                            Ver <t t-out="d.ventas.cuadre.cuantas === 1 ? 'esa factura' : 'esas ' + d.ventas.cuadre.cuantas + ' facturas'"/>
                        </button>
                    </div>
                    <form t-if="state.periodo === 'rango'" class="o_dcasa_rango" t-on-submit.prevent="aplicarRango">
                        <label>Del <input type="date" class="form-control o_dcasa_rango_desde" t-model="state.desde"
                                          t-att-max="hoyIso"/></label>
                        <label>al <input type="date" class="form-control o_dcasa_rango_hasta" t-model="state.hasta"
                                         t-att-max="hoyIso"/></label>
                        <button type="submit" class="btn btn-primary">Ver</button>
                        <span t-if="state.errorRango" class="o_dcasa_error" role="alert" t-out="state.errorRango"/>
                    </form>
                    <div t-attf-class="o_dcasa_ventas_cuerpo {{state.cargandoVentas ? 'o_cargando' : ''}}">
                        <div class="o_dcasa_ventas_columna o_dcasa_ventas_principal">
                            <span class="o_dcasa_ventas_etiqueta" t-out="d.ventas.etiqueta"/>
                            <button type="button" class="o_dcasa_ventas_valor o_dcasa_cifra_ventas_hoy"
                                    t-on-click="() => this.abrirLista(d.ventas.accion)">
                                <span t-out="dinero(d.ventas.actual.sin_itbms)"/>
                            </button>
                            <span class="o_dcasa_ventas_nota">Ventas sin ITBMS ·
                                <t t-out="d.ventas.actual.cuantas"/>
                                <t t-if="d.ventas.base === 'vendido'" t-out="d.ventas.actual.cuantas === 1 ? ' venta' : ' ventas'"/>
                                <t t-else="" t-out="d.ventas.actual.cuantas === 1 ? ' factura' : ' facturas'"/>
                                <t t-if="d.ventas.actual.notas"> · <t t-out="d.ventas.actual.notas"/>
                                    <t t-out="d.ventas.actual.notas === 1 ? ' nota de crédito' : ' notas de crédito'"/></t></span>
                            <!-- Ticket promedio (K1): ventas sin ITBMS ÷ N.º de ventas, el mismo de Comparar; sin ventas, «—». -->
                            <span class="o_dcasa_ticket">Ticket promedio <strong
                                    t-out="d.ventas.actual.ticket === null ? '—' : dinero(d.ventas.actual.ticket)"/></span>
                            <!-- «Facturado»: cuántas de esas facturas salieron de un pedido de una vendedora (decisión A1). -->
                            <span t-if="deUnPedidoTexto" class="o_dcasa_de_pedido" t-out="deUnPedidoTexto"/>
                            <span class="o_dcasa_desglose">
                                <span>ITBMS <strong t-out="dinero(d.ventas.actual.itbms)"/></span>
                                <span>Total con ITBMS <strong t-out="dinero(d.ventas.actual.total)"/></span>
                                <span t-if="d.ventas.actual.falta_por_cobrar !== null and d.ventas.actual.falta_por_cobrar !== undefined"
                                      class="o_dcasa_falta">Falta por cobrar <strong t-out="dinero(d.ventas.actual.falta_por_cobrar)"/> con ITBMS</span>
                            </span>
                        </div>
                        <div t-if="d.ve_utilidad and d.ventas.actual.ganancia" class="o_dcasa_ventas_columna o_dcasa_ganancia">
                            <span class="o_dcasa_ventas_etiqueta o_dcasa_con_ayuda">Ganancia bruta
                                <button type="button" class="o_dcasa_ayuda_boton o_dcasa_ayuda_boton_ganancia"
                                        aria-label="Qué es la ganancia bruta" aria-controls="o_dcasa_ayuda_ganancia"
                                        t-att-aria-expanded="state.ayuda === 'ganancia' ? 'true' : 'false'"
                                        t-on-click="() => this.alternarAyuda('ganancia')"
                                        t-on-keydown="(ev) => this.teclaEnAyuda(ev, 'ganancia')">
                                    <i class="fa fa-info-circle" aria-hidden="true"/>
                                </button>
                            </span>
                            <span class="o_dcasa_ventas_valor o_dcasa_ganancia_valor"
                                  t-out="dinero(d.ventas.actual.ganancia.valor)"/>
                            <span class="o_dcasa_ventas_nota">
                                <t t-if="d.ventas.actual.ganancia.porcentaje !== null"><t t-out="d.ventas.actual.ganancia.porcentaje"/> % de la venta de mercancía · </t>sin ITBMS
                            </span>
                            <!-- Lo que explica la cifra (la regla del costo) va en el ⓘ, no a la vista. -->
                            <div t-if="state.ayuda === 'ganancia'" id="o_dcasa_ayuda_ganancia"
                                 class="o_dcasa_ayuda_texto o_dcasa_ayuda_texto_ganancia" role="note" tabindex="-1"
                                 t-on-keydown="(ev) => this.teclaEnAyuda(ev, 'ganancia')">
                                <p>Venta menos el costo de la mercancía, sin ITBMS. No resta gastos (alquiler, planilla,
                                    luz).</p>
                                <p>Cada venta de un pedido usa el costo guardado el día en que se confirmó. Las facturas sin
                                    pedido y las ventas hechas antes de esta pantalla usan el costo de hoy del producto.</p>
                            </div>
                            <span t-if="d.ventas.actual.ganancia.ventas_sin_costo" class="o_dcasa_ventas_aviso o_dcasa_sin_costo">
                                <i class="fa fa-exclamation-circle" aria-hidden="true"/>
                                <t t-out="d.ventas.actual.ganancia.ventas_sin_costo"/>
                                <t t-out="d.ventas.actual.ganancia.ventas_sin_costo === 1 ? ' factura tiene mercancía sin costo y no cuenta aquí' : ' facturas tienen mercancía sin costo y no cuentan aquí'"/>
                            </span>
                        </div>
                        <!-- Unidades vendidas por tipo (K1, 2026-10-18): de las mismas facturas, por la categoría de
                             primer nivel; las notas de crédito restan; pasados 8 tipos, «Otros». -->
                        <div t-if="d.ventas.unidades" class="o_dcasa_ventas_columna o_dcasa_tipos">
                            <span class="o_dcasa_ventas_etiqueta">Unidades vendidas</span>
                            <ul t-if="d.ventas.unidades.tipos.length" class="list-unstyled mb-0">
                                <li t-foreach="d.ventas.unidades.tipos" t-as="t" t-key="t_index" class="o_dcasa_tipo">
                                    <span class="o_dcasa_tipo_nombre" t-out="t.tipo"/>
                                    <span class="o_dcasa_tipo_unidades" t-out="unidades(t.unidades)"/>
                                </li>
                                <li class="o_dcasa_tipo o_dcasa_tipo_total">
                                    <span class="o_dcasa_tipo_nombre">Total</span>
                                    <span class="o_dcasa_tipo_unidades" t-out="unidades(d.ventas.unidades.total)"/>
                                </li>
                            </ul>
                            <p t-else="" class="o_dcasa_vacio mb-0">Sin unidades vendidas en estas fechas.</p>
                        </div>
                    </div>

                    <!-- Comparar (pedido del jefe, aprobado por la dueña, 2026-10-17): números, no frases. Cada botón es
                         una comparación completa (A contra B); al tocarlo sale una tabla. Si A termina hoy, hoy cuenta
                         hasta la hora actual y el otro día hasta la misma hora (el reloj de la tabla lo dice). -->
                    <div t-if="d.comparar" class="o_dcasa_comparar" role="region" aria-label="Comparar">
                        <div class="o_dcasa_comparar_cabeza">
                            <h3>Comparar</h3>
                            <button t-if="state.cmp.datos" type="button" class="btn btn-outline-primary o_dcasa_por_vendedora_boton"
                                    t-att-aria-pressed="state.cmp.porVendedora ? 'true' : 'false'"
                                    t-on-click="alternarPorVendedora">
                                <i class="fa fa-users me-2" aria-hidden="true"/>Por vendedora
                            </button>
                        </div>
                        <div class="o_dcasa_chips" role="tablist" aria-label="Con qué comparar">
                            <button t-foreach="d.comparar.chips" t-as="chip" t-key="chip.clave" type="button" role="tab"
                                    t-attf-class="o_dcasa_chip o_dcasa_chip_{{chip.clave}}"
                                    t-att-class="{'o_activo': state.cmp.clave === chip.clave}"
                                    t-att-aria-selected="state.cmp.clave === chip.clave ? 'true' : 'false'"
                                    t-on-click="() => this.elegirComparacion(chip.clave)">
                                <t t-out="chip.etiqueta"/><i t-if="chip.clave === 'mes'" class="fa fa-caret-down ms-1" aria-hidden="true"/>
                            </button>
                        </div>
                        <!-- «Mes ▾»: lo que va del mes contra un mes completo (por defecto el pasado; los últimos 24). -->
                        <label t-if="state.cmp.clave === 'mes'" class="o_dcasa_comparar_mes">
                            <span class="visually-hidden">Mes completo para comparar</span>
                            <select class="form-select o_dcasa_comparar_mes_select" t-on-change="cambiarMes">
                                <option t-foreach="d.comparar.meses" t-as="m" t-key="m.valor" t-att-value="m.valor"
                                        t-att-selected="state.cmp.mes === m.valor" t-out="m.nombre"/>
                            </select>
                        </label>
                        <!-- «A vs B»: B se propone del mismo largo que A (solo se elige dónde empieza); «Libre», cualquier largo. -->
                        <form t-if="state.cmp.clave === 'rango'" class="o_dcasa_comparar_rango" t-on-submit.prevent="aplicarRangoComparar">
                            <fieldset class="o_dcasa_comparar_lado">
                                <legend>A</legend>
                                <input type="date" class="form-control o_dcasa_cmp_a_desde" aria-label="A desde"
                                       t-model="state.cmp.aDesde" t-att-max="hoyComparar"/>
                                <span aria-hidden="true">–</span>
                                <input type="date" class="form-control o_dcasa_cmp_a_hasta" aria-label="A hasta"
                                       t-model="state.cmp.aHasta" t-att-max="hoyComparar"/>
                            </fieldset>
                            <fieldset class="o_dcasa_comparar_lado">
                                <legend>B</legend>
                                <input type="date" class="form-control o_dcasa_cmp_b_desde" aria-label="B desde"
                                       t-model="state.cmp.bDesde" t-att-max="hoyComparar"/>
                                <span aria-hidden="true">–</span>
                                <input t-if="state.cmp.libre" type="date" class="form-control o_dcasa_cmp_b_hasta"
                                       aria-label="B hasta" t-model="state.cmp.bHasta" t-att-max="hoyComparar"/>
                                <span t-else="" class="o_dcasa_cmp_b_propuesto" t-out="state.cmp.datos ? state.cmp.datos.b.etiqueta : ''"/>
                            </fieldset>
                            <label class="o_dcasa_libre form-check form-switch">
                                <input type="checkbox" class="form-check-input o_dcasa_cmp_libre" role="switch"
                                       t-att-checked="state.cmp.libre" t-on-change="alternarLibre"/>
                                <span class="form-check-label">Libre</span>
                            </label>
                            <button type="submit" class="btn btn-primary o_dcasa_cmp_ver">Ver</button>
                        </form>
                        <p t-if="state.cmp.error" class="o_dcasa_error o_dcasa_comparar_error" role="alert" t-out="state.cmp.error"/>
                        <t t-set="cd" t-value="state.cmp.datos"/>
                        <div t-if="cd and state.cmp.clave" t-attf-class="o_dcasa_comparar_cuerpo {{state.cmp.cargando ? 'o_cargando' : ''}}"
                             t-att-data-comparacion="cd.comparacion" t-att-data-base="cd.base">
                            <p t-if="cd.llevas" class="o_dcasa_llevas" t-out="llevasTexto"/>
                            <p t-if="cd.hora" class="o_dcasa_comparar_hora"
                               t-att-title="'Hoy y el día con que se compara, hasta las ' + cd.hora">
                                <i class="fa fa-clock-o" aria-hidden="true"/>
                                <span class="visually-hidden">Hasta las </span><t t-out="cd.hora"/>
                            </p>
                            <table class="o_dcasa_comparar_tabla">
                                <thead>
                                    <tr>
                                        <th scope="col"><span class="visually-hidden">Cifra</span></th>
                                        <th scope="col" class="o_dcasa_cmp_a" t-out="cd.a.etiqueta"/>
                                        <th scope="col" class="o_dcasa_cmp_b" t-out="cd.b.etiqueta"/>
                                        <th scope="col" class="o_dcasa_cmp_cambio">
                                            <t t-if="cabeceraCambio" t-out="cabeceraCambio"/>
                                            <span t-else="" class="visually-hidden">Cambio</span>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="cd.filas" t-as="fila" t-key="fila.clave" t-attf-class="o_dcasa_cmp_fila_{{fila.clave}}">
                                        <th scope="row"><t t-out="fila.nombre"/><small t-if="fila.nota" t-out="fila.nota"/></th>
                                        <td class="o_dcasa_cmp_a" t-out="valorFila(fila, fila.a)"/>
                                        <td class="o_dcasa_cmp_b" t-out="valorFila(fila, fila.b)"/>
                                        <td t-attf-class="o_dcasa_cmp_cambio {{cambioClase(fila.cambio)}}" t-out="cambioTexto(fila.cambio)"/>
                                    </tr>
                                </tbody>
                            </table>
                            <!-- Una fila por vendedora: ventas A, ventas B y el cambio; al tocarla, el selector queda en ella. -->
                            <div t-if="state.cmp.porVendedora and cd.por_vendedora" class="o_dcasa_por_vendedora">
                                <div class="o_dcasa_pv_cabeza" aria-hidden="true">
                                    <span/>
                                    <span t-out="cd.a.etiqueta"/>
                                    <span t-out="cd.b.etiqueta"/>
                                    <span t-out="cabeceraCambio"/>
                                </div>
                                <ul class="list-unstyled mb-0">
                                    <li t-foreach="cd.por_vendedora" t-as="pv" t-key="pv.vendedor">
                                        <button type="button" class="o_dcasa_pv_fila" t-on-click="() => this.elegirVendedora(pv)"
                                                t-att-aria-label="pv.nombre + ': ' + dinero(pv.a) + ' contra ' + dinero(pv.b) + ', ' + cambioTexto(pv.cambio)">
                                            <span class="o_dcasa_pv_nombre" t-out="pv.nombre"/>
                                            <span class="o_dcasa_pv_a" t-out="dinero(pv.a)"/>
                                            <span class="o_dcasa_pv_b" t-out="dinero(pv.b)"/>
                                            <span t-attf-class="o_dcasa_pv_cambio {{cambioClase(pv.cambio)}}" t-out="cambioTexto(pv.cambio)"/>
                                        </button>
                                    </li>
                                </ul>
                                <p t-if="!cd.por_vendedora.length" class="o_dcasa_vacio">Sin ventas en estas fechas.</p>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Cifras del día. Quien controla ya ve Ventas, Cotizaciones y Entregas en sus paneles de arriba. -->
                <section class="o_dcasa_cifras" aria-label="Cifras del día">
                    <t t-foreach="d.cifras" t-as="c" t-key="c.clave">
                        <button t-if="!(d.permisos.completo and ['ventas_hoy', 'cotizaciones', 'entregas'].includes(c.clave))"
                                type="button" t-attf-class="o_dcasa_cifra o_dcasa_cifra_{{c.clave}}"
                                t-on-click="() => this.abrirCifra(c)">
                            <span class="o_dcasa_cifra_icono"><i t-attf-class="fa {{icono(c)}}"/></span>
                            <span class="o_dcasa_cifra_titulo" t-out="c.titulo"/>
                            <span class="o_dcasa_cifra_valor" t-out="cifra(c)"/>
                            <span class="o_dcasa_cifra_detalle">
                                <t t-if="c.nota"><t t-out="c.nota"/> · </t>
                                <t t-if="c.detalle_moneda !== undefined">Por <t t-out="dinero(c.detalle_moneda)"/> con ITBMS</t>
                                <t t-else="" t-out="c.detalle"/>
                            </span>
                            <span t-if="c.itbms !== undefined and d.alcance === 'propio'" class="o_dcasa_cifra_detalle">
                                ITBMS <t t-out="dinero(c.itbms)"/> · con ITBMS <t t-out="dinero(c.total_con_itbms)"/>
                            </span>
                        </button>
                    </t>
                </section>

                <!-- Caja (rol D'CASA, 2026-10-17): la caja de hoy de toda la tienda, sin el panel completo de quien
                     controla. Quien controla la ve dentro de su fila, más abajo. -->
                <section t-if="d.permisos.ver_cobros and !d.permisos.completo"
                         class="o_dcasa_panel o_dcasa_caja o_dcasa_caja_rol" aria-label="Caja de hoy">
                    <h2>Caja de hoy <small class="o_dcasa_sin_itbms">con ITBMS</small></h2>
                    <p t-if="d.cobros.length" class="o_dcasa_caja_total">
                        Cobrado hoy <strong t-out="dinero(d.total_cobrado)"/>
                    </p>
                    <ul t-if="d.cobros.length" class="list-unstyled mb-0">
                        <li t-foreach="d.cobros" t-as="cobro" t-key="cobro.forma">
                            <span t-out="cobro.forma"/>
                            <strong t-out="dinero(cobro.monto)"/>
                        </li>
                    </ul>
                    <p t-else="" class="o_dcasa_vacio">Todavía no hay cobros registrados hoy.</p>
                </section>

                <div t-if="d.permisos.completo" class="o_dcasa_inicio_fila">
                    <!-- Semana -->
                    <!-- La semana y lo más vendido siguen el interruptor y la vendedora (2026-10-17): la etiqueta dice cuáles. -->
                    <section t-if="d.semana.length" t-attf-class="o_dcasa_panel o_dcasa_semana {{state.cargandoGrafica ? 'o_cargando' : ''}}">
                        <h2>Ventas de la semana <small class="o_dcasa_sin_itbms"><t t-if="nombreBase"><t t-out="nombreBase"/> · </t>sin ITBMS<t t-if="nombreVendedora"> · <t t-out="nombreVendedora"/></t></small></h2>
                        <div class="o_dcasa_grafico">
                            <div t-foreach="d.semana" t-as="dia" t-key="dia_index" role="img" tabindex="0"
                                 t-attf-class="o_dcasa_grafico_barra {{dia.hoy ? 'o_dcasa_grafico_hoy' : ''}}"
                                 t-att-aria-label="dia.dia + ': ' + dinero(dia.monto) + ' sin ITBMS'"
                                 t-attf-style="--alto: {{ Math.max(3, dia.monto / maxSemana * 82) }}%">
                                <span class="o_dcasa_grafico_monto" aria-hidden="true" t-out="dinero(dia.monto)"/>
                                <span class="o_dcasa_grafico_relleno"
                                      t-attf-style="height: {{ Math.max(3, dia.monto / maxSemana * 82) }}%"/>
                            </div>
                        </div>
                        <div class="o_dcasa_grafico_dias" aria-hidden="true">
                            <span t-foreach="d.semana" t-as="dia" t-key="dia_index" t-att-class="{'o_hoy': dia.hoy}"
                                  t-out="dia.hoy ? 'Hoy' : dia.dia"/>
                        </div>
                    </section>

                    <!-- Cobros por forma de pago -->
                    <section t-if="d.permisos.ver_cobros" class="o_dcasa_panel o_dcasa_caja">
                        <h2>Caja de hoy <small class="o_dcasa_sin_itbms">con ITBMS</small></h2>
                        <p t-if="d.cobros.length" class="o_dcasa_caja_total">
                            Cobrado hoy <strong t-out="dinero(d.total_cobrado)"/>
                        </p>
                        <ul t-if="d.cobros.length" class="list-unstyled mb-0">
                            <li t-foreach="d.cobros" t-as="cobro" t-key="cobro.forma">
                                <span t-out="cobro.forma"/>
                                <strong t-out="dinero(cobro.monto)"/>
                            </li>
                        </ul>
                        <p t-else="" class="o_dcasa_vacio">Todavía no hay cobros registrados hoy.</p>
                    </section>

                    <!-- Lo más vendido -->
                    <section t-attf-class="o_dcasa_panel o_dcasa_top {{state.cargandoGrafica ? 'o_cargando' : ''}}">
                        <h2>Lo más vendido <small class="o_dcasa_sin_itbms">últimos 30 días<t t-if="nombreBase"> · <t t-out="nombreBase"/></t><t t-if="nombreVendedora"> · <t t-out="nombreVendedora"/></t></small></h2>
                        <ol t-if="d.top.length" class="list-unstyled mb-0">
                            <li t-foreach="d.top" t-as="p" t-key="p.id" tabindex="0" role="button" t-on-click="() => this.abrirProducto(p)" t-on-keydown="(ev) => ev.key === 'Enter' and this.abrirProducto(p)">
                                <img t-att-src="p.imagen" alt="" loading="lazy"/>
                                <span class="o_dcasa_top_nombre" t-out="p.nombre"/>
                                <span class="o_dcasa_top_cantidad"><t t-out="p.cantidad"/> u.</span>
                            </li>
                        </ol>
                        <p t-else="" class="o_dcasa_vacio">Aún no hay ventas este mes.</p>
                    </section>
                </div>

                <!-- Apps -->
                <section class="o_dcasa_apps" aria-label="Aplicaciones">
                    <h2>Aplicaciones</h2>
                    <div class="o_dcasa_apps_grilla">
                        <button t-foreach="apps" t-as="app" t-key="app.id" type="button" class="o_dcasa_app"
                                t-on-click="() => this.abrirApp(app)">
                            <img t-if="iconoApp(app)" t-att-src="iconoApp(app)" alt=""/>
                            <span t-else="" class="o_dcasa_app_letra" t-out="app.name[0]"/>
                            <span class="o_dcasa_app_nombre" t-out="app.name"/>
                        </button>
                    </div>
                </section>
            </div>
        </div>
    </t>
</templates>
