<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dcasa_interfaz.Inicio">
        <div class="o_action o_dcasa_inicio">
            <t t-set="d" t-value="state.datos"/>
            <h2 class="visually-hidden">Resumen del día</h2>

            <!-- Saludo -->
            <header class="o_dcasa_inicio_hero">
                <div class="o_dcasa_inicio_hero_texto">
                    <div class="o_dcasa_inicio_fecha" t-out="d.fecha"/>
                    <h1>Hola, <t t-out="d.saludo"/></h1>
                    <p>Así va el día en D'CASA.</p>
                </div>
                <!-- Solo los accesos que quien mira puede usar (permisos de obtener_datos). -->
                <div class="o_dcasa_inicio_accesos">
                    <button t-if="d.permisos.cotizar" class="btn btn-primary" t-on-click="() => this.nuevo('sale.order')">
                        <i class="fa fa-plus me-2"/>Nueva cotización
                    </button>
                    <button t-if="d.permisos.crear_cliente" class="btn btn-secondary"
                            t-on-click="() => this.nuevo('res.partner')">
                        <i class="fa fa-user-plus me-2"/>Nuevo cliente
                    </button>
                    <button t-if="d.permisos.cobrar" class="btn btn-secondary"
                            t-on-click="() => this.nuevo('account.payment', {default_payment_type: 'inbound', default_partner_type: 'customer'})">
                        <i class="fa fa-money me-2"/>Registrar cobro
                    </button>
                    <button t-if="d.permisos.catalogo" class="btn btn-secondary" t-on-click="catalogo">
                        <i class="fa fa-th-large me-2"/>Catálogo
                    </button>
                    <button class="btn btn-secondary" t-on-click="verTienda">
                        <i class="fa fa-external-link me-2"/>Ver la tienda
                    </button>
                    <button class="btn btn-secondary" t-on-click="vistaPrevia" title="El sitio como se ve en un teléfono">
                        <i class="fa fa-mobile me-2"/>Ver en el celular
                    </button>
                </div>
            </header>

            <div class="o_dcasa_inicio_cuerpo">
                <!-- Cifras del día -->
                <section class="o_dcasa_cifras" aria-label="Cifras del día">
                    <button t-foreach="d.cifras" t-as="c" t-key="c.clave" type="button"
                            t-attf-class="o_dcasa_cifra o_dcasa_cifra_{{c.clave}}" t-on-click="() => this.abrirCifra(c)">
                        <span class="o_dcasa_cifra_icono"><i t-attf-class="fa {{icono(c)}}"/></span>
                        <span class="o_dcasa_cifra_titulo" t-out="c.titulo"/>
                        <span class="o_dcasa_cifra_valor" t-out="cifra(c)"/>
                        <span class="o_dcasa_cifra_detalle">
                            <t t-if="c.detalle_moneda !== undefined">Por <t t-out="dinero(c.detalle_moneda)"/></t>
                            <t t-else="" t-out="c.detalle"/>
                        </span>
                    </button>
                </section>

                <div class="o_dcasa_inicio_fila">
                    <!-- Semana -->
                    <section t-if="d.semana.length" class="o_dcasa_panel o_dcasa_semana">
                        <h2>Ventas de la semana</h2>
                        <div class="o_dcasa_grafico">
                            <div t-foreach="d.semana" t-as="dia" t-key="dia_index" role="img" tabindex="0"
                                 t-attf-class="o_dcasa_grafico_barra {{dia.hoy ? 'o_dcasa_grafico_hoy' : ''}}"
                                 t-att-aria-label="dia.dia + ': ' + dinero(dia.monto)"
                                 t-attf-style="--alto: {{ Math.max(3, dia.monto / maxSemana * 82) }}%">
                                <span class="o_dcasa_grafico_monto" aria-hidden="true" t-out="dinero(dia.monto)"/>
                                <span class="o_dcasa_grafico_relleno"
                                      t-attf-style="height: {{ Math.max(3, dia.monto / maxSemana * 82) }}%"/>
                            </div>
                        </div>
                        <div class="o_dcasa_grafico_dias" aria-hidden="true">
                            <span t-foreach="d.semana" t-as="dia" t-key="dia_index" t-att-class="{'o_hoy': dia.hoy}"
                                  t-out="dia.hoy ? 'Hoy' : dia.dia"/>
                        </div>
                    </section>

                    <!-- Cobros por forma de pago -->
                    <section t-if="d.permisos.ver_cobros" class="o_dcasa_panel o_dcasa_caja">
                        <h2>Caja de hoy</h2>
                        <ul t-if="d.cobros.length" class="list-unstyled mb-0">
                            <li t-foreach="d.cobros" t-as="cobro" t-key="cobro.forma">
                                <span t-out="cobro.forma"/>
                                <strong t-out="dinero(cobro.monto)"/>
                            </li>
                        </ul>
                        <p t-else="" class="o_dcasa_vacio">Todavía no hay cobros registrados hoy.</p>
                    </section>

                    <!-- Lo más vendido -->
                    <section class="o_dcasa_panel o_dcasa_top">
                        <h2>Lo más vendido del mes</h2>
                        <ol t-if="d.top.length" class="list-unstyled mb-0">
                            <li t-foreach="d.top" t-as="p" t-key="p.id" tabindex="0" role="button" t-on-click="() => this.abrirProducto(p)" t-on-keydown="(ev) => ev.key === 'Enter' and this.abrirProducto(p)">
                                <img t-att-src="p.imagen" alt="" loading="lazy"/>
                                <span class="o_dcasa_top_nombre" t-out="p.nombre"/>
                                <span class="o_dcasa_top_cantidad"><t t-out="p.cantidad"/> u.</span>
                            </li>
                        </ol>
                        <p t-else="" class="o_dcasa_vacio">Aún no hay ventas este mes.</p>
                    </section>
                </div>

                <!-- Apps -->
                <section class="o_dcasa_apps" aria-label="Aplicaciones">
                    <h2>Aplicaciones</h2>
                    <div class="o_dcasa_apps_grilla">
                        <button t-foreach="apps" t-as="app" t-key="app.id" type="button" class="o_dcasa_app"
                                t-on-click="() => this.abrirApp(app)">
                            <img t-if="iconoApp(app)" t-att-src="iconoApp(app)" alt=""/>
                            <span t-else="" class="o_dcasa_app_letra" t-out="app.name[0]"/>
                            <span class="o_dcasa_app_nombre" t-out="app.name"/>
                        </button>
                    </div>
                </section>
            </div>
        </div>
    </t>
</templates>
