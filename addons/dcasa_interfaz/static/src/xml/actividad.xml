<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- El botón «Actividad» de arriba (junto al engranaje): muestra u oculta el panel de mensajes y notas. -->
    <t t-inherit="web.FormView" t-inherit-mode="extension">
        <xpath expr="//t[@t-set-slot='control-panel-additional-actions']" position="inside">
            <button t-if="dcasaHayActividad" type="button"
                    t-attf-class="btn btn-secondary o_dcasa_actividad_boton {{ dcasaActividad.visible ? 'active' : '' }}"
                    t-att-aria-pressed="dcasaActividad.visible ? 'true' : 'false'"
                    title="Mostrar u ocultar los mensajes y las notas de este documento"
                    t-on-click="dcasaAlternarActividad">
                <i class="fa fa-comments-o me-1"/>Actividad
            </button>
        </xpath>
    </t>

</templates>
