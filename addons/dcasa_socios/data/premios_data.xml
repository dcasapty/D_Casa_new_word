<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- La escalera de descuentos de arranque (100 puntos = $1). Marcial los edita,
         desactiva o añade productos desde Socios > Premios: es un punto de partida. -->
    <data noupdate="1">
        <record id="premio_desc_5" model="dcasa.premio">
            <field name="name">$5 de descuento</field>
            <field name="descripcion">Se aplica en tu próxima compra.</field>
            <field name="puntos">500</field><field name="valor">5</field><field name="costo">5</field>
            <field name="sequence">1</field>
        </record>
        <record id="premio_desc_10" model="dcasa.premio">
            <field name="name">$10 de descuento</field>
            <field name="descripcion">Se aplica en tu próxima compra.</field>
            <field name="puntos">1000</field><field name="valor">10</field><field name="costo">10</field>
            <field name="sequence">2</field>
        </record>
        <record id="premio_desc_25" model="dcasa.premio">
            <field name="name">$25 de descuento</field>
            <field name="descripcion">Se aplica en tu próxima compra.</field>
            <field name="puntos">2500</field><field name="valor">25</field><field name="costo">25</field>
            <field name="sequence">3</field>
        </record>
        <record id="premio_desc_50" model="dcasa.premio">
            <field name="name">$50 de descuento</field>
            <field name="descripcion">Se aplica en tu próxima compra.</field>
            <field name="puntos">5000</field><field name="valor">50</field><field name="costo">50</field>
            <field name="sequence">4</field>
        </record>
        <record id="premio_desc_100" model="dcasa.premio">
            <field name="name">$100 de descuento</field>
            <field name="descripcion">Se aplica en tu próxima compra.</field>
            <field name="puntos">10000</field><field name="valor">100</field><field name="costo">100</field>
            <field name="sequence">5</field>
        </record>
        <!-- Premio TÉCNICO del modo «todo» de puntos en el carrito web: el socio elige cuántos puntos
             usa y el descuento sale de puntos.json (canje.puntosPorDolar). No sale en el catálogo
             (dcasa.premio._catalogo) y la cifra «puntos» es un marcador: la real la pone cada canje. -->
        <record id="premio_libre_web" model="dcasa.premio">
            <field name="name">Puntos en la tienda web</field>
            <field name="descripcion">Descuento libre con puntos en el carrito de la tienda web.</field>
            <field name="puntos">1</field><field name="valor">0</field><field name="costo">0</field>
            <field name="sequence">999</field>
            <field name="libre" eval="True"/>
        </record>
    </data>
    <!-- Premio de EJEMPLO de la dueña (03/10/2026): «Dos almohadas» por 400 puntos. Fuera del bloque
         noupdate a propósito: así también se crea en una base que ya tenía el módulo. La función es
         de una sola vez (bandera dcasa_socios.ejemplo_almohadas_creado) y Gerencia lo edita o archiva. -->
    <function model="dcasa.premio" name="_crear_ejemplo_almohadas">
        <value>Dos almohadas</value>
        <value eval="400"/>
        <value>ALMOHADA001</value>
        <value eval="2"/>
    </function>
</odoo>
