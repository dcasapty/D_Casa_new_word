<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_dcasa_socios" model="ir.ui.view">
        <field name="name">res.partner.form.dcasa.socios</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_dcasa_ver_movimientos" type="object" class="oe_stat_button" icon="fa-star"
                        invisible="not dcasa_socio_codigo" groups="sales_team.group_sale_salesman">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="dcasa_saldo"/></span>
                        <span class="o_stat_text">Puntos</span>
                    </div>
                </button>
            </div>
            <notebook position="inside">
                <page string="Socio D'CASA" name="dcasa_socio" groups="sales_team.group_sale_salesman"
                      invisible="parent_id">
                    <div invisible="dcasa_socio_codigo" class="mb-3">
                        <p class="text-muted">Todavía no está en el programa. Se le abre la ficha sola con su
                            primera factura pagada, o ahora mismo:</p>
                        <button name="action_dcasa_crear_ficha" type="object" string="Abrir ficha de socio"
                                class="btn-secondary"/>
                    </div>
                    <group invisible="not dcasa_socio_codigo">
                        <group string="Ficha">
                            <field name="dcasa_socio_codigo"/>
                            <field name="dcasa_celular" placeholder="6026-1919"/>
                            <field name="dcasa_cumple" placeholder="MM-DD"/>
                            <field name="dcasa_socio_estado"/>
                            <field name="dcasa_reclamada"/>
                            <field name="dcasa_bloqueado_hasta" invisible="not dcasa_bloqueado_hasta"/>
                            <field name="dcasa_creado_por"/>
                        </group>
                        <group string="Invitación">
                            <field name="dcasa_referido_por_id" readonly="dcasa_referido_por_id"
                                   options="{'no_create': True}"/>
                            <field name="dcasa_referido_en" invisible="not dcasa_referido_por_id"/>
                            <field name="dcasa_referido_pagado_en" invisible="not dcasa_referido_pagado_en"/>
                            <field name="dcasa_ahijados_count"/>
                        </group>
                    </group>
                    <div invisible="not dcasa_socio_codigo" class="d-flex flex-wrap gap-2 mb-3">
                        <button name="action_dcasa_ajustar" type="object" string="Ajustar puntos"
                                groups="sales_team.group_sale_manager"/>
                        <button name="action_dcasa_reiniciar_pin" type="object" string="Reiniciar PIN"
                                invisible="not dcasa_reclamada"
                                confirm="Se genera un PIN temporal que le dictas al socio. ¿Seguir?"/>
                        <button name="action_dcasa_desbloquear" type="object" string="Desbloquear"
                                invisible="not dcasa_bloqueado_hasta"/>
                        <button name="action_dcasa_suspender" type="object" string="Suspender"
                                invisible="dcasa_socio_estado != 'activo'" groups="sales_team.group_sale_manager"
                                confirm="Un socio suspendido no suma ni canjea puntos. ¿Seguir?"/>
                        <button name="action_dcasa_activar" type="object" string="Reactivar"
                                invisible="dcasa_socio_estado == 'activo'" groups="sales_team.group_sale_manager"/>
                    </div>
                    <field name="dcasa_movimiento_ids" invisible="not dcasa_socio_codigo" readonly="1">
                        <list limit="20">
                            <field name="ocurrido_en"/>
                            <field name="tipo"/>
                            <field name="motivo"/>
                            <field name="puntos" sum="Saldo"/>
                            <field name="autor" optional="hide"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

    <record id="view_partner_socios_list" model="ir.ui.view">
        <field name="name">res.partner.list.dcasa.socios</field>
        <field name="model">res.partner</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Socios">
                <field name="dcasa_socio_codigo"/>
                <field name="complete_name" string="Nombre"/>
                <field name="dcasa_celular"/>
                <field name="dcasa_saldo"/>
                <field name="dcasa_reclamada"/>
                <field name="dcasa_referido_por_id" optional="show"/>
                <field name="dcasa_ahijados_count" optional="show"/>
                <field name="dcasa_socio_estado" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_partner_socios_search" model="ir.ui.view">
        <field name="name">res.partner.search.dcasa.socios</field>
        <field name="model">res.partner</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <search string="Socios">
                <field name="name" filter_domain="['|', '|', ('complete_name', 'ilike', self), ('dcasa_socio_codigo', 'ilike', self), ('dcasa_celular', 'ilike', self)]"/>
                <filter name="sin_reclamar" string="Sin reclamar (tienen puntos esperando)"
                        domain="[('dcasa_saldo', '>', 0), ('dcasa_pin_cambiado_en', '=', False)]"/>
                <filter name="con_saldo" string="Con puntos" domain="[('dcasa_saldo', '>', 0)]"/>
                <filter name="invitados" string="Llegaron invitados" domain="[('dcasa_referido_por_id', '!=', False)]"/>
                <filter name="suspendidos" string="Suspendidos" domain="[('dcasa_socio_estado', '=', 'suspendido')]"/>
                <filter name="archivados" string="Papelera" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_dcasa_socios" model="ir.actions.act_window">
        <field name="name">Socios</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('dcasa_socio_codigo', '!=', False)]</field>
        <field name="search_view_id" ref="view_partner_socios_search"/>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_partner_socios_list')}), (0, 0, {'view_mode': 'form', 'view_id': ref('base.view_partner_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aún no hay socios</p>
            <p>Cada cliente entra solo con su primera factura pagada, o se registra en /socios con su celular.</p>
        </field>
    </record>
</odoo>
