<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dcasa_movimiento_list" model="ir.ui.view">
        <field name="name">dcasa.movimiento.list</field>
        <field name="model">dcasa.movimiento</field>
        <field name="arch" type="xml">
            <list string="Libro de puntos" create="false" edit="false" delete="false"
                  decoration-danger="puntos &lt; 0" decoration-success="puntos &gt; 0">
                <field name="ocurrido_en"/>
                <field name="partner_id"/>
                <field name="tipo"/>
                <field name="motivo"/>
                <field name="puntos" sum="Total"/>
                <field name="origen_partner_id" optional="hide"/>
                <field name="compra_id" optional="hide"/>
                <field name="canje_id" optional="hide"/>
                <field name="autor" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_dcasa_movimiento_search" model="ir.ui.view">
        <field name="name">dcasa.movimiento.search</field>
        <field name="model">dcasa.movimiento</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="motivo"/>
                <field name="autor"/>
                <filter name="entradas" string="Suman" domain="[('puntos', '&gt;', 0)]"/>
                <filter name="salidas" string="Restan" domain="[('puntos', '&lt;', 0)]"/>
                <separator/>
                <filter name="ocurrido_en" string="Fecha" date="ocurrido_en"/>
                <group>
                    <filter name="g_tipo" string="Tipo" context="{'group_by': 'tipo'}"/>
                    <filter name="g_socio" string="Socio" context="{'group_by': 'partner_id'}"/>
                    <filter name="g_mes" string="Mes" context="{'group_by': 'ocurrido_en:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_dcasa_movimiento_pivot" model="ir.ui.view">
        <field name="name">dcasa.movimiento.pivot</field>
        <field name="model">dcasa.movimiento</field>
        <field name="arch" type="xml">
            <pivot string="Pasivo del programa">
                <field name="tipo" type="row"/>
                <field name="ocurrido_en" interval="month" type="col"/>
                <field name="puntos" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_dcasa_movimiento_graph" model="ir.ui.view">
        <field name="name">dcasa.movimiento.graph</field>
        <field name="model">dcasa.movimiento</field>
        <field name="arch" type="xml">
            <graph string="Puntos por mes" type="bar" stacked="1">
                <field name="ocurrido_en" interval="month"/>
                <field name="tipo"/>
                <field name="puntos" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_dcasa_movimientos" model="ir.actions.act_window">
        <field name="name">Libro de puntos</field>
        <field name="res_model">dcasa.movimiento</field>
        <field name="view_mode">list,pivot,graph</field>
    </record>

    <record id="action_dcasa_pasivo" model="ir.actions.act_window">
        <field name="name">Pasivo del programa</field>
        <field name="res_model">dcasa.movimiento</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="help" type="html">
            <p>El total de la columna «Puntos» es lo que el programa debe hoy: 100 puntos = $1 si todos se canjearan.</p>
        </field>
    </record>
</odoo>
