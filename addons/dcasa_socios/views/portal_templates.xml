<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cuenta unificada: el usuario de la tienda (portal) ve sus puntos en /my. Su ficha es la del programa. -->
    <template id="portal_my_home_socios" inherit_id="portal.portal_my_home" name="Socios D'CASA en /my" priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
            <t t-set="dcasa_socio" t-value="request.env.user.partner_id.sudo()._dcasa_resumen_portal()"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <div t-if="dcasa_socio" class="col-12 order-0">
                <div class="o_dcasa_portal_socio">
                    <div class="o_dcasa_portal_socio_texto">
                        <p class="o_dcasa_kicker mb-1">Socios D'CASA</p>
                        <t t-if="dcasa_socio['es_socio']">
                            <div class="o_dcasa_portal_socio_saldo"><span t-out="dcasa_socio['saldo_fmt']"/> <small>puntos</small></div>
                            <p class="mb-0">
                                <t t-out="dcasa_socio['premios_pendientes']"/> premio(s) por recoger ·
                                <t t-out="dcasa_socio['invitados']"/> invitado(s) ·
                                código <span class="o_dcasa_socios_codigo text-white" t-out="dcasa_socio['codigo']"/>
                            </p>
                        </t>
                        <t t-else="">
                            <div class="o_dcasa_portal_socio_saldo"><span t-out="dcasa_socio['saldo_fmt']"/> <small>puntos</small></div>
                            <p class="mb-0">Tus compras ya suman puntos en esta misma cuenta. Actívala con un PIN para
                                pedir premios, invitar y usar tus puntos en el carrito.</p>
                        </t>
                    </div>
                    <a t-if="dcasa_socio['es_socio']" href="/socios/cuenta" class="btn o_dcasa_portal_socio_btn">Mi cuenta de socio</a>
                    <a t-else="" href="/socios" class="btn o_dcasa_portal_socio_btn">Activar mis puntos</a>
                </div>
            </div>
        </div>
    </template>
</odoo>
