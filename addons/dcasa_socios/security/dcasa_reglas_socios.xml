<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Socios y programa de vendedores: cada vendedora ve solo lo suyo (pedido de la dueña, 2026-10-16).

        Las compras que dieron puntos y las comisiones dicen de qué factura vienen y cuánto se vendió: la vendedora
        ve solo las suyas; Caja (Ventas «todos los documentos»), contabilidad y Gerencia, todas. Los saldos y los
        procesos (acreditar, canjear, pagar un premio) ya corren con sudo y no cambian.
        Ver docs/PERMISOS.md.
    -->
    <record id="regla_compras_vendedora" model="ir.rule">
        <field name="name">Socios: compras de sus ventas (o sin vendedora)</field>
        <field name="model_id" ref="model_dcasa_compra"/>
        <field name="domain_force">['|', ('vendedor_id', '=', user.id), ('vendedor_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman')), (4, ref('account.group_account_invoice'))]"/>
    </record>

    <record id="regla_compras_toda_la_tienda" model="ir.rule">
        <field name="name">Socios: compras de toda la tienda (Caja y contabilidad)</field>
        <field name="model_id" ref="model_dcasa_compra"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads')), (4, ref('account.group_account_readonly')), (4, ref('account.group_account_manager'))]"/>
    </record>

    <!-- La comisión es dato del programa: estricta, solo la de sus propias facturas. -->
    <record id="regla_comisiones_vendedora" model="ir.rule">
        <field name="name">Vendedores: comisiones de sus facturas</field>
        <field name="model_id" ref="model_dcasa_vend_comision"/>
        <field name="domain_force">[('move_id.invoice_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman')), (4, ref('account.group_account_invoice'))]"/>
    </record>

    <record id="regla_comisiones_toda_la_tienda" model="ir.rule">
        <field name="name">Vendedores: comisiones de toda la tienda (Caja y contabilidad)</field>
        <field name="model_id" ref="model_dcasa_vend_comision"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads')), (4, ref('account.group_account_readonly')), (4, ref('account.group_account_manager'))]"/>
    </record>
</odoo>
