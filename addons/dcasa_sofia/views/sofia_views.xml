<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- La pantalla de Sofía (OWL: static/src/js/sofia.js). -->
    <record id="accion_sofia" model="ir.actions.client">
        <field name="name">Sofía</field>
        <field name="tag">dcasa_sofia.panel</field>
        <field name="path">sofia</field>
    </record>

    <menuitem id="menu_sofia" name="Sofía" parent="crm.crm_menu_root" sequence="2" action="accion_sofia"
              groups="sales_team.group_sale_salesman"/>

    <!-- «Organizar con Sofía» arriba del tablero y de la lista del CRM (siempre visible, sin elegir tarjetas). -->
    <record id="crm_lead_kanban_sofia" model="ir.ui.view">
        <field name="name">crm.lead.kanban.sofia</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <header>
                    <button name="action_dcasa_sofia" type="object" string="Organizar con Sofía" display="always"
                            class="btn-secondary o_dcasa_boton_sofia" icon="fa-magic"
                            groups="sales_team.group_sale_salesman"/>
                </header>
            </xpath>
        </field>
    </record>

    <record id="crm_lead_list_sofia" model="ir.ui.view">
        <field name="name">crm.lead.list.sofia</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">
            <xpath expr="//list/header" position="inside">
                <button name="action_dcasa_sofia" type="object" string="Organizar con Sofía" display="always"
                        class="btn-secondary o_dcasa_boton_sofia" icon="fa-magic"
                        groups="sales_team.group_sale_salesman"/>
            </xpath>
        </field>
    </record>

    <!-- Historial: lo que Sofía propuso y quién lo aprobó o descartó (solo Gerencia). -->
    <record id="vista_sofia_propuesta_lista" model="ir.ui.view">
        <field name="name">dcasa.sofia.propuesta.list</field>
        <field name="model">dcasa.sofia.propuesta</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" default_order="id desc">
                <field name="create_date" string="Propuesta el"/>
                <field name="tipo"/>
                <field name="partner_id"/>
                <field name="titulo"/>
                <field name="motivo" optional="hide"/>
                <field name="usuario_id"/>
                <field name="estado" widget="badge" decoration-success="estado == 'aplicada'"
                       decoration-muted="estado in ('descartada', 'vencida')" decoration-info="estado == 'pendiente'"/>
                <field name="resuelta_por"/>
                <field name="resuelta_en"/>
                <field name="resultado" optional="show"/>
            </list>
        </field>
    </record>

    <record id="vista_sofia_propuesta_buscar" model="ir.ui.view">
        <field name="name">dcasa.sofia.propuesta.search</field>
        <field name="model">dcasa.sofia.propuesta</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="usuario_id"/>
                <filter name="pendientes" string="Pendientes" domain="[('estado', '=', 'pendiente')]"/>
                <filter name="aprobadas" string="Aprobadas" domain="[('estado', '=', 'aplicada')]"/>
                <filter name="descartadas" string="Descartadas" domain="[('estado', '=', 'descartada')]"/>
                <separator/>
                <filter name="pide_datos" string="Piden sus datos" domain="[('pide_datos', '=', True)]"/>
                <group>
                    <filter name="por_tipo" string="Qué propone" context="{'group_by': 'tipo'}"/>
                    <filter name="por_vendedora" string="Para" context="{'group_by': 'usuario_id'}"/>
                    <filter name="por_estado" string="Estado" context="{'group_by': 'estado'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="accion_sofia_historial" model="ir.actions.act_window">
        <field name="name">Historial de Sofía</field>
        <field name="res_model">dcasa.sofia.propuesta</field>
        <field name="view_mode">list</field>
        <field name="path">sofia-historial</field>
    </record>

    <!-- Los mensajes que propone (Gerencia los cambia; no se crean ni se borran). -->
    <record id="vista_sofia_plantilla_lista" model="ir.ui.view">
        <field name="name">dcasa.sofia.plantilla.list</field>
        <field name="model">dcasa.sofia.plantilla</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" editable="bottom">
                <field name="clave" readonly="1"/>
                <field name="texto"/>
            </list>
        </field>
    </record>

    <record id="accion_sofia_plantillas" model="ir.actions.act_window">
        <field name="name">Mensajes de Sofía</field>
        <field name="res_model">dcasa.sofia.plantilla</field>
        <field name="view_mode">list</field>
        <field name="path">sofia-mensajes</field>
        <field name="help" type="html">
            <p>Los mensajes que Sofía propone. Puedes usar {nombre}, {vendedora}, {interes}, {cotizacion}, {vence},
               {para_cuando} y {que_falta}. Sin precios ni cifras.</p>
        </field>
    </record>

    <menuitem id="menu_sofia_config" name="Sofía" parent="crm.crm_menu_config" sequence="90"
              groups="sales_team.group_sale_manager"/>
    <menuitem id="menu_sofia_plantillas" name="Mensajes de Sofía" parent="menu_sofia_config" sequence="10"
              action="accion_sofia_plantillas"/>
    <menuitem id="menu_sofia_historial" name="Historial de Sofía" parent="menu_sofia_config" sequence="20"
              action="accion_sofia_historial"/>
</odoo>
