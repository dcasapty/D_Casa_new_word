<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- «Aplicar» del Inventario físico: el motivo viene vacío y es obligatorio (queda en la bitácora). -->
    <record id="ajuste_motivo_form" model="ir.ui.view">
        <field name="name">stock.inventory.adjustment.name.form.dcasa</field>
        <field name="model">stock.inventory.adjustment.name</field>
        <field name="inherit_id" ref="stock.stock_inventory_adjustment_name_form_view"/>
        <field name="arch" type="xml">
            <field name="inventory_adjustment_name" position="attributes">
                <attribute name="required">1</attribute>
                <attribute name="placeholder">Ej.: conteo de fin de mes, se encontró una caja de más…</attribute>
            </field>
            <xpath expr="//group" position="before">
                <p class="text-muted">Escribe por qué cambian las existencias: queda en la bitácora de bodega con lo que
                    había, lo que quedó y quién lo hizo.</p>
            </xpath>
        </field>
    </record>

    <!-- El hueco del Inventario físico (etapa 1, decisión 6 del 16/10): cambiar existencias a mano es de Gerencia.
         El servidor ya lo exige (dcasa_base, bitacora.py); aquí se esconden también los menús y las acciones. -->
    <record id="stock.menu_action_inventory_tree" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('stock.group_stock_manager')])]"/>
    </record>
    <record id="stock.menu_stock_scrap" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('stock.group_stock_manager')])]"/>
    </record>
    <record id="stock.action_scrap" model="ir.actions.server">
        <field name="group_ids" eval="[(6, 0, [ref('stock.group_stock_manager')])]"/>
    </record>
    <record id="stock.action_revert_inventory_adjustment" model="ir.actions.server">
        <field name="group_ids" eval="[(6, 0, [ref('stock.group_stock_manager')])]"/>
    </record>
</odoo>
