<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Bitácora de bodega: solo lectura (la escribe el sistema), solo Gerencia. -->
    <record id="bitacora_list" model="ir.ui.view">
        <field name="name">dcasa.bitacora.bodega.list</field>
        <field name="model">dcasa.bitacora.bodega</field>
        <field name="arch" type="xml">
            <list string="Bitácora de bodega" create="0" edit="0" delete="0"
                  decoration-danger="diferencia &lt; 0" decoration-success="diferencia &gt; 0">
                <field name="fecha"/>
                <field name="producto_id"/>
                <field name="antes"/>
                <field name="despues"/>
                <field name="diferencia"/>
                <field name="valor" sum="Total" optional="show"/>
                <field name="motivo"/>
                <field name="usuario_id"/>
                <field name="origen" optional="show"/>
                <field name="ubicacion_id" optional="hide" groups="stock.group_stock_multi_locations"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="bitacora_form" model="ir.ui.view">
        <field name="name">dcasa.bitacora.bodega.form</field>
        <field name="model">dcasa.bitacora.bodega</field>
        <field name="arch" type="xml">
            <form string="Ajuste de existencias" create="0" edit="0" delete="0">
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <div class="oe_title"><h1><field name="producto_id"/></h1></div>
                    <group>
                        <group>
                            <field name="antes"/>
                            <field name="despues"/>
                            <field name="diferencia"/>
                            <field name="valor"/>
                        </group>
                        <group>
                            <field name="fecha"/>
                            <field name="usuario_id"/>
                            <field name="origen"/>
                            <field name="ubicacion_id" groups="stock.group_stock_multi_locations"/>
                            <field name="scrap_id" invisible="not scrap_id"/>
                        </group>
                    </group>
                    <group><field name="motivo"/></group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bitacora_search" model="ir.ui.view">
        <field name="name">dcasa.bitacora.bodega.search</field>
        <field name="model">dcasa.bitacora.bodega</field>
        <field name="arch" type="xml">
            <search>
                <field name="producto_id"/>
                <field name="usuario_id"/>
                <field name="motivo"/>
                <filter name="hoy" string="Hoy"
                        domain="[('fecha', '&gt;=', (context_today() - relativedelta(days=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="esta_semana" string="Últimos 7 días"
                        domain="[('fecha', '&gt;=', (context_today() - relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter name="este_mes" string="Este mes"
                        domain="[('fecha', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="faltantes" string="Faltó mercancía" domain="[('diferencia', '&lt;', 0)]"/>
                <filter name="sobrantes" string="Sobró mercancía" domain="[('diferencia', '&gt;', 0)]"/>
                <separator/>
                <filter name="de_mermas" string="Mermas y regalos" domain="[('origen', '=', 'merma')]"/>
                <filter name="de_conteos" string="Conteos"
                        domain="[('origen', 'in', ('inventario_fisico', 'escaner'))]"/>
                <group>
                    <filter name="por_producto" string="Producto" context="{'group_by': 'producto_id'}"/>
                    <filter name="por_usuario" string="Quién" context="{'group_by': 'usuario_id'}"/>
                    <filter name="por_origen" string="Desde" context="{'group_by': 'origen'}"/>
                    <filter name="por_mes" string="Mes" context="{'group_by': 'fecha:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="accion_bitacora" model="ir.actions.act_window">
        <field name="name">Bitácora de bodega</field>
        <field name="res_model">dcasa.bitacora.bodega</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aquí queda cada ajuste de existencias</p>
            <p>Cada vez que alguien cambia las existencias a mano (Inventario físico, Escáner › Contar, Brian, una
                merma o deshacer un ajuste) queda aquí: cuánto había, cuánto quedó, el motivo y quién. Nadie la edita.</p>
        </field>
    </record>
</odoo>
