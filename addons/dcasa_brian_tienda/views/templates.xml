<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===================================================================
         La burbuja de «Brian de la tienda» (static/src/js/brian_tienda.js).

         Va al final de #wrapwrap, como la burbuja de WhatsApp a la que reemplaza, con su marcado escrito aquí mismo:
         nada de t-call metidos por xpath en una plantilla de Odoo (con el editor del sitio abierto, Odoo deja sus
         marcas en el t-call y la página da error 500; lección del lote 1 de la web). Es la misma para todo visitante:
         la página se puede guardar en el borde. El chat y el carrito los pide el JS (pase, carrito) cuando se abre.

         Sin JavaScript sigue siendo útil: es un enlace a WhatsApp. El JS lo cambia por el botón que abre el chat.
         =================================================================== -->
    <template id="burbuja" inherit_id="website.layout" name="D'CASA: Brian de la tienda">
        <xpath expr="//div[@id='wrapwrap']" position="inside">
            <t t-if="website and website._dcasa_brian_en_esta_pagina(request.httprequest.path)">
                <t t-set="dcbt" t-value="website._dcasa_brian_datos()"/>
                <aside id="o_dcasa_brian" class="o_dcbt" aria-label="Chat de la tienda"
                       t-att-data-whatsapp="dcbt['whatsapp']" t-att-data-horario="dcbt['horario']"
                       t-att-data-poses="dcbt['poses']" t-att-data-dormir="dcbt['dormir']"
                       t-att-data-turnstile="dcbt['turnstile'] or None">
                    <a class="o_dcbt_burbuja" href="/whatsapp" target="_blank" rel="noopener nofollow"
                       title="Chat de la tienda" aria-label="Escríbenos por WhatsApp (se abre en una pestaña nueva)">
                        <span class="o_dcbt_pose" aria-hidden="true"/>
                    </a>
                </aside>
            </t>
        </xpath>
    </template>

    <!-- Con Brian encendido, su burbuja reemplaza la burbuja flotante de WhatsApp (los botones «Escríbenos por
         WhatsApp» de la página se quedan). Donde Brian no sale (p. ej. /my) o apagado, vuelve la de WhatsApp. -->
    <template id="sin_burbuja_whatsapp" inherit_id="website_dcasa.layout_whatsapp_float"
              name="D'CASA: la burbuja de Brian reemplaza la de WhatsApp">
        <xpath expr="//aside" position="attributes">
            <attribute name="t-if" add="not website._dcasa_brian_en_esta_pagina(request.httprequest.path)" separator="and"/>
        </xpath>
    </template>

    <!-- Política de privacidad (Ley 81 de 2019): «Brian, el chat de la tienda», en la sección de inteligencia artificial.
         TEXTO PROPUESTO: lo aprueba la dueña (y el abogado) antes de producción. -->
    <template id="privacidad_brian_tienda" inherit_id="website_dcasa.privacidad_cuerpo"
              name="D'CASA: privacidad de Brian de la tienda">
        <xpath expr="//h2[@id='inteligencia-artificial']/following-sibling::ul[1]" position="after">
            <p id="brian-de-la-tienda"><strong>Andrés, el chat de la tienda.</strong> En nuestra tienda en línea puedes
                conversar con Andrés, un asistente de inteligencia artificial. Lo que le escribes se envía a nuestro
                proveedor de inteligencia artificial (el mismo de Juan, con las mismas condiciones de arriba) para
                contestarte. No guardamos la conversación ni creamos una ficha tuya: el chat recuerda lo que hablaron
                como mucho dos horas sin actividad (hasta 30 mensajes: los últimos 15 intercambios) y después se borra
                solo. Si tocas «Usar mi ubicación», tu ubicación se usa solo para encontrar el lugar de entrega más
                cercano y calcular el envío, y no se guarda. Andrés no ve ni cambia tus datos ni tus compras: el carrito lo cambias tú, desde tu
                navegador. Si calificas la atención con estrellas, guardamos solo el número de estrellas y la fecha.
                Para evitar abusos contamos cuántos chats y mensajes llegan por hora desde una misma conexión, sin
                guardar quién eres.</p>
        </xpath>
    </template>
</odoo>
