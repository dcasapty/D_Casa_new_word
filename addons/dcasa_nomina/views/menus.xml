<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- La app «Nómina» es solo para quien administra la nómina: una vendedora no la ve ni vacía. -->
    <menuitem id="menu_nomina_raiz" name="Nómina" sequence="60" groups="group_nomina"
              web_icon="dcasa_nomina,static/src/img/nomina.svg"/>

    <menuitem id="menu_planillas" name="Planillas quincenales" parent="menu_nomina_raiz" action="accion_planillas"
              sequence="10" groups="group_nomina"/>
    <menuitem id="menu_decimo" name="Décimo tercer mes" parent="menu_nomina_raiz" action="accion_decimo"
              sequence="20" groups="group_nomina"/>
    <menuitem id="menu_colaboradores" name="Colaboradores" parent="menu_nomina_raiz"
              action="hr.open_view_employee_list_my" sequence="30" groups="group_nomina"/>
    <menuitem id="menu_vacaciones" name="Vacaciones" parent="menu_nomina_raiz" action="accion_vacaciones"
              sequence="40" groups="group_nomina"/>
    <menuitem id="menu_liquidaciones" name="Liquidaciones" parent="menu_nomina_raiz" action="accion_liquidaciones"
              sequence="50" groups="group_nomina"/>
    <menuitem id="menu_reembolsos" name="Reembolsos" parent="menu_nomina_raiz" action="accion_reembolsos"
              sequence="60" groups="group_nomina"/>
    <menuitem id="menu_prestamos" name="Adelantos y préstamos" parent="menu_nomina_raiz" action="accion_prestamos"
              sequence="62" groups="group_nomina"/>
    <menuitem id="menu_meta_bonos" name="Bono por meta" parent="menu_nomina_raiz" action="accion_meta_bonos"
              sequence="70" groups="group_nomina"/>
    <!-- «Mis gastos por reembolsar» es de cada colaborador (lo que pagó de su bolsillo para la empresa y se le
         devuelve en la planilla): vive aparte de «Nómina» y de Facturación, para que quien no administra sueldos ni
         factura lo encuentre igual, sin ver nada que diga nómina. Lleva su propio ícono (un recibo): con el de
         Nómina parecía que la vendedora tenía la Nómina habilitada. La aprobación sigue en Nómina › Reembolsos,
         solo para quien administra la nómina. -->
    <menuitem id="menu_mis_reembolsos" name="Mis gastos por reembolsar" action="accion_mis_reembolsos"
              sequence="65" groups="base.group_user"
              web_icon="dcasa_nomina,static/src/img/reembolsos.svg"/>

    <menuitem id="menu_nomina_configuracion" name="Configuración" parent="menu_nomina_raiz" sequence="90"
              groups="group_nomina"/>
    <menuitem id="menu_parametros" name="Tasas y reglas" parent="menu_nomina_configuracion" action="accion_parametros"
              sequence="10"/>
    <menuitem id="menu_config_cuentas" name="Cuentas y diario" parent="menu_nomina_configuracion"
              action="accion_config" sequence="20"/>
    <menuitem id="menu_meta_reglas" name="Meta de ventas" parent="menu_nomina_configuracion"
              action="accion_meta_reglas" sequence="30"/>
</odoo>
