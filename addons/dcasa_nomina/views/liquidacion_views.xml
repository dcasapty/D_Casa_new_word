<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="liquidacion_list" model="ir.ui.view">
        <field name="name">dcasa.nomina.liquidacion.list</field>
        <field name="model">dcasa.nomina.liquidacion</field>
        <field name="arch" type="xml">
            <list string="Liquidaciones">
                <field name="empleado_id"/>
                <field name="fecha_salida"/>
                <field name="motivo"/>
                <field name="total" sum="Total"/>
                <field name="estado" widget="badge" decoration-success="estado == 'revisada'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="liquidacion_form" model="ir.ui.view">
        <field name="name">dcasa.nomina.liquidacion.form</field>
        <field name="model">dcasa.nomina.liquidacion</field>
        <field name="arch" type="xml">
            <form string="Cálculo de liquidación">
                <header>
                    <button name="action_calcular" type="object" string="Calcular" class="btn-primary"/>
                    <button name="action_revisar" type="object" string="Marcar revisada por el contador"
                            invisible="estado != 'calculada'"/>
                    <button name="action_borrador" type="object" string="Volver a borrador" invisible="estado == 'borrador'"/>
                    <field name="estado" widget="statusbar"/>
                </header>
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <field name="parametros_validados" invisible="1"/>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <div class="alert alert-warning" role="alert">
                        Cálculo de apoyo para el contador: no genera asiento ni pago. La indemnización, el preaviso y el ISR de la
                        liquidación los escribe el contador.
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="estado == 'borrador' or parametros_validados">
                        Las tasas usadas todavía no las valida el contador.
                    </div>
                    <group>
                        <group>
                            <field name="empleado_id" options="{'no_create': True}" readonly="estado != 'borrador'"/>
                            <field name="fecha_salida" readonly="estado == 'revisada'"/>
                            <field name="motivo" readonly="estado == 'revisada'"/>
                            <field name="incluir_prima" readonly="estado == 'revisada'"/>
                        </group>
                        <group>
                            <field name="ingreso"/>
                            <field name="anios"/>
                            <field name="salario_mensual"/>
                            <field name="salario_promedio"/>
                        </group>
                    </group>
                    <group string="Lo que se le debe">
                        <group>
                            <field name="dias_pendientes" readonly="estado == 'revisada'"/>
                            <field name="salario_pendiente"/>
                            <field name="decimo_proporcional"/>
                            <field name="vacaciones_dias"/>
                            <field name="vacaciones_valor"/>
                            <field name="prima"/>
                        </group>
                        <group>
                            <field name="indemnizacion" readonly="estado == 'revisada'"/>
                            <field name="seguro_social"/>
                            <field name="isr" readonly="estado == 'revisada'"/>
                            <field name="total" class="fw-bold"/>
                        </group>
                    </group>
                    <field name="notas" placeholder="Notas para el contador"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="accion_liquidaciones" model="ir.actions.act_window">
        <field name="name">Liquidaciones</field>
        <field name="res_model">dcasa.nomina.liquidacion</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
