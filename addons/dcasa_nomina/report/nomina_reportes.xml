<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Comprobante de pago: uno por colaborador -->
    <record id="accion_comprobante_pago" model="ir.actions.report">
        <field name="name">Comprobante de pago</field>
        <field name="model">dcasa.nomina.linea</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">dcasa_nomina.comprobante_pago</field>
        <field name="report_file">dcasa_nomina.comprobante_pago</field>
        <field name="print_report_name">'Comprobante - %s - %s' % (object.empleado_id.name, object.planilla_id.name)</field>
        <field name="binding_model_id" ref="model_dcasa_nomina_linea"/>
        <field name="binding_type">report</field>
    </record>

    <template id="comprobante_pago">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="layout_document_title">Comprobante de pago</t>
                <t t-set="moneda" t-value="o.currency_id"/>
                <t t-set="empleado" t-value="o.empleado_id.sudo()"/>
                <t t-set="borrador" t-value="o.planilla_id.estado not in ('confirmada', 'pagada')"/>
                <t t-set="address">
                    <div class="row o_dcasa_rejilla" name="dcasa_rejilla">
                        <div class="col-4 o_dcasa_celda">
                            <div class="o_dcasa_bloque_titulo">Colaborador</div>
                            <div class="o_dcasa_cliente">
                                <div class="o_dcasa_cliente_nombre" t-out="empleado.name"/>
                                <div t-if="empleado.job_title" t-out="empleado.job_title"/>
                                <div t-if="empleado.identification_id">Cédula: <t t-out="empleado.identification_id"/></div>
                                <div t-if="empleado.ssnid">Seguro social: <t t-out="empleado.ssnid"/></div>
                            </div>
                        </div>
                        <div class="col-4 o_dcasa_celda">
                            <div class="o_dcasa_bloque_titulo">Periodo</div>
                            <div t-if="o.tipo == 'quincenal'">Del <span t-field="o.planilla_id.fecha_desde"/> al <span t-field="o.planilla_id.fecha_hasta"/></div>
                            <div t-else="" t-out="o.planilla_id.name"/>
                            <div t-if="o.tipo == 'quincenal'">Días pagados: <t t-out="o.dias_pagados"/> de <t t-out="o.dias_periodo"/></div>
                        </div>
                        <div class="col-4 o_dcasa_celda o_dcasa_datos">
                            <table class="o_dcasa_tabla_datos">
                                <tr><th>Pago</th><td><span t-field="o.planilla_id.fecha_pago"/></td></tr>
                                <tr t-if="empleado.dcasa_forma_pago"><th>Forma</th><td><span t-field="empleado.dcasa_forma_pago"/></td></tr>
                                <tr t-if="o.tipo == 'quincenal'"><th>Salario mensual</th>
                                    <td t-out="o.salario_mensual" t-options="{'widget': 'monetary', 'display_currency': moneda}"/></tr>
                            </table>
                        </div>
                    </div>
                </t>
                <t t-call="web.external_layout">
                    <div class="page o_dcasa_comprobante">
                        <div t-if="borrador" class="o_dcasa_comprobante_borrador">
                            BORRADOR: esta planilla todavía no está confirmada; las cifras pueden cambiar.
                        </div>
                        <table class="table table-sm o_main_table">
                            <thead>
                                <tr><th>Concepto</th><th class="text-end">Ingresos</th><th class="text-end">Descuentos</th></tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td t-if="o.tipo == 'quincenal'">Salario del periodo</td>
                                    <td t-else="">Décimo tercer mes (partida)</td>
                                    <td class="text-end" t-out="o.salario" t-options="{'widget': 'monetary', 'display_currency': moneda}"/>
                                    <td/>
                                </tr>
                                <tr t-if="o.otros_ingresos"><td>Otros ingresos (horas extras, bonos)</td>
                                    <td class="text-end" t-out="o.otros_ingresos" t-options="{'widget': 'monetary', 'display_currency': moneda}"/><td/></tr>
                                <tr t-if="o.comision_meta and o.tipo != 'decimo'"><td>Bono por meta de ventas</td>
                                    <td class="text-end" t-out="o.comision_meta" t-options="{'widget': 'monetary', 'display_currency': moneda}"/><td/></tr>
                                <tr t-foreach="o.reembolso_ids" t-as="r"><td>Reembolso: <t t-out="r.concepto"/></td>
                                    <td class="text-end" t-out="r.monto" t-options="{'widget': 'monetary', 'display_currency': moneda}"/><td/></tr>
                                <tr t-if="o.css_trabajador"><td>Seguro social</td><td/>
                                    <td class="text-end" t-out="o.css_trabajador" t-options="{'widget': 'monetary', 'display_currency': moneda}"/></tr>
                                <tr t-if="o.se_trabajador"><td>Seguro educativo</td><td/>
                                    <td class="text-end" t-out="o.se_trabajador" t-options="{'widget': 'monetary', 'display_currency': moneda}"/></tr>
                                <tr t-if="o.isr"><td>Impuesto sobre la renta</td><td/>
                                    <td class="text-end" t-out="o.isr" t-options="{'widget': 'monetary', 'display_currency': moneda}"/></tr>
                                <tr t-foreach="o.prestamo_descuento_ids" t-as="d">
                                    <td>
                                        <t t-out="dict(d.prestamo_id._fields['tipo']._description_selection(d.env)).get(d.prestamo_id.tipo)"/>
                                        del <span t-field="d.prestamo_id.fecha"/>: cuota <t t-out="d._numero_de_cuota()"/> de <t t-out="d.prestamo_id.cuotas"/>
                                        <div class="o_dcasa_comprobante_nota">Te queda por pagar después de este pago:
                                            <t t-out="d._saldo_despues()" t-options="{'widget': 'monetary', 'display_currency': moneda}"/></div>
                                    </td>
                                    <td/>
                                    <td class="text-end" t-out="d.monto" t-options="{'widget': 'monetary', 'display_currency': moneda}"/>
                                </tr>
                                <tr t-if="o.otros_descuentos"><td>Otros descuentos<t t-if="o.notas">: <t t-out="o.notas"/></t></td><td/>
                                    <td class="text-end" t-out="o.otros_descuentos" t-options="{'widget': 'monetary', 'display_currency': moneda}"/></tr>
                            </tbody>
                            <tfoot>
                                <tr class="o_dcasa_comprobante_sumas">
                                    <td>Totales</td>
                                    <td class="text-end" t-out="o.devengado + o.reembolsos" t-options="{'widget': 'monetary', 'display_currency': moneda}"/>
                                    <td class="text-end" t-out="o.css_trabajador + o.se_trabajador + o.isr + o.otros_descuentos + o.prestamos" t-options="{'widget': 'monetary', 'display_currency': moneda}"/>
                                </tr>
                            </tfoot>
                        </table>
                        <table class="o_dcasa_comprobante_neto">
                            <tr><td>Recibes</td><td class="text-end" t-out="o.neto" t-options="{'widget': 'monetary', 'display_currency': moneda}"/></tr>
                        </table>
                        <p class="o_dcasa_comprobante_nota mt-3">
                            Los descuentos de seguro social, seguro educativo e impuesto sobre la renta los paga D'CASA a
                            nombre tuyo. ¿Dudas con tu pago? Pregúntale a la administración.
                        </p>
                        <div class="row o_dcasa_comprobante_firmas">
                            <div class="col-6"><div class="o_dcasa_comprobante_linea"/>Recibí conforme</div>
                            <div class="col-6"><div class="o_dcasa_comprobante_linea"/>Por D'CASA</div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Resumen de la planilla -->
    <record id="accion_resumen_planilla" model="ir.actions.report">
        <field name="name">Resumen de la planilla</field>
        <field name="model">dcasa.nomina.planilla</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">dcasa_nomina.resumen_planilla</field>
        <field name="report_file">dcasa_nomina.resumen_planilla</field>
        <field name="print_report_name">'Planilla - %s' % object.name</field>
        <field name="binding_model_id" ref="model_dcasa_nomina_planilla"/>
        <field name="binding_type">report</field>
    </record>

    <template id="resumen_planilla">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2><span t-field="o.name"/></h2>
                        <p>Fecha de pago: <span t-field="o.fecha_pago"/> · Estado: <span t-field="o.estado"/>
                            <t t-if="not o.parametros_validados"> · <strong>BORRADOR: las tasas todavía no las valida el contador</strong></t></p>
                        <table class="table table-sm">
                            <thead><tr><th>Colaborador</th><th class="text-end">Devengado</th><th class="text-end">Seguro social</th>
                                <th class="text-end">Seg. educativo</th><th class="text-end">ISR</th><th class="text-end">Otros desc.</th>
                                <th class="text-end">Reembolsos</th><th class="text-end">Neto</th></tr></thead>
                            <tbody>
                                <tr t-foreach="o.linea_ids" t-as="l">
                                    <td><span t-field="l.empleado_id.name"/></td>
                                    <td class="text-end"><span t-field="l.devengado"/></td>
                                    <td class="text-end"><span t-field="l.css_trabajador"/></td>
                                    <td class="text-end"><span t-field="l.se_trabajador"/></td>
                                    <td class="text-end"><span t-field="l.isr"/></td>
                                    <td class="text-end"><span t-field="l.otros_descuentos"/></td>
                                    <td class="text-end"><span t-field="l.reembolsos"/></td>
                                    <td class="text-end"><span t-field="l.neto"/></td>
                                </tr>
                            </tbody>
                            <tfoot><tr><th>Total</th>
                                <th class="text-end"><span t-field="o.total_devengado"/></th>
                                <th colspan="4" class="text-end"><span t-field="o.total_descuentos"/> en descuentos</th>
                                <th class="text-end"><span t-field="o.total_reembolsos"/></th>
                                <th class="text-end"><span t-field="o.total_neto"/></th></tr></tfoot>
                        </table>
                        <p>Aportes del patrono (seguro social, educativo y riesgo profesional): <strong><span t-field="o.total_patronal"/></strong></p>
                        <div t-if="o.avisos" class="alert alert-warning"><pre t-out="o.avisos"/></div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Cálculo de liquidación -->
    <record id="accion_liquidacion" model="ir.actions.report">
        <field name="name">Cálculo de liquidación</field>
        <field name="model">dcasa.nomina.liquidacion</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">dcasa_nomina.liquidacion</field>
        <field name="report_file">dcasa_nomina.liquidacion</field>
        <field name="print_report_name">'Liquidación - %s' % object.empleado_id.name</field>
        <field name="binding_model_id" ref="model_dcasa_nomina_liquidacion"/>
        <field name="binding_type">report</field>
    </record>

    <template id="liquidacion">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2><span t-field="o.name"/></h2>
                        <p>Motivo: <span t-field="o.motivo"/> · Ingreso: <span t-field="o.ingreso"/> · Años de servicio: <span t-field="o.anios"/></p>
                        <div class="alert alert-warning">Cálculo de apoyo para el contador. La indemnización, el preaviso y el ISR de la liquidación los define el contador.
                            <t t-if="not o.parametros_validados"><strong> Las tasas usadas todavía no están validadas.</strong></t></div>
                        <table class="table table-sm">
                            <tr><td>Salario sin pagar (<span t-field="o.dias_pendientes"/> días)</td><td class="text-end"><span t-field="o.salario_pendiente"/></td></tr>
                            <tr><td>Décimo tercer mes proporcional</td><td class="text-end"><span t-field="o.decimo_proporcional"/></td></tr>
                            <tr><td>Vacaciones sin tomar (<span t-field="o.vacaciones_dias"/> días)</td><td class="text-end"><span t-field="o.vacaciones_valor"/></td></tr>
                            <tr><td>Prima de antigüedad</td><td class="text-end"><span t-field="o.prima"/></td></tr>
                            <tr><td>Indemnización / preaviso</td><td class="text-end"><span t-field="o.indemnizacion"/></td></tr>
                            <tr><td>Menos: seguro social y educativo</td><td class="text-end">- <span t-field="o.seguro_social"/></td></tr>
                            <tr><td>Menos: ISR</td><td class="text-end">- <span t-field="o.isr"/></td></tr>
                            <tr><th>Total a pagar</th><th class="text-end"><span t-field="o.total"/></th></tr>
                        </table>
                        <p t-if="o.notas"><span t-field="o.notas"/></p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
