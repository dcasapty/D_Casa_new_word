<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Límites por usuario (ajustables en Ajustes › Técnico › Parámetros del sistema). -->
    <record id="parametro_acciones_por_minuto" model="ir.config_parameter">
        <field name="key">dcasa_brian.acciones_por_minuto</field>
        <field name="value">30</field>
    </record>
    <record id="parametro_mensajes_por_minuto" model="ir.config_parameter">
        <field name="key">dcasa_brian.mensajes_por_minuto</field>
        <field name="value">20</field>
    </record>
    <!-- Retención: días sin actividad tras los que se borra una conversación (0 = nunca). -->
    <record id="parametro_retencion_dias" model="ir.config_parameter">
        <field name="key">dcasa_brian.retencion_dias</field>
        <field name="value">180</field>
    </record>

    <record id="ir_cron_brian_retencion" model="ir.cron">
        <field name="name">Brian: borrar conversaciones viejas y adjuntos huérfanos</field>
        <field name="model_id" ref="model_brian_conversacion"/>
        <field name="state">code</field>
        <field name="code">model._cron_limpiar()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
