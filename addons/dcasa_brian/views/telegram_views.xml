<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="brian_telegram_enlace_list" model="ir.ui.view">
        <field name="name">brian.telegram.enlace.list</field>
        <field name="model">brian.telegram.enlace</field>
        <field name="arch" type="xml">
            <list string="Telegram" create="0" edit="0" decoration-muted="not activo">
                <header>
                    <button name="action_vincular" type="object" string="Vincular mi Telegram"
                            class="btn-primary" display="always"/>
                    <button name="action_registrar_webhook" type="object" string="Registrar webhook"
                            display="always" groups="base.group_system"/>
                </header>
                <field name="nombre"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="fecha"/>
                <field name="activo" widget="boolean_toggle" readonly="1"/>
                <button name="action_desvincular" type="object" string="Desvincular" icon="fa-chain-broken"
                        invisible="not activo"/>
            </list>
        </field>
    </record>

    <record id="brian_telegram_enlace_form" model="ir.ui.view">
        <field name="name">brian.telegram.enlace.form</field>
        <field name="model">brian.telegram.enlace</field>
        <field name="arch" type="xml">
            <form string="Chat de Telegram" create="0" edit="0">
                <header>
                    <button name="action_desvincular" type="object" string="Desvincular" invisible="not activo"/>
                </header>
                <sheet>
                    <group>
                        <field name="nombre"/>
                        <field name="user_id"/>
                        <field name="chat_id" groups="base.group_system"/>
                        <field name="fecha"/>
                        <field name="activo" readonly="1"/>
                        <field name="conversacion_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="brian_telegram_enlace_search" model="ir.ui.view">
        <field name="name">brian.telegram.enlace.search</field>
        <field name="model">brian.telegram.enlace</field>
        <field name="arch" type="xml">
            <search>
                <field name="nombre"/>
                <field name="user_id"/>
                <filter name="activos" string="Vinculados" domain="[('activo', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="action_brian_telegram_enlace" model="ir.actions.act_window">
        <field name="name">Telegram</field>
        <field name="res_model">brian.telegram.enlace</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_activos': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Conecta tu Telegram con Brian</p>
            <p>Pulsa «Vincular mi Telegram» y envía al bot el código que te aparece
               (vence en 10 minutos). Desde ese chat Brian trabaja con tus permisos.</p>
        </field>
    </record>

    <menuitem id="menu_brian_telegram" name="Telegram" parent="menu_brian_raiz"
              action="action_brian_telegram_enlace" sequence="50" groups="base.group_user"/>

    <!-- Mis preferencias: botón para vincular el propio Telegram. -->
    <record id="view_users_form_simple_modif_brian_telegram" model="ir.ui.view">
        <field name="name">res.users.preferences.form.brian.telegram</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <group name="other_preferences" position="inside">
                <div colspan="2" class="text-muted">
                    Brian en Telegram:
                    <button name="action_dcasa_brian_vincular_telegram" type="object"
                            string="Vincular Telegram" class="btn-link p-0" icon="fa-paper-plane"/>
                </div>
            </group>
        </field>
    </record>

    <!-- Ficha del usuario (administración): mismo botón; solo vale para el propio usuario. -->
    <record id="view_users_form_brian_telegram" model="ir.ui.view">
        <field name="name">res.users.form.brian.telegram</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="action_dcasa_brian_vincular_telegram" type="object" string="Vincular Telegram"
                        icon="fa-paper-plane"/>
            </header>
        </field>
    </record>
</odoo>
