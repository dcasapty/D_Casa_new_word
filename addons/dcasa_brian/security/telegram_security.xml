<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cada quien ve solo sus chats de Telegram vinculados; el administrador ve todos. -->
    <record id="regla_telegram_enlace_propio" model="ir.rule">
        <field name="name">Brian Telegram: solo mis chats</field>
        <field name="model_id" ref="model_brian_telegram_enlace"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="regla_telegram_enlace_admin" model="ir.rule">
        <field name="name">Brian Telegram: administrador ve todo</field>
        <field name="model_id" ref="model_brian_telegram_enlace"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_system'))]"/>
    </record>
</odoo>
