<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Íconos de la ubicación (pedido del dueño, 2026-11-25: «a la gente no le gusta leer… entenderá más un punterito en un
         mapa que un texto»). Trazos propios, 24×24, del color del texto (currentColor), siempre con aria-hidden: el texto
         corto que va al lado (o el aria-label del botón) es lo que lee un lector de pantalla.
         Uso: <t t-call="dcasa_ubicacion.icono"><t t-set="icono" t-value="'pin'"/></t> (clase opcional: icono_clase). -->
    <template id="icono" name="Ubicación: ícono">
        <svg t-attf-class="o_dcasa_icono {{icono_clase or ''}}" viewBox="0 0 24 24" width="24" height="24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
             focusable="false">
            <t t-if="icono == 'pin'">
                <path d="M12 22s7-6.6 7-12.2A7 7 0 0 0 5 9.8C5 15.4 12 22 12 22z"/>
                <circle cx="12" cy="9.8" r="2.6"/>
            </t>
            <t t-elif="icono == 'gps'">
                <circle cx="12" cy="12" r="7"/>
                <circle cx="12" cy="12" r="2.6" fill="currentColor"/>
                <path d="M12 2v3M12 19v3M2 12h3M19 12h3"/>
            </t>
            <t t-elif="icono == 'buscar'">
                <circle cx="11" cy="11" r="7"/>
                <path d="M20 20l-4.2-4.2"/>
            </t>
            <t t-elif="icono == 'camion'">
                <path d="M2.5 6.5h11v10h-11z"/>
                <path d="M13.5 9.5h4l3.5 3.5v3.5h-7.5"/>
                <circle cx="7" cy="17.5" r="1.9" fill="currentColor"/>
                <circle cx="17" cy="17.5" r="1.9" fill="currentColor"/>
            </t>
            <t t-elif="icono == 'casa'">
                <path d="M3 11l9-7 9 7"/>
                <path d="M5.5 9.5V20h13V9.5"/>
                <path d="M10 20v-5.5h4V20"/>
            </t>
            <t t-elif="icono == 'listo'">
                <path d="M5 12.5l4.5 4.5L19 7.5"/>
            </t>
            <t t-elif="icono == 'lapiz'">
                <path d="M4 20l1-4.5L16.5 4l3.5 3.5L8.5 19z"/>
                <path d="M14 6.5l3.5 3.5"/>
            </t>
            <t t-elif="icono == 'mapa'">
                <path d="M3 6.5l6-2.5 6 2.5 6-2.5v13.5l-6 2.5-6-2.5-6 2.5z"/>
                <path d="M9 4v13.5M15 6.5V20"/>
            </t>
            <t t-elif="icono == 'mover'">
                <path d="M12 3v18M3 12h18"/>
                <path d="M9 6l3-3 3 3M9 18l3 3 3-3M6 9l-3 3 3 3M18 9l3 3-3 3"/>
            </t>
            <t t-elif="icono == 'ir'">
                <path d="M3.5 11L21 3l-8 17.5-2-7.5z"/>
            </t>
            <t t-elif="icono == 'telefono'">
                <path d="M5 3.5h4l1.8 4.5-2.3 1.4a11 11 0 0 0 6.1 6.1l1.4-2.3 4.5 1.8v4a2 2 0 0 1-2.2 2A17 17 0 0 1 3 5.7a2 2 0 0 1 2-2.2z"/>
            </t>
        </svg>
    </template>
</odoo>
