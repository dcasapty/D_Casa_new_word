<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tres íconos más para «quién recibe», la foto de la casa y «Avisar que llegué» (mismas reglas que los de
         iconos_templates.xml: 24×24, del color del texto, aria-hidden). -->
    <template id="icono_casa" inherit_id="dcasa_ubicacion.icono" name="Ubicación: íconos de quién recibe y la foto">
        <xpath expr="//t[@t-elif=&quot;icono == 'telefono'&quot;]" position="after">
            <t t-elif="icono == 'persona'">
                <circle cx="12" cy="8" r="4"/>
                <path d="M4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1"/>
            </t>
            <t t-elif="icono == 'camara'">
                <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3z"/>
                <circle cx="12" cy="13" r="3.5"/>
            </t>
            <t t-elif="icono == 'chat'">
                <path d="M7.9 20A9 9 0 1 0 4 16.1L2.5 21.5z"/>
                <path d="M8.5 12h.01M12 12h.01M15.5 12h.01"/>
            </t>
        </xpath>
    </template>
</odoo>
