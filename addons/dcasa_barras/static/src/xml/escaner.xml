<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="dcasa_barras.Escaner">
        <div class="o_dcasa_escaner">
            <div class="o_dcasa_escaner_cuerpo">

                <header class="o_dcasa_escaner_cabecera">
                    <h1>Escáner</h1>
                    <div class="o_dcasa_escaner_modos" role="group" aria-label="Qué quieres hacer">
                        <button type="button" class="o_dcasa_modo" t-att-class="{'o_dcasa_modo_activo': state.modo === 'consultar'}"
                                t-att-aria-pressed="state.modo === 'consultar' ? 'true' : 'false'"
                                t-on-click="() => this.cambiarModo('consultar')">Consultar</button>
                        <button type="button" class="o_dcasa_modo" t-att-class="{'o_dcasa_modo_activo': state.modo === 'contar'}"
                                t-att-aria-pressed="state.modo === 'contar' ? 'true' : 'false'"
                                t-on-click="() => this.cambiarModo('contar')">Contar</button>
                        <button type="button" class="o_dcasa_modo" t-att-class="{'o_dcasa_modo_activo': state.modo === 'asignar'}"
                                t-att-aria-pressed="state.modo === 'asignar' ? 'true' : 'false'"
                                t-on-click="() => this.cambiarModo('asignar')">Asignar</button>
                    </div>
                </header>

                <!-- Aquí cae lo que escribe el lector. -->
                <form class="o_dcasa_escaner_entrada" t-on-submit.prevent="escanear">
                    <label for="o_dcasa_escaner_texto" class="o_dcasa_escaner_etiqueta">
                        <t t-esc="textoDeAyuda"/>
                    </label>
                    <div class="o_dcasa_escaner_fila">
                        <input id="o_dcasa_escaner_texto" type="text" class="o_dcasa_escaner_texto" t-ref="entrada"
                               t-model="state.texto" t-on-keydown="alTeclear" t-on-blur="alPerderFoco"
                               autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false"
                               t-att-placeholder="textoDeEjemplo"/>
                        <button type="submit" class="o_dcasa_boton o_dcasa_boton_primario"
                                t-att-disabled="state.cargando or !state.texto.trim()">Buscar</button>
                    </div>
                </form>

                <div class="o_dcasa_escaner_aviso" role="status" aria-live="polite">
                    <p t-if="state.mensaje" t-attf-class="o_dcasa_msg o_dcasa_msg_{{ state.mensaje.tipo }}"
                       t-esc="state.mensaje.texto"/>
                </div>

                <!-- Varios productos con ese código, o los que salieron de buscar por nombre. -->
                <ul t-if="state.opciones.length and state.modo !== 'asignar'" class="o_dcasa_opciones">
                    <li t-foreach="state.opciones" t-as="opcion" t-key="opcion.id">
                        <button type="button" class="o_dcasa_opcion" t-on-click="() => this.elegir(opcion)">
                            <span class="o_dcasa_opcion_nombre" t-esc="opcion.nombre"/>
                            <span t-if="opcion.referencia or opcion.codigo_de_barras" class="o_dcasa_opcion_ref"
                                  t-esc="opcion.referencia or opcion.codigo_de_barras"/>
                        </button>
                    </li>
                </ul>

                <!-- La tarjeta del producto. -->
                <section t-if="state.ficha and state.modo !== 'asignar'" class="o_dcasa_ficha" aria-label="Producto escaneado">
                    <div class="o_dcasa_ficha_arriba">
                        <img class="o_dcasa_ficha_foto" t-att-src="state.ficha.imagen" alt=""/>
                        <div class="o_dcasa_ficha_datos">
                            <h2 class="o_dcasa_ficha_nombre" t-esc="state.ficha.nombre"/>
                            <p class="o_dcasa_ficha_ref">
                                <span t-if="state.ficha.referencia">Ref. <strong t-esc="state.ficha.referencia"/></span>
                                <span t-if="state.ficha.codigo_de_barras"> · Código <strong t-esc="state.ficha.codigo_de_barras"/></span>
                                <span t-if="!state.ficha.codigo_de_barras"> · Sin código de barras</span>
                            </p>
                            <p t-if="state.ficha.precio_texto" class="o_dcasa_ficha_precio" t-esc="state.ficha.precio_texto"/>
                        </div>
                    </div>

                    <div t-if="state.parecido" class="o_dcasa_parecido" role="alert">
                        <p>Ese código no es igual al de ningún producto: se parece a este (sin contar guiones,
                            símbolos ni mayúsculas). ¿Es el que tienes en la mano?</p>
                        <button type="button" class="o_dcasa_boton o_dcasa_boton_primario" t-on-click="esEste">Sí, es este</button>
                    </div>

                    <div class="o_dcasa_ficha_existencias">
                        <div class="o_dcasa_total">
                            <span class="o_dcasa_total_cifra" t-esc="cifra(state.ficha.unidades)"/>
                            <span class="o_dcasa_total_texto">en existencia</span>
                        </div>
                        <span t-attf-class="o_dcasa_estado o_dcasa_estado_{{ state.ficha.etiqueta }}" t-esc="etiqueta"/>
                    </div>
                    <p t-if="!state.ficha.controla_inventario" class="o_dcasa_nota">
                        Este producto no controla inventario: no tiene existencias que contar.
                    </p>
                    <ul t-if="state.ficha.ubicaciones.length" class="o_dcasa_ubicaciones">
                        <li t-foreach="state.ficha.ubicaciones" t-as="u" t-key="u.id">
                            <span t-esc="u.nombre"/>
                            <strong t-esc="cifra(u.cantidad)"/>
                        </li>
                    </ul>

                    <!-- Contar -->
                    <div t-if="state.modo === 'contar'" class="o_dcasa_contar">
                        <p t-if="state.parecido" class="o_dcasa_nota">
                            Confirma que es este producto (arriba) para poder contarlo.
                        </p>
                        <p t-elif="state.ficha.con_lotes" class="o_dcasa_nota">
                            Este producto se controla por lote o serie: cuéntalo en Inventario › Inventario físico.
                        </p>
                        <p t-elif="!state.ficha.puede_contar and state.ficha.controla_inventario" class="o_dcasa_nota">
                            Contar existencias es de Gerencia. Aquí solo puedes consultar.
                        </p>
                        <t t-elif="state.ficha.puede_contar">
                            <div t-if="!state.confirmando" class="o_dcasa_contar_campos">
                                <label>
                                    <span>Dónde contaste</span>
                                    <select class="o_dcasa_select" t-model.number="state.ubicacion">
                                        <option t-foreach="state.ficha.lugares_para_contar" t-as="lugar" t-key="lugar.id"
                                                t-att-value="lugar.id" t-esc="lugar.nombre"/>
                                    </select>
                                </label>
                                <label>
                                    <span>Cantidad contada</span>
                                    <input type="text" inputmode="decimal" class="o_dcasa_cantidad" autocomplete="off"
                                           t-model="state.cantidad" t-on-keydown="alTeclearCantidad"/>
                                </label>
                                <button type="button" class="o_dcasa_boton o_dcasa_boton_primario"
                                        t-on-click="pedirConfirmacion">Revisar</button>
                            </div>
                            <div t-else="" class="o_dcasa_confirmar" role="alertdialog" aria-label="Confirmar el conteo">
                                <p>En <strong t-esc="lugarContado"/> el sistema decía <strong t-esc="cifra(state.confirmando.antes)"/>. Tú contaste
                                    <strong t-esc="cifra(state.confirmando.cantidad)"/>.</p>
                                <p t-if="state.confirmando.diferencia !== 0" class="o_dcasa_diferencia">
                                    Se ajusta
                                    <strong><t t-if="state.confirmando.diferencia > 0">+</t><t t-esc="cifra(state.confirmando.diferencia)"/></strong>
                                    unidades (queda en el historial de movimientos).
                                </p>
                                <p t-else="" class="o_dcasa_diferencia">Coincide: no hay nada que ajustar.</p>
                                <div class="o_dcasa_botones">
                                    <button type="button" class="o_dcasa_boton o_dcasa_boton_primario" t-ref="confirmar"
                                            t-att-disabled="state.cargando" t-on-click="confirmarConteo">Confirmar conteo</button>
                                    <button type="button" class="o_dcasa_boton" t-on-click="cancelarConteo">Cancelar</button>
                                </div>
                            </div>
                        </t>
                    </div>
                </section>

                <!-- Asignar etiqueta: escanear la etiqueta del rollo y elegir el producto. -->
                <section t-if="state.modo === 'asignar'" class="o_dcasa_asignar" aria-label="Asignar etiqueta">
                    <p t-if="!state.asig" class="o_dcasa_nota o_dcasa_asignar_guia">
                        Escanea la etiqueta del rollo que vas a pegar. Después eliges el producto y ese número queda como su
                        código de barras. Esto es solo de Gerencia.
                    </p>
                    <t t-if="state.asig">
                        <div class="o_dcasa_etiqueta_cabecera">
                            <span class="o_dcasa_etiqueta_codigo" t-esc="state.asig.codigo"/>
                            <span t-attf-class="o_dcasa_estado o_dcasa_estado_etiqueta_{{ state.asig.estado }}"
                                  t-esc="estadoDeLaEtiqueta"/>
                            <button type="button" class="o_dcasa_boton o_dcasa_otra_etiqueta"
                                    t-on-click="cancelarAsignacion">Otra etiqueta</button>
                        </div>

                        <div t-if="state.asig.estado === 'retirada' and state.asig.paso !== 'confirmar'"
                             class="o_dcasa_parecido o_dcasa_aviso_retirada" role="note">
                            <p>Esta etiqueta estuvo retirada: era de «<t t-esc="state.asig.antes.producto"/>»<t t-if="state.asig.antes.motivo"> (<t t-esc="state.asig.antes.motivo"/>)</t>.
                                Si sigues, se usa otra vez.</p>
                        </div>

                        <!-- La etiqueta ya es de un producto. -->
                        <div t-if="state.asig.paso === 'dueno'" class="o_dcasa_ficha o_dcasa_ficha_dueno">
                            <div class="o_dcasa_ficha_arriba">
                                <img class="o_dcasa_ficha_foto" t-att-src="state.asig.dueno.imagen" alt=""/>
                                <div class="o_dcasa_ficha_datos">
                                    <h2 class="o_dcasa_ficha_nombre" t-esc="state.asig.dueno.nombre"/>
                                    <p class="o_dcasa_ficha_ref">
                                        <span t-if="state.asig.dueno.referencia">Ref. <strong t-esc="state.asig.dueno.referencia"/></span>
                                    </p>
                                </div>
                            </div>
                            <p class="o_dcasa_asignar_texto">Esta etiqueta ya es de este producto.</p>
                            <div class="o_dcasa_botones">
                                <button type="button" class="o_dcasa_boton o_dcasa_boton_primario"
                                        t-on-click="cancelarAsignacion">Está bien</button>
                                <button type="button" class="o_dcasa_boton" t-on-click="pasarAOtro">Pasarla a otro producto</button>
                                <button type="button" class="o_dcasa_boton" t-on-click="quitarEtiqueta">Quitar la etiqueta</button>
                            </div>
                        </div>

                        <!-- Elegir el producto. -->
                        <div t-if="state.asig.paso === 'producto'" class="o_dcasa_asignar_buscar">
                            <label class="o_dcasa_escaner_etiqueta" for="o_dcasa_busqueda_producto">
                                ¿De qué producto es? Escribe el nombre o la referencia
                            </label>
                            <div class="o_dcasa_escaner_fila">
                                <input id="o_dcasa_busqueda_producto" type="text" class="o_dcasa_escaner_texto o_dcasa_busqueda_producto"
                                       t-ref="busquedaProducto" t-model="state.asig.busqueda" t-on-keydown="alTeclearBusqueda"
                                       autocomplete="off" autocorrect="off" spellcheck="false" placeholder="Nombre o referencia"/>
                                <button type="button" class="o_dcasa_boton o_dcasa_boton_primario"
                                        t-att-disabled="state.cargando or state.asig.busqueda.trim().length &lt; 2"
                                        t-on-click="buscarProducto">Buscar</button>
                            </div>
                            <ul t-if="state.asig.opciones.length" class="o_dcasa_opciones o_dcasa_opciones_etiqueta">
                                <li t-foreach="state.asig.opciones" t-as="opcion" t-key="opcion.id">
                                    <button type="button" class="o_dcasa_opcion" t-on-click="() => this.elegirParaEtiqueta(opcion)">
                                        <span class="o_dcasa_opcion_nombre" t-esc="opcion.nombre"/>
                                        <span class="o_dcasa_opcion_ref">
                                            <t t-esc="opcion.referencia"/>
                                            <t t-if="opcion.codigo_de_barras"> · ya tiene la etiqueta <t t-esc="opcion.codigo_de_barras"/></t>
                                        </span>
                                    </button>
                                </li>
                            </ul>
                        </div>

                        <!-- Confirmar. -->
                        <div t-if="state.asig.paso === 'confirmar'" class="o_dcasa_ficha o_dcasa_ficha_elegido">
                            <div class="o_dcasa_ficha_arriba">
                                <img class="o_dcasa_ficha_foto" t-att-src="state.asig.elegido.imagen" alt=""/>
                                <div class="o_dcasa_ficha_datos">
                                    <h2 class="o_dcasa_ficha_nombre" t-esc="state.asig.elegido.nombre"/>
                                    <p class="o_dcasa_ficha_ref">
                                        <span t-if="state.asig.elegido.referencia">Ref. <strong t-esc="state.asig.elegido.referencia"/></span>
                                        <span t-if="state.asig.elegido.codigo_de_barras"> · Etiqueta actual <strong t-esc="state.asig.elegido.codigo_de_barras"/></span>
                                        <span t-if="!state.asig.elegido.codigo_de_barras"> · Sin etiqueta</span>
                                    </p>
                                </div>
                            </div>
                            <div class="o_dcasa_asignar_confirmar" role="alertdialog" aria-label="Confirmar la etiqueta">
                                <p class="o_dcasa_asignar_texto">Pega <strong t-esc="state.asig.codigo"/> en este producto.</p>
                                <p t-if="state.asig.elegido.codigo_de_barras and state.asig.elegido.codigo_de_barras.toUpperCase() !== state.asig.codigo"
                                   class="o_dcasa_nota">
                                    Su etiqueta actual (<t t-esc="state.asig.elegido.codigo_de_barras"/>) quedará retirada.
                                </p>
                                <p t-if="state.asig.estado === 'asignada' and state.asig.dueno" class="o_dcasa_nota">
                                    <t t-esc="state.asig.dueno.nombre"/> se queda sin etiqueta.
                                </p>
                                <p t-if="state.asig.estado === 'retirada'" class="o_dcasa_nota">
                                    Esta etiqueta estuvo retirada (era de «<t t-esc="state.asig.antes.producto"/>»).
                                </p>
                                <div t-if="state.asig.pregunta" class="o_dcasa_parecido" role="alert">
                                    <p t-if="state.asig.pregunta.motivo === 'dueno'">
                                        Mientras tanto esa etiqueta pasó a ser de «<t t-esc="state.asig.pregunta.dueno.nombre"/>».
                                        Si sigues, ese producto se queda sin etiqueta.
                                    </p>
                                    <p t-else="">
                                        Mientras tanto esa etiqueta quedó retirada (era de «<t t-esc="state.asig.pregunta.antes.producto"/>»).
                                        ¿La usamos otra vez?
                                    </p>
                                </div>
                                <div class="o_dcasa_botones">
                                    <button type="button" class="o_dcasa_boton o_dcasa_boton_primario" t-ref="confirmarEtiqueta"
                                            t-att-disabled="state.cargando" t-on-click="confirmarAsignacion" t-esc="botonAsignar"/>
                                    <button type="button" class="o_dcasa_boton" t-on-click="volverABuscar">Otro producto</button>
                                    <button type="button" class="o_dcasa_boton" t-on-click="cancelarAsignacion">Cancelar</button>
                                </div>
                            </div>
                        </div>
                    </t>
                </section>

                <section t-if="state.historial.length" class="o_dcasa_historial" aria-label="Lo último que escaneaste">
                    <h3>Lo último</h3>
                    <ul>
                        <li t-foreach="state.historial" t-as="h" t-key="h.id" t-attf-class="o_dcasa_hist_{{ h.tipo }}">
                            <span class="o_dcasa_hist_nombre" t-esc="h.nombre"/>
                            <span class="o_dcasa_hist_detalle" t-esc="h.detalle"/>
                        </li>
                    </ul>
                </section>
            </div>
        </div>
    </t>
</templates>
