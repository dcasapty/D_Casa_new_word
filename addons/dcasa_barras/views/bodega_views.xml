<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Método de entrega: si es retiro en la tienda (el panel de Bodega separa «envío» de «retiro» con esto). -->
    <record id="view_delivery_carrier_form_dcasa_retiro" model="ir.ui.view">
        <field name="name">delivery.carrier.form.dcasa.retiro</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <field name="allow_cash_on_delivery" position="after">
                <field name="dcasa_es_retiro"/>
            </field>
        </field>
    </record>
</odoo>
