<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dcasa_barras_etiqueta_list" model="ir.ui.view">
        <field name="name">dcasa.barras.etiqueta.list</field>
        <field name="model">dcasa.barras.etiqueta</field>
        <field name="arch" type="xml">
            <list string="Historial de etiquetas" create="0" edit="0" delete="0" default_order="id desc">
                <field name="create_date" string="Cuándo"/>
                <field name="codigo"/>
                <field name="accion" widget="badge" decoration-success="accion == 'asignada'"
                       decoration-muted="accion == 'retirada'"/>
                <field name="producto_nombre"/>
                <field name="motivo"/>
                <field name="usuario_id"/>
            </list>
        </field>
    </record>

    <record id="view_dcasa_barras_etiqueta_search" model="ir.ui.view">
        <field name="name">dcasa.barras.etiqueta.search</field>
        <field name="model">dcasa.barras.etiqueta</field>
        <field name="arch" type="xml">
            <search string="Historial de etiquetas">
                <field name="codigo"/>
                <field name="producto_nombre"/>
                <field name="usuario_id"/>
                <filter name="asignadas" string="Asignadas" domain="[('accion', '=', 'asignada')]"/>
                <filter name="retiradas" string="Retiradas" domain="[('accion', '=', 'retirada')]"/>
                <group>
                    <filter name="por_etiqueta" string="Etiqueta" context="{'group_by': 'codigo'}"/>
                    <filter name="por_usuario" string="Quién" context="{'group_by': 'usuario_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dcasa_barras_etiqueta" model="ir.actions.act_window">
        <field name="name">Historial de etiquetas</field>
        <field name="res_model">dcasa.barras.etiqueta</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Todavía no se ha asignado ninguna etiqueta</p>
            <p>En Inventario › Escáner › Asignar escaneas la etiqueta del rollo y eliges el producto: cada cambio queda aquí.</p>
        </field>
    </record>
</odoo>
